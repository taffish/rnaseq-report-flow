        printf '</style>\n'
        printf '<script>\n'
cat <<'REPORT_JS'
(function(){
  var root = document.documentElement;
  var key = "taffish-rnaseq-report-lang";
  function apply(lang){
    if (lang !== "zh") lang = "en";
    root.setAttribute("data-lang", lang);
    root.setAttribute("lang", lang === "zh" ? "zh-CN" : "en");
    try { localStorage.setItem(key, lang); } catch (err) {}
    var buttons = document.querySelectorAll("[data-lang-toggle]");
    for (var i = 0; i < buttons.length; i++) {
      var active = buttons[i].getAttribute("data-lang-toggle") === lang;
      buttons[i].setAttribute("aria-pressed", active ? "true" : "false");
    }
  }
  function initScrollSpy(){
    var links = document.querySelectorAll(".side-links a[href^='#']");
    if (!links.length) return;
    var byId = {};
    var sections = [];
    for (var i = 0; i < links.length; i++) {
      var id = links[i].getAttribute("href").slice(1);
      var section = document.getElementById(id);
      if (!section) continue;
      byId[id] = links[i];
      sections.push(section);
    }
    function setActive(id){
      for (var j = 0; j < links.length; j++) links[j].classList.remove("active");
      if (!byId[id]) return;
      byId[id].classList.add("active");
      if (byId[id].closest) {
        var activeGroup = byId[id].closest(".nav-group");
        var groups = document.querySelectorAll(".nav-group");
        for (var g = 0; g < groups.length; g++) {
          if (groups[g] === activeGroup) groups[g].setAttribute("open", "");
          else groups[g].removeAttribute("open");
        }
      }
    }
    function currentSectionId(){
      if (!sections.length) return "";
      var line = Math.max(90, Math.min(170, window.innerHeight * 0.22));
      var best = sections[0].id;
      for (var i = 0; i < sections.length; i++) {
        var rect = sections[i].getBoundingClientRect();
        if (rect.top <= line) best = sections[i].id;
        else break;
      }
      if ((window.innerHeight + window.scrollY) >= (document.documentElement.scrollHeight - 8)) {
        best = sections[sections.length - 1].id;
      }
      return best;
    }
    var ticking = false;
    function update(){
      ticking = false;
      setActive(currentSectionId());
    }
    function requestUpdate(){
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    update();
  }
  function decodeBase64Utf8(value){
    var binary = atob(value || "");
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    if (window.TextDecoder) return new TextDecoder("utf-8").decode(bytes);
    var text = "";
    for (var j = 0; j < bytes.length; j++) text += String.fromCharCode(bytes[j]);
    try { return decodeURIComponent(escape(text)); } catch (err) { return text; }
  }
  function escapeHtml(value){
    return String(value || "").replace(/[&<>"']/g, function(ch){
      return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[ch];
    });
  }
  function initEmbeddedReports(){
    var payloadNode = document.getElementById("taffish-embedded-html-reports");
    var payloads = {};
    if (payloadNode) {
      try { payloads = JSON.parse(payloadNode.textContent || "{}"); } catch (err) { payloads = {}; }
    }
    var links = document.querySelectorAll("[data-embedded-report-id]");
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener("click", function(event){
        var id = this.getAttribute("data-embedded-report-id");
        var fallback = this.getAttribute("data-fallback-href") || this.getAttribute("href");
        var payload = payloads[id];
        if (!payload || !payload.html_b64) return;
        var child = window.open("", "_blank");
        if (!child) {
          return;
        }
        event.preventDefault();
        child.document.open();
        child.document.write(decodeBase64Utf8(payload.html_b64));
        child.document.close();
      });
    }
  }
  function initEmbeddedTables(){
    var payloadNode = document.getElementById("taffish-embedded-tables");
    var payloads = {};
    if (payloadNode) {
      try { payloads = JSON.parse(payloadNode.textContent || "{}"); } catch (err) { payloads = {}; }
    }
    var links = document.querySelectorAll("[data-embedded-table-id]");
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener("click", function(event){
        var id = this.getAttribute("data-embedded-table-id");
        var payload = payloads[id];
        if (!payload || !payload.text_b64) return;
        var child = window.open("", "_blank");
        if (!child) return;
        event.preventDefault();
        var text = decodeBase64Utf8(payload.text_b64);
        child.document.open();
        child.document.write("<!doctype html><html><head><meta charset=\"utf-8\"><title>" + escapeHtml(payload.name || id) + "</title><style>body{margin:0;background:#eef5f4;color:#13252d;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif}.wrap{max-width:1400px;margin:0 auto;padding:22px}h1{font-size:22px}.meta{color:#64757d}.box{border:1px solid #dbe6e7;border-radius:8px;background:#fff;padding:14px;overflow:auto}pre{margin:0;white-space:pre;tab-size:4;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.45}</style></head><body><div class=\"wrap\"><h1>" + escapeHtml(payload.name || id) + "</h1><p class=\"meta\">" + escapeHtml(payload.module || "") + " / " + escapeHtml(payload.role || "") + " / " + escapeHtml(payload.bytes || "") + " bytes</p><div class=\"box\"><pre>" + escapeHtml(text) + "</pre></div></div></body></html>");
        child.document.close();
      });
    }
  }
  function init(){
    var saved = "en";
    try { saved = localStorage.getItem(key) || saved; } catch (err) {}
    apply(saved);
    var buttons = document.querySelectorAll("[data-lang-toggle]");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener("click", function(){
        apply(this.getAttribute("data-lang-toggle"));
      });
    }
    initScrollSpy();
    initEmbeddedReports();
    initEmbeddedTables();
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
})();
REPORT_JS
        printf '</script>\n'
        printf '</head>\n<body>\n<div class="report-shell shell">\n'
        printf '<div class="page"><aside class="report-sidebar sidebar"><a class="brand brand-link" href="https://taffish.com" target="_blank" rel="noopener">'
        if [ -n "$logo_rel" ]; then
            printf '<img src="%s" alt="TAFFISH logo">' "$logo_rel"
        else
            printf '<span class="brand-mark">TF</span>'
        fi
        printf '<span><b>TAFFISH</b><small>'; i18n "command-level reproducibility" "命令级可复现性"; printf '</small></span></a>\n'
        printf '<div class="language-switch" aria-label="Language"><button type="button" data-lang-toggle="en" aria-pressed="true">English</button><button type="button" data-lang-toggle="zh" aria-pressed="false">中文</button></div>\n'
        printf '<nav class="section-nav side-links" aria-label="Report sections"><details class="nav-group" open><summary>'; i18n "Start" "开始"; printf '</summary><div class="nav-sub"><a href="#overview">'; i18n "Overview" "总览"; printf '</a><a class="nav-child" href="#guide">'; i18n "Reading guide" "解读指南"; printf '</a><a class="nav-child" href="#workflow">'; i18n "Workflow" "流程"; printf '</a></div></details><details class="nav-group"><summary>'; i18n "Evidence route" "证据路线"; printf '</summary><div class="nav-sub">'
        if [ "${analysis_mode:-unspecified}" = denovo ] && [ "$denovo_present" = yes ]; then
            printf '<a href="#denovo">'; i18n "De novo route" "无参路线"; printf '</a>'
        else
            printf '<a href="#reference">'; i18n "Reference" "参考"; printf '</a><a class="nav-child" href="#qc">'; i18n "QC & quant" "质控定量"; printf '</a><a class="nav-child" href="#alignment">'; i18n "Alignment & count" "比对计数"; printf '</a>'
            if [ "$denovo_present" = yes ]; then
                printf '<a class="nav-child" href="#denovo">'; i18n "De novo route" "无参路线"; printf '</a>'
            fi
        fi
        printf '</div></details><details class="nav-group"><summary>'; i18n "Results" "结果"; printf '</summary><div class="nav-sub"><a href="#de">'; i18n "Differential expression" "差异表达"; printf '</a><a class="nav-child" href="#enrichment">'; i18n "Enrichment" "富集"; printf '</a></div></details><details class="nav-group"><summary>'; i18n "Delivery and audit" "交付与审计"; printf '</summary><div class="nav-sub"><a href="#deliverables">'; i18n "Deliverables" "交付文件"; printf '</a><a class="nav-child" href="#tools">'; i18n "Tools" "工具"; printf '</a><a class="nav-child" href="#provenance">'; i18n "Provenance" "溯源"; printf '</a></div></details></nav>\n'
        printf '<div class="sidebar-external external"><a href="report_interpretation.html" target="_blank" rel="noopener" data-embedded-report-id="report.interpretation" data-fallback-href="report_interpretation.html">'; i18n "Report interpretation guide" "报告解读指南"; printf '</a><a href="https://taffish.com" target="_blank" rel="noopener">'; i18n "TAFFISH official site" "TAFFISH 官网"; printf '</a><a href="https://github.com/taffish" target="_blank" rel="noopener">TAFFISH GitHub</a><a href="https://taffish.github.io/" target="_blank" rel="noopener">TAFFISH Hub</a></div></aside><main class="report-main content">\n'
        printf '<header class="hero"><div class="hero-top"><div class="eyebrow">'; i18n "TAFFISH RNA-seq project report" "TAFFISH RNA-seq 项目报告"; printf '</div></div><h1>%s</h1>\n' "$escaped_project"
        printf '<p><span class="lang-en">Generated by %s %s at %s UTC. This static report follows the RNA-seq analysis path from reference or de novo transcriptome evidence through read QC, expression, alignment, differential expression, enrichment, methods, and provenance.</span><span class="lang-zh">本报告由 %s %s 于 %s UTC 生成，按 RNA-seq 分析流程组织参考或无参转录组证据、测序质控、表达定量、比对计数、差异表达、功能富集、方法和溯源信息。</span></p>\n' "$FLOW_NAME" "$FLOW_VERSION" "$finished_at" "$FLOW_NAME" "$FLOW_VERSION" "$finished_at"
        printf '<div class="hero-meta"><span class="badge">'; i18n "Offline static HTML" "离线静态报告"; printf '</span><span class="badge">'; i18n "No analysis rerun" "不重新分析"; printf '</span><span class="badge">'; i18n "Language switchable" "语言可切换"; printf '</span>'
        case "${analysis_mode:-unspecified}" in
            reference)
                printf '<span class="badge">'; i18n "Reference analysis" "有参分析"; printf '</span>'
                ;;
            denovo)
                printf '<span class="badge">'; i18n "De novo analysis" "无参分析"; printf '</span>'
                ;;
            mixed)
                printf '<span class="badge">'; i18n "Mixed reference + de novo" "有参 + 无参混合"; printf '</span>'
                ;;
            *)
                printf '<span class="badge">'; i18n "Analysis mode unspecified" "分析模式未指定"; printf '</span>'
                ;;
        esac
        if [ "$denovo_present" = yes ]; then
            printf '<span class="badge">'; i18n "De novo route aware" "支持无参路线"; printf '</span>'
        fi
        printf '</div></header>\n'

        printf '<section class="section" id="overview"><div class="section-head"><div><span class="kicker">'; i18n "Project view" "项目视图"; printf '</span><h2>'; i18n "Executive Summary" "项目总览"; printf '</h2><p class="section-intro"><span class="lang-en">Key metrics are collected from machine-readable upstream outputs. They provide a first-pass view for biologists, bioinformaticians, and collaborators before detailed interpretation.</span><span class="lang-zh">关键指标来自上游流程的机器可读结果，用于让生物学家、生信分析人员和协作者快速了解项目状态；正式生物学解释仍应结合实验设计和专业判断。</span></p></div></div><div class="metric-grid">\n'
        write_metric_cards
        printf '</div></section>\n'

        printf '<section class="section" id="guide"><div class="section-head"><div><span class="kicker">'; i18n "Reading layer" "阅读层"; printf '</span><h2>'; i18n "How to Read This Report" "如何阅读本报告"; printf '</h2><p class="section-intro"><span class="lang-en">The main HTML keeps project outputs close to their biological questions. The companion guide explains the intended reading order, plot roles, and common interpretation boundaries in more detail.</span><span class="lang-zh">主 HTML 把项目结果放在对应的生物学问题下展示；配套解读指南进一步说明推荐阅读顺序、图表作用和常见解读边界。</span></p></div><a class="button-link" href="report_interpretation.html" target="_blank" rel="noopener" data-embedded-report-id="report.interpretation" data-fallback-href="report_interpretation.html">'; i18n "Open guide" "打开解读指南"; printf '</a></div><div class="deliverable-grid">'
        printf '<div class="deliverable-card"><strong>'; i18n "Quality before conclusions" "先质控再结论"; printf '</strong><p>'; i18n "Review read quality, sample structure, mapping/count evidence, and distribution plots before interpreting DE or enrichment." "在解释差异表达或富集前，先检查 reads 质量、样本结构、比对/计数证据和分布图。"; printf '</p></div>'
        printf '<div class="deliverable-card"><strong>'; i18n "Statistics before mechanism" "先统计再机制"; printf '</strong><p>'; i18n "DE tables and plots rank evidence for changed genes; they do not by themselves prove causal mechanisms." "差异表格和图形用于排序变化基因的证据；它们本身不直接证明因果机制。"; printf '</p></div>'
        printf '<div class="deliverable-card"><strong>'; i18n "Gene sets need context" "Gene set 需要背景"; printf '</strong><p>'; i18n "ORA and GSEA should be read with the gene universe, ID mapping, and gene-set source in mind." "解读 ORA 和 GSEA 时必须同时考虑背景基因集、ID 映射和 gene set 来源。"; printf '</p></div>'
        printf '<div class="deliverable-card"><strong>'; i18n "Reusable evidence" "可复用证据"; printf '</strong><p>'; i18n "Tables, plots, source links, commands, methods, and manifests are indexed so the report can be audited or reused." "报告索引了表格、图片、来源链接、命令、方法和 manifest，便于审计和复用。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="workflow"><div class="section-head"><div><span class="kicker">'; i18n "Biological logic" "生物学逻辑"; printf '</span><h2>'; i18n "Workflow and Biological Questions" "分析流程与生物学问题"; printf '</h2><p class="section-intro"><span class="lang-en">The report is organized by the biological role of each step rather than by file type. Each module answers a specific question, from whether the reads are usable to which genes and biological processes changed.</span><span class="lang-zh">报告按每一步的生物学意义组织，而不是把文件简单堆叠。每个模块回答一个具体问题：reads 是否可靠、表达是否可比、样本是否分组清楚、哪些基因变化、哪些功能过程受影响。</span></p></div></div>\n'
        if [ "${analysis_mode:-unspecified}" = denovo ] && [ "$denovo_present" = yes ]; then
            printf '<div class="workflow-map" aria-label="RNA-seq de novo workflow overview"><div class="flow-node primary"><strong>'; i18n "FASTQ reads" "FASTQ reads"; printf '</strong><span>'; i18n "raw sequencing data" "原始测序数据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "QC and trimming" "质控与修剪"; printf '</strong><span>'; i18n "read reliability" "reads 可靠性"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "Transcriptome assembly" "转录组组装"; printf '</strong><span>'; i18n "define feature space" "定义 feature 空间"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "Transcript quantification" "转录本定量"; printf '</strong><span>'; i18n "counts / TPM on assembled transcripts" "组装转录本 counts / TPM"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Homology annotation" "同源注释"; printf '</strong><span>'; i18n "ORF, protein hits, GO mapping" "ORF、蛋白命中、GO 映射"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "DE and enrichment" "差异与富集"; printf '</strong><span>'; i18n "feature-space aware evidence" "保留 feature 语义的证据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Report" "报告"; printf '</strong><span>'; i18n "delivery and provenance" "交付与溯源"; printf '</span></div></div>\n'
            printf '<p class="module-note"><span class="lang-en">This report is in de novo mode: reference genome alignment and featureCounts-style genome counting are not expected unless separate reference outputs are supplied. The key biological boundary is the assembled transcript feature space.</span><span class="lang-zh">本报告处于无参模式：除非额外提供有参输出，否则不期待参考基因组比对和 featureCounts 式基因组计数。核心生物学边界是组装转录本 feature 空间。</span></p>'
        else
            printf '<div class="workflow-map" aria-label="RNA-seq workflow overview"><div class="flow-node primary"><strong>'; i18n "FASTQ reads" "FASTQ reads"; printf '</strong><span>'; i18n "raw sequencing data" "原始测序数据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "QC and trimming" "质控与修剪"; printf '</strong><span>'; i18n "read reliability" "reads 可靠性"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "Quantification" "表达定量"; printf '</strong><span>'; i18n "gene and transcript abundance" "基因/转录本丰度"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "DE analysis" "差异表达"; printf '</strong><span>'; i18n "changed genes" "变化基因"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Enrichment" "功能富集"; printf '</strong><span>'; i18n "affected processes" "受影响过程"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Report" "报告"; printf '</strong><span>'; i18n "delivery and provenance" "交付与溯源"; printf '</span></div></div>\n'
            printf '<div class="workflow-map" aria-label="RNA-seq optional alignment branch"><div class="flow-node optional"><strong>'; i18n "Reference" "参考"; printf '</strong><span>'; i18n "genome and annotation" "基因组与注释"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Alignment" "比对"; printf '</strong><span>'; i18n "genome-aware BAM evidence" "基因组层面 BAM 证据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Counting" "计数"; printf '</strong><span>'; i18n "featureCounts matrix" "featureCounts 矩阵"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "RNA-seq QC" "RNA-seq QC"; printf '</strong><span>'; i18n "mapping and library quality" "比对与文库质量"; printf '</span></div></div>\n'
            if [ "$denovo_present" = yes ]; then
                printf '<div class="workflow-map" aria-label="RNA-seq de novo branch"><div class="flow-node optional"><strong>'; i18n "FASTQ reads" "FASTQ reads"; printf '</strong><span>'; i18n "no reference required" "不需要参考"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "De novo assembly" "无参组装"; printf '</strong><span>'; i18n "assembled transcripts" "组装转录本"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "De novo expression" "无参表达"; printf '</strong><span>'; i18n "transcript counts / TPM" "转录本 counts / TPM"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Annotation" "功能注释"; printf '</strong><span>'; i18n "homology and GO evidence" "同源与 GO 证据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Report" "报告"; printf '</strong><span>'; i18n "semantics preserved" "保留语义边界"; printf '</span></div></div>\n'
            fi
            printf '<p class="module-note"><span class="lang-en">The first line is the default lightweight reference expression route; the second line is the optional alignment/count evidence route. When de novo outputs are supplied, a third route records assembly, transcript-level quantification, and annotation evidence without relabeling assembled transcripts as known genes.</span><span class="lang-zh">第一行是默认轻量有参表达路线；第二行是在提供上游结果时纳入的可选比对/计数证据路线。若提供无参输出，第三条路线会记录组装、转录本层面定量和注释证据，并且不会把组装转录本误写成已知基因。</span></p>'
        fi
        printf '<h3>'; i18n "Detected upstream modules" "检测到的上游模块"; printf '</h3><div class="route">\n'
        for module in standard reference expression alignment alignment_qc count de enrichment denovo_assembly denovo_expression denovo_annotation; do
            if grep -F "$module	" "$upstream_outputs_file" >/dev/null 2>&1; then
                printf '<div class="step"><strong>%s</strong><span class="muted">' "$(html_escape "$module")"; i18n "provided" "已提供"; printf '</span></div>\n'
            fi
        done
        printf '</div><h3>'; i18n "Input output directories" "输入结果目录"; printf '</h3><div class="table-wrap"><table><thead><tr><th>'; i18n "Module" "模块"; printf '</th><th>'; i18n "Path" "路径"; printf '</th><th>'; i18n "Status" "状态"; printf '</th></tr></thead><tbody>\n'
        write_module_table_html
        printf '</tbody></table></div></section>\n'

        printf '<section class="section" id="reference"><div class="section-head"><div><span class="kicker">'; i18n "Step 1" "步骤 1"; printf '</span><h2>'; i18n "Reference Preparation" "参考构建"; printf '</h2><p class="section-intro"><span class="lang-en">This step standardizes the genome annotation, extracts transcript sequences, and builds indexes used by quantification and alignment. If reference IDs are inconsistent, every downstream result can become hard to interpret.</span><span class="lang-zh">这一步统一基因组注释、提取转录本序列，并构建定量和比对所需索引。参考序列和注释 ID 若不一致，下游结果会难以解释。</span></p></div></div>\n'
        if [ -n "$reference_out" ]; then
            printf '<div class="twocol"><div><h3>'; i18n "Reference summary" "参考摘要"; printf '</h3>\n'
            write_tsv_preview "$reference_out/04_reports/reference_summary.tsv" 20 2
            printf '</div><div><h3>'; i18n "Genome index" "基因组索引"; printf '</h3>\n'
            write_tsv_preview "$reference_out/04_reports/genome_index.tsv" 20 4
            printf '</div></div>'
        else
            printf '<div class="callout"><strong>'; i18n "Skipped by analysis mode" "按分析模式跳过"; printf '</strong><br><span class="lang-en">No reference output was supplied. In a de novo report this is expected: the transcript feature space is assembled from reads rather than imported from a genome annotation.</span><span class="lang-zh">未提供 reference 输出。在无参报告中这是预期行为：转录本 feature 空间来自 reads 组装，而不是来自基因组注释。</span></div>'
        fi
        printf '</section>\n'

        printf '<section class="section" id="qc"><div class="section-head"><div><span class="kicker">'; i18n "Step 2" "步骤 2"; printf '</span><h2>'; i18n "Read QC and Expression Quantification" "测序质控与表达定量"; printf '</h2><p class="section-intro"><span class="lang-en">Read-level QC checks sequencing quality and preprocessing behavior. Salmon quantification estimates transcript/gene abundance for the lightweight expression route.</span><span class="lang-zh">reads 层面的 QC 用来判断测序质量和预处理是否合理；Salmon 定量给出转录本/基因表达丰度，是轻量表达路线的核心输入。</span></p></div></div>\n'
        if [ -n "$expression_out" ]; then
            printf '<h3>'; i18n "QC reports" "质控报告"; printf '</h3><div class="report-grid">\n'
            write_html_reports_for "expression"
            printf '</div><div class="twocol"><div><h3>'; i18n "Expression summary" "表达定量摘要"; printf '</h3>\n'
            write_tsv_preview "$expression_out/04_reports/expression_summary.tsv" 20 2
            printf '</div><div><h3>'; i18n "Quant files" "定量文件"; printf '</h3>\n'
            write_tsv_preview "$expression_out/04_reports/quant_files.tsv" 20 3
            printf '</div></div>'
        else
            printf '<div class="callout"><strong>'; i18n "Reference quantification not supplied" "未提供有参表达定量"; printf '</strong><br><span class="lang-en">This report has no reference-route expression output. For de novo mode, read QC and Salmon quantification are shown in the de novo section because the quantified features are assembled transcript IDs.</span><span class="lang-zh">本报告没有有参表达定量输出。对于无参模式，reads 质控和 Salmon 定量会在无参章节展示，因为被定量的 feature 是组装 transcript ID。</span></div>'
        fi
        printf '</section>\n'

        printf '<section class="section" id="alignment"><div class="section-head"><div><span class="kicker">'; i18n "Optional evidence branch" "可选证据分支"; printf '</span><h2>'; i18n "Alignment, Counting, and RNA-seq QC" "比对、计数与 RNA-seq 质控"; printf '</h2><p class="section-intro"><span class="lang-en">The alignment branch provides genome-aware evidence, coordinate-sorted BAM files, featureCounts gene counts, and BAM/RNA-seq QC. It is useful for inspecting mapping quality, annotation compatibility, and count-based analyses.</span><span class="lang-zh">比对分支提供基因组层面的证据、排序 BAM、featureCounts 基因计数和 BAM/RNA-seq 质控，适合检查比对质量、注释兼容性和计数路线结果。</span></p></div></div>\n'
        if [ -n "$alignment_out" ] || [ -n "$count_out" ] || [ -n "$alignment_qc_out" ]; then
            printf '<h3>'; i18n "Alignment and QC reports" "比对与 QC 报告"; printf '</h3><div class="report-grid">\n'
            write_html_reports_for "alignment count alignment_qc"
            printf '</div><div class="twocol"><div><h3>'; i18n "Alignment summary" "比对摘要"; printf '</h3>\n'
            write_tsv_preview "$alignment_out/03_results/alignment_summary.tsv" 20 5
            printf '</div><div><h3>'; i18n "Count summary" "计数摘要"; printf '</h3>\n'
            write_tsv_preview "$count_out/04_reports/count_summary.tsv" 20 2
            printf '</div></div><h3>'; i18n "RNA-seq QC summary" "RNA-seq 质控摘要"; printf '</h3>\n'
            write_tsv_preview "$alignment_qc_out/04_reports/rnaseq_qc_summary.tsv" 20 6
        else
            printf '<div class="callout"><strong>'; i18n "Skipped by analysis mode" "按分析模式跳过"; printf '</strong><br><span class="lang-en">No genome-aware alignment, featureCounts, or alignment-QC outputs were supplied. In de novo mode this branch is intentionally absent because there is no reference genome coordinate system.</span><span class="lang-zh">未提供基因组比对、featureCounts 或 alignment-QC 输出。在无参模式中这是有意跳过的分支，因为没有参考基因组坐标系统。</span></div>'
        fi
        printf '</section>\n'

        if [ "$denovo_present" = yes ]; then
            printf '<section class="section" id="denovo"><div class="section-head"><div><span class="kicker">'; i18n "No-reference evidence branch" "无参证据分支"; printf '</span><h2>'; i18n "De novo Assembly, Expression, and Annotation" "无参组装、表达与注释"; printf '</h2><p class="section-intro"><span class="lang-en">The de novo route builds the transcript feature space from reads, quantifies assembled transcripts, and optionally transfers functional annotation from explicit protein/GO resources. These transcript IDs are assembled features, not known reference genes.</span><span class="lang-zh">无参路线从 reads 构建转录本 feature 空间，对组装转录本进行定量，并可从用户显式提供的蛋白/GO 资源转移功能注释。这些 transcript ID 是组装 feature，不是已知参考基因。</span></p></div></div><div class="mini-diagram"><div class="flow-node optional"><strong>'; i18n "Assembly" "组装"; printf '</strong><span>'; i18n "create transcriptome" "构建转录组"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Expression" "表达"; printf '</strong><span>'; i18n "transcript counts / TPM" "转录本 counts / TPM"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node optional"><strong>'; i18n "Annotation" "注释"; printf '</strong><span>'; i18n "ORF and homology evidence" "ORF 与同源证据"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Optional enrichment" "可选富集"; printf '</strong><span>'; i18n "only with GMT/background" "仅在有 GMT/background 时"; printf '</span></div></div>\n'
            printf '<div class="subsection-card"><h3>'; i18n "Assembly quality" "组装质量"; printf '</h3><p class="section-copy"><span class="lang-en">Assembly metrics describe the transcriptome object that replaces a reference-derived transcript FASTA. N50, filtered transcript count, read support, and optional BUSCO completeness help judge whether this feature space is credible enough for downstream expression.</span><span class="lang-zh">组装指标描述替代参考转录本 FASTA 的转录组对象。N50、过滤后转录本数量、read support 和可选 BUSCO 完整性用于判断这个 feature 空间是否足以支撑后续表达分析。</span></p><div class="twocol"><div><h3>'; i18n "Assembly summary" "组装摘要"; printf '</h3>\n'
            write_tsv_preview "$denovo_assembly_summary" 20 2
            printf '</div><div><h3>'; i18n "Assembly stats" "组装统计"; printf '</h3>\n'
            write_tsv_preview "$denovo_assembly_stats" 20 3
            printf '</div></div><h3>'; i18n "BUSCO status" "BUSCO 状态"; printf '</h3>\n'
            write_tsv_preview "$denovo_busco_summary" 20 2
            printf '<h3>'; i18n "Assembly QC reports" "组装 QC 报告"; printf '</h3><div class="report-grid">\n'
            write_html_reports_for "denovo_assembly"
            printf '</div></div><div class="subsection-card"><h3>'; i18n "De novo expression semantics" "无参表达矩阵语义"; printf '</h3><p class="section-copy"><span class="lang-en">The primary de novo expression matrices are transcript-level. Gene-level or pseudo-gene-level matrices are meaningful only when a tx2gene table or cluster map was explicitly supplied upstream.</span><span class="lang-zh">无参表达的主矩阵是转录本层面。只有上游显式提供 tx2gene 或聚类映射时，基因层面或伪基因层面矩阵才有相应语义。</span></p><div class="twocol"><div><h3>'; i18n "Expression summary" "表达摘要"; printf '</h3>\n'
            write_tsv_preview "$denovo_expression_summary" 20 2
            printf '</div><div><h3>'; i18n "Matrix semantics" "矩阵语义"; printf '</h3>\n'
            write_tsv_preview "$denovo_matrix_semantics" 20 5
            printf '</div></div><h3>'; i18n "De novo expression QC reports" "无参表达 QC 报告"; printf '</h3><div class="report-grid">\n'
            write_html_reports_for "denovo_expression"
            printf '</div></div><div class="subsection-card"><h3>'; i18n "Annotation and enrichment readiness" "注释与富集可用性"; printf '</h3><p class="section-copy"><span class="lang-en">Functional annotation is homology-derived evidence controlled by the supplied protein database and optional GO map. Enrichment is available only when annotation-derived GMT/background files exist and match the DE feature ID space.</span><span class="lang-zh">功能注释是由同源搜索转移而来的证据，受用户提供的蛋白数据库和可选 GO map 控制。只有注释流程生成的 GMT/background 文件存在，并且与差异分析 feature ID 空间一致时，富集才可用。</span></p><div class="twocol"><div><h3>'; i18n "Annotation summary" "注释摘要"; printf '</h3>\n'
            write_tsv_preview "$denovo_annotation_summary" 20 2
            printf '</div><div><h3>'; i18n "Annotation table preview" "注释表预览"; printf '</h3>\n'
            write_tsv_preview "$denovo_annotation_table" 12 8
            printf '</div></div>'
            if [ -n "$denovo_annotation_out" ] && [ -s "$denovo_annotation_out/03_results/gene_sets/denovo_go.gmt" ] && [ -s "$denovo_annotation_out/03_results/gene_sets/denovo_background.tsv" ]; then
                printf '<div class="callout"><strong>'; i18n "Enrichment-ready" "可用于富集"; printf '</strong><br><span class="lang-en">Annotation-derived <code>denovo_go.gmt</code> and <code>denovo_background.tsv</code> were collected. Downstream enrichment should still use the same transcript ID space as the de novo DE result.</span><span class="lang-zh">已收集注释生成的 <code>denovo_go.gmt</code> 和 <code>denovo_background.tsv</code>。下游富集仍必须使用与无参差异分析一致的 transcript ID 空间。</span></div>'
            else
                printf '<div class="callout"><strong>'; i18n "Enrichment not inferred" "未自动推断富集"; printf '</strong><br><span class="lang-en">No complete de novo GMT/background pair was detected. This is allowed: the report marks enrichment resources as unavailable instead of treating missing protein DB or GO mapping as a report failure.</span><span class="lang-zh">未检测到完整的无参 GMT/background 文件对。这是允许的：报告会把富集资源标记为不可用，而不是把缺少蛋白数据库或 GO 映射当成报告失败。</span></div>'
            fi
            printf '</div></section>\n'
        fi

        printf '<section class="section" id="de"><div class="section-head"><div><span class="kicker">'; i18n "Statistical contrast" "统计比较"; printf '</span><h2>'; i18n "Differential Expression" "差异表达"; printf '</h2><p class="section-intro"><span class="lang-en">This section asks which genes change between conditions. It first checks whether samples and expression distributions are trustworthy, then presents gene-level statistical evidence and candidate expression patterns.</span><span class="lang-zh">本节回答不同条件之间哪些基因发生变化。报告会先检查样本关系和表达分布是否可信，再展示基因层面的统计证据与候选基因表达模式。</span></p></div></div><div class="mini-diagram"><div class="flow-node primary"><strong>'; i18n "Count matrix" "计数矩阵"; printf '</strong><span>'; i18n "genes by samples" "基因 x 样本"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node primary"><strong>'; i18n "Design and contrast" "设计与比较"; printf '</strong><span>'; i18n "condition model" "条件模型"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>DESeq2</strong><span>'; i18n "statistics and shrinkage" "统计检验与收缩"; printf '</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "DE genes" "差异基因"; printf '</strong><span>'; i18n "ranked evidence" "排序证据"; printf '</span></div></div><div class="subsection-card"><h3>'; i18n "Sample structure and distributions" "样本结构与数据分布"; printf '</h3><p class="section-copy"><span class="lang-en">These plots are quality and design checks for the statistical model: PCA and correlation show sample relationships, while expression/count distributions show whether normalization and filtering produced comparable samples.</span><span class="lang-zh">这些图用于检查统计模型的前提：PCA 和相关性展示样本关系，表达/计数分布用于判断归一化与过滤后样本是否可比。</span></p><div class="plot-grid compact">\n'
        write_plot_cards_for "de" "pca_plot sample_correlation_heatmap expression_distribution normalized_count_distribution"
        printf '</div></div><div class="subsection-card"><h3>'; i18n "Differential expression signal" "差异表达信号"; printf '</h3><p class="section-copy"><span class="lang-en">These figures summarize the actual contrast: volcano and MA plots combine effect size with uncertainty, DEG counts show the threshold-level balance, and heatmap/top-gene plots make representative expression patterns inspectable.</span><span class="lang-zh">这些图展示真正的组间比较结果：火山图和 MA 图结合效应量与不确定性，差异基因数量图展示阈值下的方向平衡，热图和 Top 基因图帮助查看代表性表达模式。</span></p><div class="plot-grid compact">\n'
        write_plot_cards_for "de" "volcano_plot ma_plot deg_counts_barplot heatmap top_genes_expression"
        printf '</div></div><div class="twocol"><div><h3>'; i18n "DE summary" "差异表达摘要"; printf '</h3>\n'
        write_tsv_preview "$de_summary" 20 2
        printf '</div><div><h3>'; i18n "Standard run summary" "standard-flow 摘要"; printf '</h3>\n'
        write_tsv_preview "$standard_summary" 20 2
        printf '</div></div><h3>'; i18n "Top DESeq2 rows" "DESeq2 结果预览"; printf '</h3>\n'
        write_tsv_preview "$de_results" 20 7
        printf '</section>\n'

        printf '<section class="section" id="enrichment"><div class="section-head"><div><span class="kicker">'; i18n "Biological interpretation layer" "生物学解释层"; printf '</span><h2>'; i18n "Functional Enrichment" "功能富集"; printf '</h2><p class="section-intro"><span class="lang-en">Enrichment analysis groups changed genes into biological processes or gene sets, helping move from a gene list to biological hypotheses. The displayed terms should be interpreted with the selected background and gene-set source in mind.</span><span class="lang-zh">富集分析把差异基因组织到生物过程或基因集合中，帮助从基因列表走向生物学假设。解读这些条目时必须同时考虑背景基因集合和 gene set 来源。</span></p></div></div><div class="mini-diagram"><div class="flow-node primary"><strong>'; i18n "DE genes" "差异基因"; printf '</strong><span>ORA</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Over-represented sets" "过度代表集合"; printf '</strong><span>'; i18n "term-level hypothesis" "条目层面假设"; printf '</span></div><div class="flow-node primary"><strong>'; i18n "Ranked genes" "排序基因"; printf '</strong><span>GSEA</span></div><div class="flow-arrow">-&gt;</div><div class="flow-node result"><strong>'; i18n "Directional signals" "方向性信号"; printf '</strong><span>'; i18n "pathway-like trend" "通路式趋势"; printf '</span></div></div>\n'
        printf '<div class="subsection-card"><h3>'; i18n "ORA visual summary" "ORA 可视化摘要"; printf '</h3><p class="section-copy"><span class="lang-en">ORA starts from the significant-gene list and asks which gene sets contain more hits than expected under the selected background universe. The readable dotplot is the primary review figure, the classic dotplot preserves a familiar audit view, and the barplot emphasizes the strongest term-level signals.</span><span class="lang-zh">ORA 从显著差异基因列表出发，检验在选定背景基因集中哪些 gene set 命中数高于随机期望。可读气泡图是主要查看图，经典气泡图保留常见审计视图，柱状图突出最强的条目层面信号。</span></p><div class="plot-grid compact">\n'
        write_plot_cards_for "enrichment" "dotplot dotplot_original ora_barplot"
        printf '</div></div><div class="subsection-card"><h3>'; i18n "GSEA directional summary" "GSEA 方向性摘要"; printf '</h3><p class="section-copy"><span class="lang-en">GSEA uses the ranked gene list rather than a hard significant-gene cutoff. NES plots compare positive and negative enrichment directions, while running curves show where representative gene-set members accumulate along the ranked evidence list.</span><span class="lang-zh">GSEA 使用排序基因列表，而不是只看显著基因阈值。NES 图比较正向和负向富集强度，running curve 展示代表性 gene set 成员在排序证据列表中的累积位置。</span></p><div class="plot-grid compact">\n'
        write_plot_cards_for "enrichment" "gsea_nes_plot gsea_enrichment_curves"
        printf '</div></div><div class="twocol"><div><h3>'; i18n "Enrichment summary" "富集摘要"; printf '</h3>\n'
        write_tsv_preview "$enrichment_summary" 20 2
        printf '</div><div class="callout"><strong>'; i18n "Interpretation boundary" "解读边界"; printf '</strong><br><span class="lang-en">This flow reports offline GMT-based ORA/GSEA outputs produced upstream. Gene set source, ID space, background universe, and biological interpretation remain project decisions.</span><span class="lang-zh">本流程只汇总上游基于离线 GMT 的 ORA/GSEA 结果。gene set 来源、ID 空间、背景基因集和最终生物学解释仍属于项目决策。</span></div></div><h3>'; i18n "Top ORA rows" "ORA 结果预览"; printf '</h3>\n'
        write_tsv_preview "$ora_results" 20 8
        printf '<h3>'; i18n "Top GSEA rows" "GSEA 结果预览"; printf '</h3>\n'
        write_tsv_preview "$gsea_results" 20 8
        printf '</section>\n'

        printf '<section class="section" id="deliverables"><div class="section-head"><div><span class="kicker">'; i18n "Files to reuse" "可复用文件"; printf '</span><h2>'; i18n "Deliverables and Output Structure" "交付文件与输出结构"; printf '</h2><p class="section-intro"><span class="lang-en">The report directory is designed for project delivery: the main HTML is the entry point and carries embedded child-report payloads, while TSV indexes keep every copied table, plot, HTML report bundle, method record, version row, and command log auditable.</span><span class="lang-zh">报告目录面向项目交付：主 HTML 是入口，并携带可打开的子报告 payload；TSV 索引则保留每个复制的表格、图片、HTML 报告 bundle、方法、版本和命令记录，便于审计和复用。</span></p></div></div><div class="deliverable-grid"><div class="deliverable-card"><strong>04_reports/rnaseq_report.html</strong><p>'; i18n "Main bilingual standalone static report with embedded QC/report child pages." "主双语单文件静态报告，内嵌 QC/报告子页面。"; printf '</p></div><div class="deliverable-card"><strong>04_reports/report_interpretation.html</strong><p>'; i18n "Companion guide for reading plots, biological context, and interpretation boundaries." "用于阅读图表、生物学背景和解读边界的配套指南。"; printf '</p></div><div class="deliverable-card"><strong>03_results/collected_tables/</strong><p>'; i18n "Copied summary tables and key matrices." "复制的摘要表和关键矩阵。"; printf '</p></div><div class="deliverable-card"><strong>03_results/collected_plots/</strong><p>'; i18n "Copied PNG/PDF plot files used by the report." "报告使用的 PNG/PDF 图片副本。"; printf '</p></div><div class="deliverable-card"><strong>03_results/collected_html/</strong><p>'; i18n "Copied original QC/report HTML bundles retained for audit and fallback." "复制的原始 QC/报告 HTML bundle，保留用于审计和回退。"; printf '</p></div><div class="deliverable-card"><strong>04_reports/embedded_html_reports.tsv</strong><p>'; i18n "Machine-readable index of child HTML payloads embedded into the main report." "主报告内嵌子 HTML payload 的机器可读索引。"; printf '</p></div><div class="deliverable-card"><strong>04_reports/*.tsv</strong><p>'; i18n "Machine-readable indexes, metrics, versions, and links." "机器可读索引、指标、版本和链接。"; printf '</p></div><div class="deliverable-card"><strong>run.manifest.json</strong><p>'; i18n "Run manifest for automation and archiving." "用于自动化和归档的运行 manifest。"; printf '</p></div></div><pre class="tree">&lt;outdir&gt;/\n  00_inputs/upstream_outputs.tsv\n  01_logs/flow.log\n  01_logs/steps/\n  03_results/collected_tables/\n  03_results/collected_plots/\n  03_results/collected_html/\n  04_reports/rnaseq_report.html\n  04_reports/report_interpretation.html\n  04_reports/project_summary.tsv\n  04_reports/key_metrics.tsv\n  04_reports/plot_gallery.tsv\n  04_reports/html_reports.tsv\n  04_reports/embedded_html_reports.tsv\n  04_reports/tool_links.tsv\n  04_reports/commands.sh\n  04_reports/versions.tsv\n  04_reports/methods.txt\n  run.manifest.json</pre><div class="twocol"><div><h3>'; i18n "Plot gallery index" "图片索引"; printf '</h3>\n'
        write_tsv_preview "$plot_gallery_file" 20 4
        printf '</div><div><h3>'; i18n "HTML report index" "HTML 报告索引"; printf '</h3>\n'
        write_tsv_preview "$html_reports_file" 20 8
        printf '</div></div><h3>'; i18n "Embedded child-report payloads" "内嵌子报告 payload"; printf '</h3>\n'
        write_tsv_preview "$embedded_html_reports_file" 20 10
        printf '<h3>'; i18n "Embedded table payloads" "内嵌表格 payload"; printf '</h3><p class="section-copy"><span class="lang-en">Collected TSV/text tables are also stored inside this main HTML. Opening a table creates a local text page from the embedded payload, so the report remains readable even when the surrounding result directory is not copied.</span><span class="lang-zh">收集到的 TSV/text 表格也会存入主 HTML。点击表格会从内嵌 payload 打开本地文本页，因此即使没有复制外层结果目录，报告仍然可以查看这些表格内容。</span></p>\n'
        write_embedded_table_links_html
        printf '<p class="html-open-note"><span class="lang-en">Report and source links open in a new browser tab to keep the main project report in place. When available, QC/report child pages are opened from payloads embedded inside this main HTML; copied bundles remain as fallback and audit material.</span><span class="lang-zh">报告和来源链接默认在新标签页打开，以便保留主项目报告位置。可用时，QC/报告子页面会从主 HTML 内部携带的 payload 打开；复制出来的 bundle 仍保留作为回退和审计材料。</span></p></section>\n'

        printf '<section class="section" id="tools"><div class="section-head"><div><span class="kicker">'; i18n "Reproducibility" "可复现性"; printf '</span><h2>'; i18n "Tools and Source Links" "工具与来源链接"; printf '</h2><p class="section-intro"><span class="lang-en">Tool and flow versions are collected from upstream <code>versions.tsv</code> files. Links point to TAFFISH wrappers or upstream project pages when known.</span><span class="lang-zh">工具和流程版本来自上游 <code>versions.tsv</code>。链接优先指向 TAFFISH 包装仓库或已知上游项目页面。</span></p></div></div><div class="table-wrap"><table><thead><tr><th>'; i18n "Tool or flow" "工具或流程"; printf '</th><th>'; i18n "Version" "版本"; printf '</th><th>'; i18n "Recorded source" "记录来源"; printf '</th><th>'; i18n "Link" "链接"; printf '</th></tr></thead><tbody>\n'
        write_tool_links_html
        printf '</tbody></table></div></section>\n'

        printf '<section class="section" id="provenance"><div class="section-head"><div><span class="kicker">'; i18n "Audit trail" "审计线索"; printf '</span><h2>'; i18n "Provenance and Reuse" "溯源与复用"; printf '</h2><p class="section-intro"><span class="lang-en">The report keeps a compact index of collected files plus full commands, methods, versions, and manifest outputs for audit and rerun context.</span><span class="lang-zh">报告保留收集文件索引、完整命令、方法描述、版本和 manifest，便于审计、复查和复现。</span></p></div></div><div class="twocol"><div><h3>'; i18n "Report summary" "报告摘要"; printf '</h3>\n'
        write_tsv_preview "$project_summary_file" 20 2
        printf '</div><div><h3>'; i18n "Collected files" "收集文件"; printf '</h3>\n'
        write_tsv_preview "$collected_files_file" 20 6
        printf '</div></div><h3>'; i18n "Versions" "版本"; printf '</h3>\n'
        write_tsv_preview "$versions_file" 30 3
        printf '<p class="footer-note"><span class="lang-en">Full commands and methods are available as <code>04_reports/commands.sh</code> and <code>04_reports/methods.txt</code>. The interpretation companion is <code>04_reports/report_interpretation.html</code>, and the JSON manifest is <code>run.manifest.json</code>. This report is a static collector and does not replace expert biological review.</span><span class="lang-zh">完整命令和方法记录位于 <code>04_reports/commands.sh</code> 与 <code>04_reports/methods.txt</code>，配套解读页面位于 <code>04_reports/report_interpretation.html</code>，JSON manifest 位于 <code>run.manifest.json</code>。本报告是静态汇总器，不替代专业生物学审阅。</span></p></section>\n'
        printf '<footer class="report-footer"><p><span class="lang-en">Generated with the TAFFISH flow-report template contract.</span><span class="lang-zh">基于 TAFFISH flow-report 模板契约生成。</span></p><p>Template: TAFFISH flow-report %s. Report flow: %s %s.</p></footer>\n' "$FLOW_REPORT_TEMPLATE_VERSION" "$FLOW_NAME" "$FLOW_VERSION"
        printf '</main></div></div>\n'
        write_embedded_payload_script
        write_embedded_table_payload_script
        printf '</body>\n</html>\n'
    } > "$report_html"
}

for core_cmd in awk base64 basename cat chmod cp date dirname find grep mkdir mv rm sed sh sort tr wc; do
    command -v "$core_cmd" >/dev/null 2>&1 || fail "missing required shell utility: $core_cmd"
done

case "$outdir_arg" in
    ''|'.'|'..'|'/') fail "--outdir must be a dedicated output directory" ;;
esac

case "$analysis_mode_arg" in
    auto|reference|denovo|mixed) ;;
    *) fail "--analysis-mode must be auto, reference, denovo, or mixed" ;;
esac

case "$analysis_route_arg" in
    auto|salmon|both|none|unknown) ;;
    *) fail "--analysis-route must be auto, salmon, both, none, or unknown" ;;
esac

case "$de_source_arg" in
    auto|salmon|featurecounts|none|unknown) ;;
    *) fail "--de-source must be auto, salmon, featurecounts, none, or unknown" ;;
esac

cwd=$(pwd)
outdir=$(resolve_path "$outdir_arg" "$cwd")

standard_out=""
reference_out=""
expression_out=""
alignment_out=""
count_out=""
alignment_qc_out=""
de_out=""
enrichment_out=""
denovo_assembly_out=""
denovo_expression_out=""
denovo_annotation_out=""
standard_report_package=no

[ -n "$standard_arg" ] && standard_out=$(resolve_path "$standard_arg" "$cwd")
[ -n "$reference_arg" ] && reference_out=$(resolve_path "$reference_arg" "$cwd")
[ -n "$expression_arg" ] && expression_out=$(resolve_path "$expression_arg" "$cwd")
[ -n "$alignment_arg" ] && alignment_out=$(resolve_path "$alignment_arg" "$cwd")
[ -n "$count_arg" ] && count_out=$(resolve_path "$count_arg" "$cwd")
[ -n "$alignment_qc_arg" ] && alignment_qc_out=$(resolve_path "$alignment_qc_arg" "$cwd")
[ -n "$de_arg" ] && de_out=$(resolve_path "$de_arg" "$cwd")
[ -n "$enrichment_arg" ] && enrichment_out=$(resolve_path "$enrichment_arg" "$cwd")
[ -n "$denovo_assembly_arg" ] && denovo_assembly_out=$(resolve_path "$denovo_assembly_arg" "$cwd")
[ -n "$denovo_expression_arg" ] && denovo_expression_out=$(resolve_path "$denovo_expression_arg" "$cwd")
[ -n "$denovo_annotation_arg" ] && denovo_annotation_out=$(resolve_path "$denovo_annotation_arg" "$cwd")

if [ -n "$standard_out" ]; then
    [ -d "$standard_out" ] || fail "--standard-out is not a directory: $standard_out"
    [ -z "$reference_out" ] && [ -d "$standard_out/03_results/reference" ] && reference_out="$standard_out/03_results/reference"
    [ -z "$expression_out" ] && [ -d "$standard_out/03_results/expression" ] && expression_out="$standard_out/03_results/expression"
    [ -z "$alignment_out" ] && [ -d "$standard_out/03_results/alignment" ] && alignment_out="$standard_out/03_results/alignment"
    [ -z "$count_out" ] && [ -d "$standard_out/03_results/count" ] && count_out="$standard_out/03_results/count"
    [ -z "$alignment_qc_out" ] && [ -d "$standard_out/03_results/alignment_qc" ] && alignment_qc_out="$standard_out/03_results/alignment_qc"
    [ -z "$de_out" ] && [ -d "$standard_out/03_results/de" ] && de_out="$standard_out/03_results/de"
    [ -z "$enrichment_out" ] && [ -d "$standard_out/03_results/enrichment" ] && enrichment_out="$standard_out/03_results/enrichment"
    [ -z "$denovo_assembly_out" ] && [ -d "$standard_out/03_results/denovo_assembly" ] && denovo_assembly_out="$standard_out/03_results/denovo_assembly"
    [ -z "$denovo_expression_out" ] && [ -d "$standard_out/03_results/denovo_expression" ] && denovo_expression_out="$standard_out/03_results/denovo_expression"
    [ -z "$denovo_annotation_out" ] && [ -d "$standard_out/03_results/denovo_annotation" ] && denovo_annotation_out="$standard_out/03_results/denovo_annotation"
    [ -z "$denovo_assembly_out" ] && [ -d "$standard_out/03_results/denovo-assembly" ] && denovo_assembly_out="$standard_out/03_results/denovo-assembly"
    [ -z "$denovo_expression_out" ] && [ -d "$standard_out/03_results/denovo-expression" ] && denovo_expression_out="$standard_out/03_results/denovo-expression"
    [ -z "$denovo_annotation_out" ] && [ -d "$standard_out/03_results/denovo-annotation" ] && denovo_annotation_out="$standard_out/03_results/denovo-annotation"
    if [ -s "$standard_out/04_reports/collected_files.tsv" ] && [ -d "$standard_out/03_results/collected_tables" ]; then
        standard_report_package=yes
    fi
fi

provided_count=0
for value in "$standard_out" "$reference_out" "$expression_out" "$alignment_out" "$count_out" "$alignment_qc_out" "$de_out" "$enrichment_out" "$denovo_assembly_out" "$denovo_expression_out" "$denovo_annotation_out"; do
    [ -n "$value" ] && provided_count=$((provided_count + 1))
done
[ "$provided_count" -gt 0 ] || fail "provide --standard-out or at least one upstream output directory"

if [ -n "$denovo_assembly_out" ] || [ -n "$denovo_expression_out" ] || [ -n "$denovo_annotation_out" ]; then
    denovo_present=yes
fi
if [ "$standard_report_package" = yes ]; then
    package_mode=$(metric_value "$standard_out/04_reports/project_summary.tsv" analysis_mode "")
    [ -n "$package_mode" ] || package_mode=$(metric_value "$standard_out/04_reports/flow_summary.tsv" analysis_mode "")
    [ "$package_mode" = denovo ] && denovo_present=yes
fi

if [ -e "$outdir" ]; then
    if is_true "$force_arg"; then
        [ -d "$outdir" ] || fail "--outdir exists and is not a directory: $outdir"
        rm -rf "$outdir/00_inputs" "$outdir/01_logs" "$outdir/02_intermediate" "$outdir/03_results" "$outdir/04_reports" "$outdir/run.manifest.json"
    else
        fail "--outdir already exists: $outdir (use --force to replace rnaseq-report-flow outputs)"
    fi
fi

inputs_dir="$outdir/00_inputs"
logs_dir="$outdir/01_logs"
logs_steps_dir="$logs_dir/steps"
intermediate_dir="$outdir/02_intermediate"
results_dir="$outdir/03_results"
collected_tables_dir="$results_dir/collected_tables"
collected_plots_dir="$results_dir/collected_plots"
collected_html_dir="$results_dir/collected_html"
reports_dir="$outdir/04_reports"

mkdir -p "$inputs_dir" "$logs_steps_dir" "$intermediate_dir" "$collected_tables_dir" "$collected_plots_dir" "$collected_html_dir" "$reports_dir"

flow_log="$logs_dir/flow.log"
upstream_outputs_file="$inputs_dir/upstream_outputs.tsv"
commands_file="$reports_dir/commands.sh"
versions_file="$reports_dir/versions.tsv"
methods_file="$reports_dir/methods.txt"
project_summary_file="$reports_dir/project_summary.tsv"
key_metrics_file="$reports_dir/key_metrics.tsv"
collected_files_file="$reports_dir/collected_files.tsv"
plot_files_file="$reports_dir/plot_files.tsv"
plot_gallery_file="$reports_dir/plot_gallery.tsv"
html_reports_file="$reports_dir/html_reports.tsv"
embedded_html_reports_file="$reports_dir/embedded_html_reports.tsv"
tool_links_file="$reports_dir/tool_links.tsv"
flow_summary_file="$reports_dir/flow_summary.tsv"
report_template_version_file="$reports_dir/report_template_version.txt"
report_html="$reports_dir/rnaseq_report.html"
interpretation_html="$reports_dir/report_interpretation.html"
manifest_file="$outdir/run.manifest.json"
logo_rel="$TAFFISH_LOGO_DATA_URI"
started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

prepare_standard_report_package_inputs
if [ -n "$denovo_assembly_out" ] || [ -n "$denovo_expression_out" ] || [ -n "$denovo_annotation_out" ]; then
    denovo_present=yes
fi

: > "$flow_log"
{
    printf '#!/bin/sh\n'
    printf 'set -eu\n\n'
    printf '# Generated by %s %s at %s\n' "$FLOW_NAME" "$FLOW_VERSION" "$started_at"
    printf '# This report flow collected existing upstream outputs and did not execute analysis dependencies.\n'
    [ -n "$standard_out" ] && printf '# standard_out=%s\n' "$(sq "$standard_out")"
    printf '# standard_report_package=%s\n' "$standard_report_package"
    [ -n "$denovo_assembly_out" ] && printf '# denovo_assembly_out=%s\n' "$(sq "$denovo_assembly_out")"
    [ -n "$denovo_expression_out" ] && printf '# denovo_expression_out=%s\n' "$(sq "$denovo_expression_out")"
    [ -n "$denovo_annotation_out" ] && printf '# denovo_annotation_out=%s\n' "$(sq "$denovo_annotation_out")"
} > "$commands_file"
chmod +x "$commands_file"

{
    printf 'tool\tversion\tsource\n'
    printf 'rnaseq-report-flow\t%s\ttaffish flow\n' "$FLOW_VERSION"
    printf 'flow-report-template\t%s\trepos/apps/templates/flow-report\n' "$FLOW_REPORT_TEMPLATE_VERSION"
} > "$versions_file"

{
    printf '%s %s collects existing RNA-seq flow outputs into an enhanced standalone static project report rendered against the TAFFISH flow-report template contract %s.\n\n' "$FLOW_NAME" "$FLOW_VERSION" "$FLOW_REPORT_TEMPLATE_VERSION"
    printf 'It also writes an offline companion interpretation guide for report reading order, plot roles, and common interpretation boundaries.\n\n'
    printf 'When upstream QC/report HTML bundles are available, the main report embeds child-page payloads and opens them in a separate local browser page without using blob, iframe, or srcdoc transport.\n\n'
    printf 'Collected TSV/text tables are also embedded into the main report as base64 payloads so a copied single HTML can still expose report-level table contents.\n\n'
    printf 'When supplied, it also collects de novo assembly, de novo expression, and de novo annotation outputs while preserving transcript-level feature semantics.\n\n'
    printf 'It does not rerun expression quantification, assembly, annotation, alignment, counting, QC, differential expression, or enrichment. Biological interpretation remains the user responsibility.\n'
} > "$methods_file"

printf 'module\tpath\tstatus\n' > "$upstream_outputs_file"
printf 'module\trole\toriginal_path\tlocal_path\tkind\tbytes\n' > "$collected_files_file"
printf 'module\tplot\tformat\toriginal_path\tlocal_path\trelative_path\tbytes\n' > "$plot_files_file"
printf 'module\treport\ttype\toriginal_path\tlocal_path\trelative_path\tbytes\tbundle_id\n' > "$html_reports_file"
printf 'bundle_id\tmodule\treport\ttype\tlocal_path\trelative_path\tbytes\tembedded_path\tembedded_bytes\tstatus\n' > "$embedded_html_reports_file"

log "begin $FLOW_NAME $FLOW_VERSION"

log "START 01_collect_inputs"
if {
    register_module "standard" "$standard_out"
    register_module "reference" "$reference_out"
    register_module "expression" "$expression_out"
    register_module "alignment" "$alignment_out"
    register_module "count" "$count_out"
    register_module "alignment_qc" "$alignment_qc_out"
    register_module "de" "$de_out"
    register_module "enrichment" "$enrichment_out"
    register_module "denovo_assembly" "$denovo_assembly_out"
    register_module "denovo_expression" "$denovo_expression_out"
    register_module "denovo_annotation" "$denovo_annotation_out"

    [ -n "$standard_out" ] && collect_standard "$standard_out"
    [ -n "$reference_out" ] && collect_reference "$reference_out"
    [ -n "$expression_out" ] && collect_expression "$expression_out"
    [ -n "$alignment_out" ] && collect_alignment "$alignment_out"
    [ -n "$count_out" ] && collect_count "$count_out"
    [ -n "$alignment_qc_out" ] && collect_alignment_qc "$alignment_qc_out"
    [ -n "$de_out" ] && collect_de "$de_out"
    [ -n "$enrichment_out" ] && collect_enrichment "$enrichment_out"
    [ -n "$denovo_assembly_out" ] && collect_denovo_assembly "$denovo_assembly_out"
    [ -n "$denovo_expression_out" ] && collect_denovo_expression "$denovo_expression_out"
    [ -n "$denovo_annotation_out" ] && collect_denovo_annotation "$denovo_annotation_out"

    printf 'provided_modules\t%s\n' "$module_count"
    printf 'collected_files\t%s\n' "$collected_count"
    printf 'collected_tables\t%s\n' "$copied_table_count"
    printf 'collected_plots\t%s\n' "$copied_plot_count"
    [ "$collected_count" -gt 0 ] || {
        printf 'ERROR: no recognizable report files were collected from the provided upstream directories\n'
        exit 2
    }
} > "$logs_steps_dir/01_collect_inputs.log" 2>&1; then
    log "DONE  01_collect_inputs"
else
    log "FAIL  01_collect_inputs; see $logs_steps_dir/01_collect_inputs.log"
    exit 1
fi

log "START 02_render_report"
if {
    finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    build_plot_gallery
    write_tool_links
    printf '%s\n' "$FLOW_REPORT_TEMPLATE_VERSION" > "$report_template_version_file"
    write_interpretation_html
    repair_html_mojibake_if_needed "$interpretation_html"
    collect_html_bundle "report" "interpretation" "$interpretation_html" "html"
    write_key_metrics
    write_project_summary
    write_report_html
    repair_html_mojibake_if_needed "$report_html"

    {
        printf '{\n'
        printf '  "flow": "rnaseq-report-flow",\n'
        printf '  "version": %s,\n' "$(json_string "$FLOW_VERSION")"
        printf '  "template": "taffish-flow-report",\n'
        printf '  "template_version": %s,\n' "$(json_string "$FLOW_REPORT_TEMPLATE_VERSION")"
        printf '  "project_name": %s,\n' "$(json_string "$project_name")"
        printf '  "started_at": %s,\n' "$(json_string "$started_at")"
        printf '  "finished_at": %s,\n' "$(json_string "$finished_at")"
        printf '  "standard_report_package": %s,\n' "$(json_string "$standard_report_package")"
        printf '  "denovo_present": %s,\n' "$(json_string "$denovo_present")"
        printf '  "provided_modules": %s,\n' "$module_count"
        printf '  "collected_files": %s,\n' "$collected_count"
        printf '  "collected_tables": %s,\n' "$copied_table_count"
        printf '  "collected_plots": %s,\n' "$copied_plot_count"
        printf '  "collected_html_reports": %s,\n' "$copied_html_count"
        printf '  "embedded_html_reports": %s,\n' "$embedded_html_count"
        printf '  "embedded_tables": %s,\n' "$(embedded_table_count_value)"
        printf '  "plot_groups": %s,\n' "$(row_count "$plot_gallery_file")"
        printf '  "html_report_links": %s,\n' "$(row_count "$html_reports_file")"
        printf '  "outputs": {\n'
        printf '    "report": %s,\n' "$(json_string "$report_html")"
        printf '    "interpretation_guide": %s,\n' "$(json_string "$interpretation_html")"
        printf '    "project_summary": %s,\n' "$(json_string "$project_summary_file")"
        printf '    "key_metrics": %s,\n' "$(json_string "$key_metrics_file")"
        printf '    "collected_files": %s,\n' "$(json_string "$collected_files_file")"
        printf '    "plot_files": %s,\n' "$(json_string "$plot_files_file")"
        printf '    "plot_gallery": %s,\n' "$(json_string "$plot_gallery_file")"
        printf '    "html_reports": %s,\n' "$(json_string "$html_reports_file")"
        printf '    "embedded_html_reports": %s,\n' "$(json_string "$embedded_html_reports_file")"
        printf '    "report_template_version": %s,\n' "$(json_string "$report_template_version_file")"
        printf '    "tool_links": %s,\n' "$(json_string "$tool_links_file")"
        printf '    "versions": %s,\n' "$(json_string "$versions_file")"
        printf '    "methods": %s\n' "$(json_string "$methods_file")"
        printf '  }\n'
        printf '}\n'
    } > "$manifest_file"

    printf 'report\t%s\n' "$report_html"
    printf 'interpretation_guide\t%s\n' "$interpretation_html"
    printf 'project_summary\t%s\n' "$project_summary_file"
    printf 'key_metrics\t%s\n' "$key_metrics_file"
    printf 'collected_files\t%s\n' "$collected_files_file"
    printf 'plot_gallery\t%s\n' "$plot_gallery_file"
    printf 'html_reports\t%s\n' "$html_reports_file"
    printf 'embedded_html_reports\t%s\n' "$embedded_html_reports_file"
    printf 'report_template_version\t%s\n' "$report_template_version_file"
    printf 'tool_links\t%s\n' "$tool_links_file"
} > "$logs_steps_dir/02_render_report.log" 2>&1; then
    log "DONE  02_render_report"
else
    log "FAIL  02_render_report; see $logs_steps_dir/02_render_report.log"
    exit 1
fi

log "completed. Report: $report_html"
log "summary: $project_summary_file"
