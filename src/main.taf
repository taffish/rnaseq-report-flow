build_plot_gallery() {
    awk -F '\t' -v OFS='\t' '
        NR == 1 { next }
        {
            key = $1 SUBSEP $2
            if (!(key in seen)) {
                seen[key] = 1
                order[++n] = key
                module[key] = $1
                role[key] = $2
            }
            if ($3 == "png") png[key] = $6
            else if ($3 == "pdf") pdf[key] = $6
        }
        END {
            print "module", "plot", "png", "pdf"
            for (i = 1; i <= n; i++) {
                key = order[i]
                print module[key], role[key], (key in png ? png[key] : ""), (key in pdf ? pdf[key] : "")
            }
        }
    ' "$plot_files_file" > "$plot_gallery_file"
}

tool_link_url() {
    tool_name=$1
    case "$tool_name" in
        rnaseq-*-flow) printf 'https://github.com/taffish/%s\n' "$tool_name" ;;
        taf-salmon|salmon) printf 'https://github.com/COMBINE-lab/salmon\n' ;;
        taf-kallisto|kallisto) printf 'https://github.com/pachterlab/kallisto\n' ;;
        taf-hisat2|hisat2) printf 'https://github.com/DaehwanKimLab/hisat2\n' ;;
        taf-fastp|fastp) printf 'https://github.com/OpenGene/fastp\n' ;;
        taf-fastqc|FastQC|fastqc) printf 'https://www.bioinformatics.babraham.ac.uk/projects/fastqc/\n' ;;
        taf-multiqc|MultiQC|multiqc) printf 'https://github.com/MultiQC/MultiQC\n' ;;
        taf-samtools|samtools) printf 'https://github.com/samtools/samtools\n' ;;
        taf-subread|subread|featureCounts) printf 'https://subread.sourceforge.net/\n' ;;
        taf-rseqc|RSeQC|rseqc) printf 'https://rseqc.sourceforge.net/\n' ;;
        taf-qualimap|Qualimap|qualimap) printf 'http://qualimap.conesalab.org/\n' ;;
        taf-gffread|gffread) printf 'https://github.com/gpertea/gffread\n' ;;
        taf-agat|agat|AGAT) printf 'https://github.com/NBISweden/AGAT\n' ;;
        taf-bioconductor-rnaseq) printf 'https://bioconductor.org/packages/DESeq2/\n' ;;
        taf-enrichment-r|enrichment-r) printf 'https://github.com/taffish/enrichment-r\n' ;;
        taf-trinity|trinity|Trinity) printf 'https://github.com/trinityrnaseq/trinityrnaseq\n' ;;
        taf-spades|spades|rnaSPAdes|rnaspades.py) printf 'https://github.com/ablab/spades\n' ;;
        taf-seqkit|seqkit) printf 'https://github.com/shenwei356/seqkit\n' ;;
        taf-busco|BUSCO|busco) printf 'https://gitlab.com/ezlab/busco\n' ;;
        taf-transdecoder|TransDecoder|transdecoder) printf 'https://github.com/TransDecoder/TransDecoder\n' ;;
        taf-diamond|DIAMOND|diamond) printf 'https://github.com/bbuchfink/diamond\n' ;;
        taf-*-v*) short_name=${tool_name#taf-}; short_name=${short_name%-v*}; printf 'https://github.com/taffish/%s\n' "$short_name" ;;
        taf-*) short_name=${tool_name#taf-}; printf 'https://github.com/taffish/%s\n' "$short_name" ;;
        DESeq2) printf 'https://bioconductor.org/packages/DESeq2/\n' ;;
        tximport) printf 'https://bioconductor.org/packages/tximport/\n' ;;
        *) printf '.\n' ;;
    esac
}

write_tool_links() {
    {
        printf 'tool\tversion\tsource\turl\n'
        awk -F '\t' 'NR > 1 && $1 != "" && !seen[$1]++ { print $1 "\t" $2 "\t" $3 }' "$versions_file" |
        while IFS="$(printf '\t')" read -r tool_name tool_version tool_source; do
            tool_url=$(tool_link_url "$tool_name")
            printf '%s\t%s\t%s\t%s\n' "$tool_name" "$tool_version" "$tool_source" "$tool_url"
        done
    } > "$tool_links_file"
}

write_tsv_preview() {
    preview_file=$1
    max_rows=$2
    max_cols=$3
    if [ ! -s "$preview_file" ]; then
        printf '<p class="muted">No table available.</p>\n'
        return 0
    fi
    awk -F '\t' -v max_rows="$max_rows" -v max_cols="$max_cols" '
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR == 1 {
            ncols = NF
            if (max_cols > 0 && ncols > max_cols) ncols = max_cols
            print "<div class=\"table-wrap\"><table>"
            printf "<thead><tr>"
            for (i = 1; i <= ncols; i++) printf "<th>%s</th>", esc($i)
            print "</tr></thead><tbody>"
            next
        }
        NR > 1 && rows < max_rows {
            printf "<tr>"
            for (i = 1; i <= ncols; i++) printf "<td>%s</td>", esc($i)
            print "</tr>"
            rows++
        }
        END {
            if (NR > 0) {
                print "</tbody></table></div>"
                total = NR - 1
                if (total > max_rows) {
                    printf "<p class=\"muted\">Showing %d of %d rows.</p>\n", max_rows, total
                }
            }
        }
    ' "$preview_file"
}

i18n() {
    printf '<span class="lang-en">%s</span><span class="lang-zh">%s</span>' "$(html_escape "$1")" "$(html_escape "$2")"
}

has_utf8_latin1_mojibake() {
    check_file=$1
    marker_ae=$(printf '\303\246')
    marker_cc=$(printf '\303\247')
    marker_aa=$(printf '\303\245')
    marker_a4=$(printf '\303\244')
    LC_ALL=C grep -aq "$marker_ae" "$check_file" ||
        LC_ALL=C grep -aq "$marker_cc" "$check_file" ||
        LC_ALL=C grep -aq "$marker_aa" "$check_file" ||
        LC_ALL=C grep -aq "$marker_a4" "$check_file"
}

repair_html_mojibake_if_needed() {
    html_file=$1
    has_utf8_latin1_mojibake "$html_file" || return 0
    command -v iconv >/dev/null 2>&1 || fail "generated HTML appears to contain UTF-8/Latin-1 mojibake, but iconv is unavailable for repair: $html_file"
    repair_tmp="$html_file.repair.$$"
    if iconv -f UTF-8 -t ISO-8859-1 "$html_file" > "$repair_tmp" 2>/dev/null; then
        mv "$repair_tmp" "$html_file"
        printf 'encoding_repair\tutf8_latin1_mojibake_repaired\t%s\n' "$html_file"
    else
        rm -f "$repair_tmp"
        fail "generated HTML appears to contain UTF-8/Latin-1 mojibake, and automatic iconv repair failed: $html_file"
    fi
}

write_metric_cards() {
    awk -F '\t' '
        function zh_label(s) {
            if (s == "Analysis mode") return "分析模式"
            if (s == "Samples") return "样本数"
            if (s == "Route") return "分析路线"
            if (s == "DE source") return "差异分析输入"
            if (s == "Avg Salmon reads") return "平均 Salmon reads"
            if (s == "Avg mapped %") return "平均比对率"
            if (s == "featureCounts assigned") return "featureCounts 分配 reads"
            if (s == "QC assigned tags") return "QC 分配 tags"
            if (s == "Tested genes") return "参与检验基因"
            if (s == "Significant genes") return "显著差异基因"
            if (s == "Up / down genes") return "上调 / 下调"
            if (s == "ORA terms") return "ORA 条目"
            if (s == "GSEA terms") return "GSEA 条目"
            if (s == "De novo filtered transcripts") return "无参过滤转录本"
            if (s == "De novo N50") return "无参 N50"
            if (s == "De novo BUSCO") return "无参 BUSCO"
            if (s == "De novo matrix semantics") return "无参矩阵语义"
            if (s == "De novo transcript rows") return "无参转录本行数"
            if (s == "Pseudo-gene rows") return "伪基因/聚类行数"
            if (s == "Annotated transcripts") return "已注释转录本"
            if (s == "GO gene sets") return "GO gene set"
            if (s == "Collected plots") return "收集图组"
            if (s == "Linked HTML reports") return "链接 HTML 报告"
            return s
        }
        function zh_note(s) {
            if (s ~ /reference-guided or de novo/) return "本报告对应有参、无参或混合 RNA-seq 分析模式"
            if (s ~ /RNA-seq samples/) return "本次分析包含的 RNA-seq 样本数量"
            if (s ~ /reference route with lightweight Salmon/) return "有参路线：同时包含 Salmon 轻量表达定量以及可选的比对、计数和 QC 证据"
            if (s ~ /reference route using transcript quantification/) return "有参路线：使用转录本定量和 tximport 派生的基因矩阵"
            if (s ~ /reference route using genome alignment/) return "有参路线：使用基因组比对和 featureCounts 式基因计数"
            if (s ~ /reference route recorded/) return "上游 standard-flow 记录的有参分析路线"
            if (s ~ /route was detected, but the archived upstream package/) return "检测到有参路线，但归档的上游结果包没有记录 route 参数"
            if (s ~ /no-reference route/) return "无参路线：先组装转录组，再基于组装转录本进行 Salmon 定量"
            if (s ~ /standard-flow route/) return "standard-flow 记录的主路线"
            if (s ~ /DESeq2 input matrix derived from Salmon/) return "DESeq2 输入矩阵来自 Salmon 转录本定量经 tximport 汇总后的基因计数"
            if (s ~ /DESeq2 input matrix derived from reference-genome alignment/) return "DESeq2 输入矩阵来自参考基因组比对和 featureCounts 基因计数"
            if (s ~ /count matrix source recorded/) return "上游 standard-flow 记录的差异分析表达矩阵来源"
            if (s ~ /DE results were collected, but the archived upstream package/) return "已收集差异分析结果，但归档的上游结果包没有记录 count 来源"
            if (s ~ /count-like matrix built from assembled transcript/) return "用于差异分析的是由组装转录本定量得到的 count-like 矩阵"
            if (s ~ /count matrix used/) return "用于差异表达分析的表达矩阵来源"
            if (s ~ /de novo mode/) return "无参模式下 Salmon reads 指基于组装转录组定量得到的 estimated reads"
            if (s ~ /mean estimated_num_reads/) return "Salmon 定量得到的平均 estimated reads"
            if (s ~ /not applicable without reference genome alignment/) return "无参模式没有参考基因组比对时不适用"
            if (s ~ /mean HISAT2/) return "HISAT2 比对摘要中的平均 mapped percent"
            if (s ~ /assigned reads reported/) return "featureCounts 计数中成功分配到基因的 reads"
            if (s ~ /sum of RSeQC/) return "RSeQC 报告的 assigned tags 合计"
            if (s ~ /genes retained/) return "进入 DESeq2 检验的基因数"
            if (s ~ /padj and log2FC/) return "同时满足 padj 与 log2FC 阈值的基因数"
            if (s ~ /direction split/) return "显著差异基因中的方向分布"
            if (s ~ /over-representation/) return "ORA 富集结果表中的条目数"
            if (s ~ /preranked enrichment/) return "preranked GSEA 结果表中的条目数"
            if (s ~ /assembled transcriptome after length filtering/) return "长度过滤后的组装转录本数量"
            if (s ~ /filtered de novo transcript N50/) return "过滤后无参转录本 N50"
            if (s ~ /BUSCO completeness step status/) return "BUSCO 完整性评估步骤状态"
            if (s ~ /transcript-level only/) return "当前无参表达矩阵是转录本层面；没有额外聚合到伪基因或基因层面"
            if (s ~ /tx2gene or cluster mapping/) return "无参表达矩阵由显式映射聚合得到"
            if (s ~ /transcript-level expression feature rows/) return "转录本层面表达矩阵的 feature 行数"
            if (s ~ /gene or cluster rows from optional mapping/) return "可选映射得到的基因或聚类矩阵行数"
            if (s ~ /transcripts with homology annotation/) return "具有同源注释证据的转录本数量"
            if (s ~ /annotation-derived GMT gene sets/) return "由注释转移生成的 GMT gene set 数量"
            if (s ~ /PNG\\/PDF plot groups/) return "报告中按生物学模块组织的图组数"
            if (s ~ /QC\\/report HTML/) return "从上游流程复制并链接的 HTML 报告"
            return s
        }
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 {
            printf "<article class=\"metric\"><span><span class=\"lang-en\">%s</span><span class=\"lang-zh\">%s</span></span><strong>%s</strong><small><span class=\"lang-en\">%s</span><span class=\"lang-zh\">%s</span></small></article>\n", esc($1), esc(zh_label($1)), esc($2), esc($3), esc(zh_note($3))
        }
    ' "$key_metrics_file"
}

write_html_reports_html() {
    if [ ! -s "$html_reports_file" ]; then
        printf '<p class="muted"><span class="lang-en">No external HTML or QC report bundles were collected.</span><span class="lang-zh">没有收集到外部 HTML 或 QC 报告 bundle。</span></p>\n'
        return 0
    fi
    awk -F '\t' '
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 {
            title = $1 " / " $2
            attrs = ""
            if ($8 != "") attrs = sprintf(" data-embedded-report-id=\"%s\" data-fallback-href=\"%s\"", esc($8), esc($6))
            printf "<article class=\"report-link\"><div><span class=\"report-type\">%s</span><strong>%s</strong><small>%s</small></div><a href=\"%s\" target=\"_blank\" rel=\"noopener\"%s><span class=\"lang-en\">Open report</span><span class=\"lang-zh\">打开报告</span></a></article>\n", esc($3), esc(title), esc($4), esc($6), attrs
        }
    ' "$html_reports_file"
}

write_html_reports_for() {
    modules_filter=$1
    if [ ! -s "$html_reports_file" ]; then
        printf '<p class="muted"><span class="lang-en">No HTML/QC report bundles were collected for this section.</span><span class="lang-zh">本章节没有收集到 HTML/QC 报告 bundle。</span></p>\n'
        return 0
    fi
    awk -F '\t' -v modules_filter="$modules_filter" '
        BEGIN {
            split(modules_filter, module_parts, " ")
            for (i in module_parts) wanted[module_parts[i]] = 1
        }
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 && ($1 in wanted) {
            found = 1
            title = $1 " / " $2
            attrs = ""
            if ($8 != "") attrs = sprintf(" data-embedded-report-id=\"%s\" data-fallback-href=\"%s\"", esc($8), esc($6))
            printf "<article class=\"report-link\"><div><span class=\"report-type\">%s</span><strong>%s</strong><small>%s</small></div><a href=\"%s\" target=\"_blank\" rel=\"noopener\"%s><span class=\"lang-en\">Open report</span><span class=\"lang-zh\">打开报告</span></a></article>\n", esc($3), esc(title), esc($4), esc($6), attrs
        }
        END {
            if (!found) print "<p class=\"muted\"><span class=\"lang-en\">No HTML/QC report bundles were collected for this section.</span><span class=\"lang-zh\">本章节没有收集到 HTML/QC 报告 bundle。</span></p>"
        }
    ' "$html_reports_file"
}

write_tool_links_html() {
    if [ ! -s "$tool_links_file" ]; then
        printf '<p class="muted"><span class="lang-en">No tool version records were collected.</span><span class="lang-zh">没有收集到工具版本记录。</span></p>\n'
        return 0
    fi
    awk -F '\t' '
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 {
            printf "<tr><td>%s</td><td>%s</td><td>%s</td><td>", esc($1), esc($2), esc($3)
            if ($4 != "." && $4 != "") printf "<a href=\"%s\" target=\"_blank\" rel=\"noopener\"><span class=\"lang-en\">source</span><span class=\"lang-zh\">来源</span></a>", esc($4)
            else printf "<span class=\"muted\">.</span>"
            print "</td></tr>"
        }
    ' "$tool_links_file"
}

write_plot_gallery_html() {
    if [ ! -s "$plot_gallery_file" ]; then
        printf '<p class="muted"><span class="lang-en">No plot files were collected.</span><span class="lang-zh">没有收集到图片文件。</span></p>\n'
        return 0
    fi
    awk -F '\t' '
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 && $3 != "" {
            title = $1 " / " $2
            printf "<figure class=\"plot-card\"><a href=\"%s\" target=\"_blank\" rel=\"noopener\"><img src=\"%s\" alt=\"%s\"></a><figcaption><strong>%s</strong>", esc($3), esc($3), esc(title), esc(title)
            if ($4 != "") printf "<a href=\"%s\" target=\"_blank\" rel=\"noopener\">PDF</a>", esc($4)
            print "</figcaption></figure>"
        }
    ' "$plot_gallery_file"
}

write_plot_cards_for() {
    module_filter=$1
    roles_filter=$2
    if [ ! -s "$plot_gallery_file" ]; then
        printf '<p class="muted"><span class="lang-en">No plots were collected for this section.</span><span class="lang-zh">本章节没有收集到图片。</span></p>\n'
        return 0
    fi
    awk -F '\t' -v module_filter="$module_filter" -v roles_filter="$roles_filter" '
        BEGIN {
            split(roles_filter, role_parts, " ")
            for (i in role_parts) wanted[role_parts[i]] = 1
        }
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        function label_en(role) {
            if (role == "pca_plot") return "PCA sample structure"
            if (role == "sample_correlation_heatmap") return "Sample correlation"
            if (role == "expression_distribution") return "Expression distribution"
            if (role == "normalized_count_distribution") return "Normalized counts"
            if (role == "volcano_plot") return "Volcano plot"
            if (role == "ma_plot") return "MA plot"
            if (role == "deg_counts_barplot") return "DEG count summary"
            if (role == "heatmap") return "Top DEG heatmap"
            if (role == "top_genes_expression") return "Top gene expression"
            if (role == "dotplot") return "Readable enrichment dotplot"
            if (role == "dotplot_original") return "Classic enrichment dotplot"
            if (role == "ora_barplot") return "ORA top-term barplot"
            if (role == "gsea_nes_plot") return "GSEA NES ranking"
            if (role == "gsea_enrichment_curves") return "GSEA enrichment curves"
            return role
        }
        function label_zh(role) {
            if (role == "pca_plot") return "PCA 样本结构"
            if (role == "sample_correlation_heatmap") return "样本相关性"
            if (role == "expression_distribution") return "表达分布"
            if (role == "normalized_count_distribution") return "归一化计数分布"
            if (role == "volcano_plot") return "火山图"
            if (role == "ma_plot") return "MA 图"
            if (role == "deg_counts_barplot") return "差异基因数量"
            if (role == "heatmap") return "差异基因热图"
            if (role == "top_genes_expression") return "Top 基因表达"
            if (role == "dotplot") return "可读富集气泡图"
            if (role == "dotplot_original") return "经典富集气泡图"
            if (role == "ora_barplot") return "ORA Top 条目柱状图"
            if (role == "gsea_nes_plot") return "GSEA NES 排名"
            if (role == "gsea_enrichment_curves") return "GSEA 富集曲线"
            return role
        }
        function meaning_en(role) {
            if (role == "pca_plot") return "Shows whether biological groups separate and whether outlier samples need review."
            if (role == "sample_correlation_heatmap") return "Checks replicate similarity and global sample relationships."
            if (role ~ /distribution/) return "Reviews expression/count distribution before interpreting DE results."
            if (role == "volcano_plot") return "Combines effect size and significance to highlight candidate DE genes."
            if (role == "ma_plot") return "Shows fold-change behavior across mean expression levels."
            if (role == "deg_counts_barplot") return "Summarizes up- and down-regulated gene counts under the selected thresholds."
            if (role == "heatmap") return "Shows expression patterns of selected variable or DE genes across samples."
            if (role == "top_genes_expression") return "Makes high-impact DE genes easier to inspect by sample group."
            if (role == "dotplot") return "Summarizes enriched biological processes with wrapped readable labels."
            if (role == "dotplot_original") return "Preserves the classic enrichment view with improved canvas sizing for audit."
            if (role == "ora_barplot") return "Ranks top over-represented gene sets by significance while showing term-level signal."
            if (role == "gsea_nes_plot") return "Shows the strongest positive and negative normalized enrichment scores from preranked GSEA."
            if (role == "gsea_enrichment_curves") return "Displays running enrichment curves for representative GSEA gene sets."
            return ""
        }
        function meaning_zh(role) {
            if (role == "pca_plot") return "查看实验组是否分离、是否存在离群样本。"
            if (role == "sample_correlation_heatmap") return "检查重复样本一致性和整体样本关系。"
            if (role ~ /distribution/) return "在解读差异表达前检查表达量或计数分布。"
            if (role == "volcano_plot") return "同时展示效应量和显著性，突出候选差异基因。"
            if (role == "ma_plot") return "查看不同表达水平上的倍数变化趋势。"
            if (role == "deg_counts_barplot") return "汇总阈值下上调和下调基因数量。"
            if (role == "heatmap") return "展示代表性基因在样本间的表达模式。"
            if (role == "top_genes_expression") return "便于按样本组查看重点差异基因表达。"
            if (role == "dotplot") return "用换行后的可读标签展示富集生物过程。"
            if (role == "dotplot_original") return "保留经典富集视图，并优化画布尺寸以便审计。"
            if (role == "ora_barplot") return "按显著性展示 ORA Top 基因集合，便于快速查看条目强度。"
            if (role == "gsea_nes_plot") return "展示 preranked GSEA 中正向和负向最强的标准化富集分数。"
            if (role == "gsea_enrichment_curves") return "展示代表性 GSEA gene set 的 running enrichment 曲线。"
            return ""
        }
        NR > 1 && $1 == module_filter && $3 != "" && ($2 in wanted) {
            found = 1
            alt = label_en($2) " / " label_zh($2)
            printf "<figure class=\"plot-card\"><a href=\"%s\" target=\"_blank\" rel=\"noopener\"><img src=\"%s\" alt=\"%s\"></a><figcaption><strong><span class=\"lang-en\">%s</span><span class=\"lang-zh\">%s</span></strong>", esc($3), esc($3), esc(alt), esc(label_en($2)), esc(label_zh($2))
            if ($4 != "") printf "<a href=\"%s\" target=\"_blank\" rel=\"noopener\">PDF</a>", esc($4)
            printf "</figcaption><p class=\"plot-note\"><span class=\"lang-en\">%s</span><span class=\"lang-zh\">%s</span></p></figure>\n", esc(meaning_en($2)), esc(meaning_zh($2))
        }
        END {
            if (!found) print "<p class=\"muted\"><span class=\"lang-en\">No plots were collected for this section.</span><span class=\"lang-zh\">本章节没有收集到图片。</span></p>"
        }
    ' "$plot_gallery_file"
}

write_module_table_html() {
    awk -F '\t' '
        function esc(s, out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "&") out = out "&amp;"
                else if (c == "<") out = out "&lt;"
                else if (c == ">") out = out "&gt;"
                else if (c == "\"") out = out "&quot;"
                else out = out c
            }
            return out
        }
        NR > 1 {
            printf "<tr><td>%s</td><td><code>%s</code></td><td><span class=\"pill\">%s</span></td></tr>\n", esc($1), esc($2), esc($3)
        }
    ' "$upstream_outputs_file"
}

write_embedded_payload_script() {
    if [ ! -s "$embedded_html_reports_file" ]; then
        printf '<script type="application/json" id="taffish-embedded-html-reports">{}</script>\n'
        return 0
    fi
    printf '<script type="application/json" id="taffish-embedded-html-reports">{'
    first_payload=1
    tab_char=$(printf '\t')
    {
        IFS= read -r _header || true
        while IFS="$tab_char" read -r bundle_id module role report_type local_path rel_file source_bytes embedded_path embedded_bytes status; do
            [ "$status" = embedded ] || continue
            [ -s "$embedded_path" ] || continue
            if [ "$first_payload" -eq 0 ]; then
                printf ','
            fi
            first_payload=0
            printf '\n'
            printf '%s:{' "$(json_string "$bundle_id")"
            printf '"module":%s,' "$(json_string "$module")"
            printf '"report":%s,' "$(json_string "$role")"
            printf '"type":%s,' "$(json_string "$report_type")"
            printf '"relative_path":%s,' "$(json_string "$rel_file")"
            printf '"source_bytes":%s,' "$source_bytes"
            printf '"embedded_bytes":%s,' "$embedded_bytes"
            printf '"html_b64":"'
            base64_one_line "$embedded_path"
            printf '"}'
        done
    } < "$embedded_html_reports_file"
    printf '\n}</script>\n'
}

embedded_table_count_value() {
    if [ ! -s "$collected_files_file" ]; then
        printf '0\n'
        return 0
    fi
    awk -F '\t' 'NR > 1 && $5 == "table" { c++ } END { print c + 0 }' "$collected_files_file"
}

embedded_table_id() {
    safe_name "$1.$2.$3"
}

write_embedded_table_payload_script() {
    if [ ! -s "$collected_files_file" ]; then
        printf '<script type="application/json" id="taffish-embedded-tables">{}</script>\n'
        return 0
    fi
    printf '<script type="application/json" id="taffish-embedded-tables">{'
    first_payload=1
    tab_char=$(printf '\t')
    {
        IFS= read -r _header || true
        while IFS="$tab_char" read -r module role original_path local_path kind bytes; do
            [ "$kind" = table ] || continue
            [ -s "$local_path" ] || continue
            table_id=$(embedded_table_id "$module" "$role" "$(basename "$local_path")")
            if [ "$first_payload" -eq 0 ]; then
                printf ','
            fi
            first_payload=0
            printf '\n'
            printf '%s:{' "$(json_string "$table_id")"
            printf '"module":%s,' "$(json_string "$module")"
            printf '"role":%s,' "$(json_string "$role")"
            printf '"name":%s,' "$(json_string "$(basename "$local_path")")"
            printf '"bytes":%s,' "$bytes"
            printf '"text_b64":"'
            base64_one_line "$local_path"
            printf '"}'
        done
    } < "$collected_files_file"
    printf '\n}</script>\n'
}

write_embedded_table_links_html() {
    if [ ! -s "$collected_files_file" ]; then
        printf '<p class="muted">No embedded tables available.</p>\n'
        return 0
    fi
    printf '<div class="report-grid embedded-table-grid">\n'
    tab_char=$(printf '\t')
    table_rows=0
    {
        IFS= read -r _header || true
        while IFS="$tab_char" read -r module role original_path local_path kind bytes; do
            [ "$kind" = table ] || continue
            [ -s "$local_path" ] || continue
            table_id=$(embedded_table_id "$module" "$role" "$(basename "$local_path")")
            table_rows=$((table_rows + 1))
            printf '<article class="report-link embedded-table-link"><div class="table-link-body"><span class="report-type">%s</span><strong>%s</strong><small>%s</small></div><a href="about:blank" target="_blank" rel="noopener" data-embedded-table-id="%s">%s</a></article>\n' \
                "$(html_escape "$module")" \
                "$(html_escape "$role")" \
                "$(html_escape "$(basename "$local_path")")" \
                "$(html_escape "$table_id")" \
                "$(i18n "Open table" "打开表格")"
        done
    } < "$collected_files_file"
    printf '</div>\n'
    [ "$table_rows" -gt 0 ] || printf '<p class="muted">No embedded tables available.</p>\n'
}

write_key_metrics() {
    standard_summary="$standard_out/04_reports/flow_summary.tsv"
    standard_key_metrics="$standard_out/04_reports/key_metrics.tsv"
    de_summary="$de_out/04_reports/de_summary.tsv"
    enrichment_summary="$enrichment_out/03_results/enrichment/enrichment_summary.tsv"
    expression_summary="$expression_out/04_reports/expression_summary.tsv"
    alignment_summary="$alignment_out/03_results/alignment_summary.tsv"
    count_summary="$count_out/04_reports/count_summary.tsv"
    alignment_qc_summary="$alignment_qc_out/04_reports/rnaseq_qc_summary.tsv"
    denovo_assembly_summary=""
    denovo_expression_flow_summary=""
    denovo_expression_summary=""
    denovo_mapping_summary=""
    denovo_annotation_summary=""
    [ -n "$denovo_assembly_out" ] && denovo_assembly_summary="$denovo_assembly_out/04_reports/flow_summary.tsv"
    if [ -n "$denovo_expression_out" ]; then
        denovo_expression_flow_summary="$denovo_expression_out/04_reports/flow_summary.tsv"
        denovo_expression_summary="$denovo_expression_out/04_reports/expression_summary.tsv"
        denovo_mapping_summary="$denovo_expression_out/04_reports/mapping_summary.tsv"
    fi
    [ -n "$denovo_annotation_out" ] && denovo_annotation_summary="$denovo_annotation_out/04_reports/annotation_summary.tsv"

    analysis_mode="$analysis_mode_arg"
    if [ "$analysis_mode" = auto ]; then
        analysis_mode=$(metric_value "$standard_summary" mode ".")
    fi
    if [ "$analysis_mode" = "." ] || [ "$analysis_mode" = auto ]; then
        if [ "$denovo_present" = yes ] && [ -z "$reference_out" ]; then
            analysis_mode="denovo"
        elif [ -n "$reference_out" ] || [ -n "$expression_out" ] || [ -n "$alignment_out" ] || [ -n "$count_out" ] || [ -n "$alignment_qc_out" ] || [ -n "$de_out" ] || [ -n "$enrichment_out" ]; then
            analysis_mode="reference"
        elif [ "$denovo_present" = yes ]; then
            analysis_mode="mixed"
        else
            analysis_mode="unspecified"
        fi
    fi
    case "$analysis_mode" in
        reference) analysis_mode_display="reference / genome-guided" ;;
        denovo) analysis_mode_display="denovo / no-reference" ;;
        mixed) analysis_mode_display="mixed reference + denovo" ;;
        *) analysis_mode_display="$analysis_mode" ;;
    esac

    samples=$(metric_value "$standard_summary" sample_count ".")
    if [ "$samples" = "." ]; then
        samples=$(metric_value "$de_summary" samples ".")
    fi
    if [ "$samples" = "." ]; then
        samples=$(metric_value "$standard_key_metrics" Samples ".")
    fi
    if [ "$samples" = "." ] && [ "$analysis_mode" = denovo ]; then
        samples=$(metric_value "$denovo_expression_flow_summary" sample_count ".")
    fi
    route="$analysis_route_arg"
    if [ "$route" = auto ]; then
        route=$(metric_value "$standard_summary" route ".")
    fi
    if [ "$route" = "." ] && [ "$analysis_mode" != denovo ]; then
        route=$(metric_value "$standard_key_metrics" Route ".")
    fi
    if [ "$route" = "." ] && [ "$analysis_mode" = denovo ]; then
        route="salmon"
    fi
    de_source="$de_source_arg"
    if [ "$de_source" = auto ]; then
        de_source=$(metric_value "$standard_summary" de_source ".")
    fi
    if [ "$de_source" = "." ] && [ "$analysis_mode" != denovo ]; then
        de_source=$(metric_value "$standard_key_metrics" "DE source" ".")
    fi
    if [ "$de_source" = "." ] && [ "$analysis_mode" = denovo ]; then
        de_source="salmon"
    fi
    tested_genes=$(metric_value "$de_summary" tested_genes ".")
    significant_genes=$(metric_value "$de_summary" significant_genes ".")
    up_genes=$(metric_value "$de_summary" up_genes ".")
    down_genes=$(metric_value "$de_summary" down_genes ".")
    ora_terms=$(metric_value "$enrichment_summary" ora_result_count ".")
    gsea_terms=$(metric_value "$enrichment_summary" gsea_result_count ".")
    average_salmon_reads=$(average_column "$expression_summary" estimated_num_reads)
    if [ "$analysis_mode" = denovo ] && [ "$average_salmon_reads" = "." ]; then
        average_salmon_reads=$(average_column "$denovo_expression_summary" estimated_num_reads)
    fi
    average_mapped_pct=$(average_column "$alignment_summary" mapped_percent)
    assigned_reads=$(metric_value "$count_summary" assigned_reads ".")
    qc_assigned_tags=$(sum_column "$alignment_qc_summary" assigned_tags)
    denovo_filtered_transcripts=$(metric_value "$denovo_assembly_summary" filtered_transcripts ".")
    denovo_n50=$(metric_value "$denovo_assembly_summary" filtered_n50 ".")
    denovo_busco=$(metric_value "$denovo_assembly_summary" busco_status ".")
    denovo_mapping_mode=$(metric_value "$denovo_mapping_summary" mapping_mode ".")
    case "$denovo_mapping_mode" in
        none) denovo_matrix_semantics="transcript-level only; no tx2gene/cluster aggregation" ;;
        tx2gene) denovo_matrix_semantics="tx2gene or cluster mapping: tx2gene-derived gene-like matrix" ;;
        cluster) denovo_matrix_semantics="tx2gene or cluster mapping: cluster-derived pseudo-gene matrix" ;;
        .) denovo_matrix_semantics="." ;;
        *) denovo_matrix_semantics="$denovo_mapping_mode" ;;
    esac
    denovo_transcript_rows=$(metric_value "$denovo_expression_summary" transcript_rows ".")
    if [ "$denovo_transcript_rows" = "." ]; then
        denovo_transcript_rows=$(metric_value "$denovo_expression_flow_summary" transcript_rows ".")
    fi
    denovo_gene_rows=$(metric_value "$denovo_expression_summary" gene_rows ".")
    if [ "$denovo_gene_rows" = "." ]; then
        denovo_gene_rows=$(metric_value "$denovo_expression_flow_summary" gene_rows ".")
    fi
    denovo_annotated_transcripts=$(metric_value "$denovo_annotation_summary" annotated_transcript_count ".")
    denovo_gene_sets=$(metric_value "$denovo_annotation_summary" gene_set_count ".")
    plots=$(row_count "$plot_gallery_file")
    html_reports=$(row_count "$html_reports_file")
    embedded_html_reports=$(row_count "$embedded_html_reports_file")
    embedded_tables=$(embedded_table_count_value)

    route_display="$route"
    route_note="standard-flow route when available"
    de_source_display="$de_source"
    de_source_note="count matrix used for differential expression"
    salmon_note="mean estimated_num_reads across samples"
    mapped_note="mean HISAT2 mapped_percent across samples"
    count_note="assigned reads reported by count flow"
    qc_note="sum of RSeQC assigned_tags when available"
    if [ "$analysis_mode" = reference ]; then
        if [ "$route" = "." ]; then
            if [ -n "$alignment_out" ] || [ -n "$count_out" ] || [ -n "$alignment_qc_out" ]; then
                route="both"
            elif [ -n "$expression_out" ]; then
                route="salmon"
            else
                route="not recorded"
            fi
        fi
        case "$route" in
            both)
                route_display="both (Salmon + HISAT2/featureCounts evidence)"
                route_note="reference route with lightweight Salmon quantification plus optional alignment/count/QC evidence"
                ;;
            salmon|expression)
                route_display="Salmon/tximport expression route"
                route_note="reference route using transcript quantification and tximport-derived gene matrix"
                ;;
            alignment|count|featurecounts|featureCounts)
                route_display="alignment/count evidence route"
                route_note="reference route using genome alignment and featureCounts-style gene counts"
                ;;
            "not recorded")
                route_display="not recorded by upstream package"
                route_note="reference route was detected, but the archived upstream package did not record the route parameter"
                ;;
            *)
                route_display="$route"
                route_note="reference route recorded by the upstream standard flow"
                ;;
        esac
        if [ "$de_source" = "." ]; then
            de_source="not recorded"
        fi
        case "$de_source" in
            salmon|tximport|expression)
                de_source_display="Salmon/tximport gene counts"
                de_source_note="DESeq2 input matrix derived from Salmon transcript quantification via tximport"
                ;;
            featurecounts|featureCounts)
                de_source_display="featureCounts gene counts"
                de_source_note="DESeq2 input matrix derived from reference-genome alignment and featureCounts"
                ;;
            "not recorded")
                de_source_display="not recorded by upstream package"
                de_source_note="DE results were collected, but the archived upstream package did not record the count source"
                ;;
            *)
                de_source_display="$de_source"
                de_source_note="count matrix source recorded by the upstream standard flow"
                ;;
        esac
    fi
    if [ "$analysis_mode" = denovo ]; then
        if [ "$route" = "." ]; then
            route_display="de novo transcriptome"
        else
            route_display="de novo $route (assembled transcriptome)"
        fi
        route_note="no-reference route: assembly plus Salmon quantification against assembled transcripts"
        case "$denovo_mapping_mode" in
            tx2gene) de_source_display="de novo tx2gene-derived counts" ;;
            cluster) de_source_display="de novo pseudo-gene counts" ;;
            *) de_source_display="de novo transcript counts" ;;
        esac
        de_source_note="count-like matrix built from assembled transcript quantification"
        salmon_note="mean estimated_num_reads across samples; in de novo mode these reads are quantified against the assembled transcriptome"
        if [ "$average_mapped_pct" = "." ]; then
            average_mapped_pct="N/A (de novo)"
            mapped_note="not applicable without reference genome alignment"
        fi
        if [ "$assigned_reads" = "." ]; then
            assigned_reads="N/A (de novo)"
            count_note="not applicable without reference genome feature counting"
        fi
        if [ "$qc_assigned_tags" = "." ]; then
            qc_assigned_tags="N/A (de novo)"
            qc_note="not applicable without reference genome alignment QC"
        fi
    fi

    {
        printf 'metric\tvalue\tnote\n'
        printf 'Analysis mode\t%s\treference-guided or de novo RNA-seq analysis mode\n' "$analysis_mode_display"
        printf 'Samples\t%s\tRNA-seq samples included in the run\n' "$samples"
        printf 'Route\t%s\t%s\n' "$route_display" "$route_note"
        printf 'DE source\t%s\t%s\n' "$de_source_display" "$de_source_note"
        printf 'Avg Salmon reads\t%s\t%s\n' "$average_salmon_reads" "$salmon_note"
        printf 'Avg mapped %%\t%s\t%s\n' "$average_mapped_pct" "$mapped_note"
        printf 'featureCounts assigned\t%s\t%s\n' "$assigned_reads" "$count_note"
        printf 'QC assigned tags\t%s\t%s\n' "$qc_assigned_tags" "$qc_note"
        printf 'Tested genes\t%s\tgenes retained for DESeq2 testing\n' "$tested_genes"
        printf 'Significant genes\t%s\tpadj and log2FC filtered DE genes\n' "$significant_genes"
        printf 'Up / down genes\t%s / %s\tdirection split among significant genes\n' "$up_genes" "$down_genes"
        printf 'ORA terms\t%s\tover-representation result rows\n' "$ora_terms"
        printf 'GSEA terms\t%s\tpreranked enrichment result rows\n' "$gsea_terms"
        if [ "$denovo_present" = yes ]; then
            printf 'De novo filtered transcripts\t%s\tassembled transcriptome after length filtering\n' "$denovo_filtered_transcripts"
            printf 'De novo N50\t%s\tfiltered de novo transcript N50\n' "$denovo_n50"
            printf 'De novo BUSCO\t%s\tBUSCO completeness step status when available\n' "$denovo_busco"
            printf 'De novo matrix semantics\t%s\ttranscript-level only unless explicit tx2gene or cluster mapping was supplied\n' "$denovo_matrix_semantics"
            printf 'De novo transcript rows\t%s\ttranscript-level expression feature rows\n' "$denovo_transcript_rows"
            printf 'Pseudo-gene rows\t%s\tgene or cluster rows from optional mapping\n' "$denovo_gene_rows"
            printf 'Annotated transcripts\t%s\ttranscripts with homology annotation evidence\n' "$denovo_annotated_transcripts"
            printf 'GO gene sets\t%s\tannotation-derived GMT gene sets available for enrichment\n' "$denovo_gene_sets"
        fi
        printf 'Collected plots\t%s\tPNG/PDF plot groups in this report\n' "$plots"
        printf 'Embedded tables\t%s\tcollected TSV/text table payloads embedded into the standalone main report\n' "$embedded_tables"
        printf 'Linked HTML reports\t%s\tcopied QC/report HTML bundles linked from this report\n' "$html_reports"
        printf 'Embedded HTML reports\t%s\tchild QC/report HTML payloads embedded into the standalone main report\n' "$embedded_html_reports"
    } > "$key_metrics_file"
}

write_project_summary() {
    {
        printf 'metric\tvalue\n'
        printf 'project_name\t%s\n' "$project_name"
        printf 'flow\t%s\n' "$FLOW_NAME"
        printf 'version\t%s\n' "$FLOW_VERSION"
        printf 'started_at\t%s\n' "$started_at"
        printf 'finished_at\t%s\n' "$finished_at"
        printf 'analysis_mode\t%s\n' "${analysis_mode:-unspecified}"
        printf 'standard_out\t%s\n' "${standard_out:-.}"
        printf 'standard_report_package\t%s\n' "$standard_report_package"
        printf 'denovo_present\t%s\n' "$denovo_present"
        printf 'denovo_assembly_out\t%s\n' "${denovo_assembly_out:-.}"
        printf 'denovo_expression_out\t%s\n' "${denovo_expression_out:-.}"
        printf 'denovo_annotation_out\t%s\n' "${denovo_annotation_out:-.}"
        printf 'provided_modules\t%s\n' "$module_count"
        printf 'collected_files\t%s\n' "$collected_count"
        printf 'collected_tables\t%s\n' "$copied_table_count"
        printf 'collected_plots\t%s\n' "$copied_plot_count"
        printf 'collected_html_reports\t%s\n' "$copied_html_count"
        printf 'embedded_html_reports\t%s\n' "$embedded_html_count"
        printf 'embedded_tables\t%s\n' "$(embedded_table_count_value)"
        printf 'report_template\t%s\n' "taffish-flow-report"
        printf 'report_template_version\t%s\n' "$FLOW_REPORT_TEMPLATE_VERSION"
        printf 'plot_groups\t%s\n' "$(row_count "$plot_gallery_file")"
        printf 'html_report_links\t%s\n' "$(row_count "$html_reports_file")"
    } > "$project_summary_file"
    cp "$project_summary_file" "$flow_summary_file"
}

write_interpretation_html() {
    escaped_project=$(html_escape "$project_name")
    {
        printf '<!doctype html>\n'
        printf '<html lang="en" data-lang="en" data-template="taffish-flow-report" data-template-version="%s">\n<head>\n' "$FLOW_REPORT_TEMPLATE_VERSION"
        printf '<meta charset="utf-8">\n'
        printf '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        printf '<title>%s - RNA-seq primer and interpretation guide</title>\n' "$escaped_project"
        printf '<style>\n'
cat <<'GUIDE_CSS'
.guide-shell,.guide-main,.wrap,.section,.grid,.card,.article,.article-grid,.mini-card,.table-wrap{min-width:0}.card strong,.card p,.article h3,.article h4,.article p,.article li,.mini-card strong,.mini-card p,.pill{overflow-wrap:anywhere}.table-wrap{max-width:100%}
:root{--ink:#13252d;--muted:#64757d;--line:#dbe6e7;--deep:#0a2d36;--teal:#087f74;--blue:#1d5fd7;--gold:#b7791f;--paper:#fff;--soft:#f5f8f7;--shadow:0 18px 50px rgba(14,45,54,.10)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#eef5f4;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;line-height:1.62}.lang-zh{display:none!important}html[data-lang="zh"] .lang-en{display:none!important}html[data-lang="zh"] .lang-zh{display:inline!important}html[data-lang="en"] .lang-en{display:inline!important}html[data-lang="en"] .lang-zh{display:none!important}.guide-shell{max-width:1540px;margin:0 auto;padding:18px;display:grid;grid-template-columns:292px minmax(0,1fr);gap:0}.guide-sidebar{position:sticky;top:18px;align-self:start;height:calc(100vh - 36px);overflow:auto;padding:22px 18px;border:1px solid var(--line);border-right:0;border-radius:8px 0 0 8px;background:linear-gradient(180deg,#fbfdfc 0,#f2f7f6 100%);box-shadow:var(--shadow)}.guide-main{min-width:0;border:1px solid var(--line);border-radius:0 8px 8px 0;background:#fff;box-shadow:var(--shadow)}.wrap{max-width:1160px;margin:0 auto;padding:24px}.nav-brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;margin-bottom:14px}.nav-brand img,.nav-brand-mark{width:44px;height:44px;border:1px solid var(--line);border-radius:8px;background:#fff;padding:4px;object-fit:contain}.nav-brand-mark{display:grid;place-items:center;background:var(--deep);color:#fff;font-weight:800;padding:0}.nav-brand b{display:block;letter-spacing:.08em}.nav-brand small{display:block;color:var(--muted);font-size:11px}.guide-nav{display:grid;gap:5px;margin-top:14px}.guide-nav a{display:block;color:#263940;text-decoration:none;border:1px solid transparent;border-radius:6px;padding:7px 9px;font-size:13px}.guide-nav a:hover{background:#edf5f4;border-color:var(--line)}.guide-nav a.active{background:#dff1ee;border-color:#9bd2ca;color:var(--deep);font-weight:700;box-shadow:inset 3px 0 0 var(--teal)}.nav-title{margin-top:14px;color:var(--teal);font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:11px}.top{background:linear-gradient(135deg,#fff 0,#f4f8f7 58%,#fff8ea 100%);border:1px solid var(--line);border-radius:8px;padding:28px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:12px;color:var(--ink);text-decoration:none}.brand img,.brand-mark{width:48px;height:48px;border:1px solid var(--line);border-radius:8px;background:#fff;padding:4px;object-fit:contain}.brand-mark{display:grid;place-items:center;background:var(--deep);color:#fff;font-weight:800;padding:0}.eyebrow{margin-top:18px;color:var(--teal);font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:12px}h1{font-size:34px;line-height:1.15;margin:10px 0 10px}h2{font-size:22px;margin:0 0 10px}h3{font-size:18px;margin:18px 0 8px}.intro{max-width:900px;color:#52666d}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.button,.language-switch button{border:0;border-radius:6px;background:var(--deep);color:#fff;text-decoration:none;font-weight:700;font-size:13px;padding:9px 12px;cursor:pointer}.language-switch{display:inline-flex;gap:4px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:4px}.language-switch button{background:transparent;color:var(--muted)}.language-switch button[aria-pressed="true"]{background:var(--deep);color:#fff}.section{background:#fff;border:1px solid var(--line);border-radius:8px;padding:24px;margin:14px 0;scroll-margin-top:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}.card,.article{border:1px solid var(--line);border-radius:8px;background:#fbfdfc;padding:15px}.card strong{display:block;margin-bottom:6px}.card p{margin:0;color:var(--muted);font-size:14px}.article{padding:22px;margin:16px 0;background:linear-gradient(180deg,#fff 0,#fbfdfc 100%)}.article h3{margin-top:0}.article h4{margin:18px 0 6px;color:var(--deep);font-size:15px}.article p{margin:8px 0;color:var(--muted)}.article ul{margin:8px 0 0 20px;color:var(--muted);padding:0}.article li{margin:4px 0}.article-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:10px;margin:12px 0}.mini-card{border:1px solid var(--line);border-radius:8px;background:#fff;padding:12px}.mini-card strong{display:block;margin-bottom:5px;color:var(--ink)}.mini-card p{font-size:13px;margin:0;color:var(--muted)}.pill-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.pill{border:1px solid var(--line);border-radius:999px;background:#fff;color:#52666d;font-size:12px;font-weight:700;padding:3px 8px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:8px;background:#fff}table{border-collapse:collapse;width:100%;font-size:14px}th,td{padding:9px 11px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:#f3f7f7}.callout{border:1px solid #efd2a2;background:#fff8ec;border-radius:8px;padding:15px;color:#65410b}.footer{color:var(--muted);font-size:13px;margin:18px 0}@media(max-width:980px){.guide-shell{display:block;padding:0}.guide-sidebar{position:relative;top:auto;height:auto;border-radius:0;border-left:0;border-right:0}.guide-main{border-left:0;border-right:0;border-radius:0}.guide-nav{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}.wrap{padding:0}.top,.section{border-radius:0;border-left:0;border-right:0;margin:0}.grid{grid-template-columns:1fr}h1{font-size:28px}}@media print{.guide-shell{display:block;padding:0}.guide-sidebar{position:relative;height:auto;border-radius:0;box-shadow:none}.guide-main{box-shadow:none;border:0}.language-switch{display:none}.section,.top{break-inside:avoid}}
GUIDE_CSS
        printf '</style>\n<script>\n'
cat <<'GUIDE_JS'
(function(){var root=document.documentElement,key="taffish-rnaseq-report-lang";function apply(lang){if(lang!=="zh")lang="en";root.setAttribute("data-lang",lang);root.setAttribute("lang",lang==="zh"?"zh-CN":"en");try{localStorage.setItem(key,lang)}catch(e){}var bs=document.querySelectorAll("[data-lang-toggle]");for(var i=0;i<bs.length;i++){var on=bs[i].getAttribute("data-lang-toggle")===lang;bs[i].setAttribute("aria-pressed",on?"true":"false")}}function spy(){var links=document.querySelectorAll(".guide-nav a[href^='#']");var sections=[];var map={};for(var i=0;i<links.length;i++){var id=links[i].getAttribute("href").slice(1);var el=document.getElementById(id);if(el){sections.push(el);map[id]=links[i]}}function active(id){for(var j=0;j<links.length;j++)links[j].classList.remove("active");if(map[id])map[id].classList.add("active")}if(!sections.length)return;if(!("IntersectionObserver" in window)){active(sections[0].id);return}var seen={};var io=new IntersectionObserver(function(entries){for(var k=0;k<entries.length;k++)seen[entries[k].target.id]=entries[k].isIntersecting?entries[k].intersectionRatio:0;var best=sections[0].id,score=-1;for(var m=0;m<sections.length;m++){var s=seen[sections[m].id]||0;if(s>score){score=s;best=sections[m].id}}active(best)},{rootMargin:"-18% 0px -68% 0px",threshold:[0,0.1,0.25,0.5,0.75,1]});for(var n=0;n<sections.length;n++)io.observe(sections[n])}function init(){var saved="en";try{saved=localStorage.getItem(key)||saved}catch(e){}apply(saved);var bs=document.querySelectorAll("[data-lang-toggle]");for(var i=0;i<bs.length;i++)bs[i].addEventListener("click",function(){apply(this.getAttribute("data-lang-toggle"))});spy()}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);else init()})();
GUIDE_JS
        printf '</script>\n</head><body><div class="guide-shell"><aside class="guide-sidebar">'
        printf '<a class="nav-brand" href="https://taffish.com" target="_blank" rel="noopener">'
        if [ -n "$logo_rel" ]; then
            printf '<img src="%s" alt="TAFFISH logo">' "$logo_rel"
        else
            printf '<span class="nav-brand-mark">TF</span>'
        fi
        printf '<span><b>TAFFISH</b><small>'; i18n "RNA-seq guide" "RNA-seq 指南"; printf '</small></span></a>'
        printf '<div class="language-switch"><button type="button" data-lang-toggle="en" aria-pressed="true">English</button><button type="button" data-lang-toggle="zh" aria-pressed="false">中文</button></div>'
        printf '<div class="nav-title">'; i18n "Contents" "目录"; printf '</div><nav class="guide-nav" aria-label="Interpretation guide contents">'
        printf '<a href="#primer">'; i18n "RNA-seq primer" "RNA-seq 入门"; printf '</a>'
        printf '<a href="#questions">'; i18n "Biological questions" "生物学问题"; printf '</a>'
        printf '<a href="#design">'; i18n "Experimental design" "实验设计"; printf '</a>'
        printf '<a href="#reading-order">'; i18n "Reading order" "阅读顺序"; printf '</a>'
        printf '<a href="#module-questions">'; i18n "Module questions" "模块问题"; printf '</a>'
        printf '<a href="#denovo-guide">'; i18n "De novo route" "无参路线"; printf '</a>'
        printf '<a href="#denovo-deep-dive">'; i18n "De novo deep dive" "无参深度解读"; printf '</a>'
        printf '<a href="#deep-dive">'; i18n "Deep-dive modules" "深度模块"; printf '</a>'
        printf '<a href="#deep-dive-expanded">'; i18n "Long-form chapters" "长文章节"; printf '</a>'
        printf '<a href="#plots">'; i18n "Plot reading" "图表阅读"; printf '</a>'
        printf '<a href="#statistics">'; i18n "Statistics glossary" "统计概念"; printf '</a>'
        printf '<a href="#faq">'; i18n "Beginner FAQ" "新手 FAQ"; printf '</a>'
        printf '<a href="#misread">'; i18n "Misinterpretations" "常见误读"; printf '</a>'
        printf '</nav></aside><main class="guide-main"><div class="wrap">\n'
        printf '<header class="top"><a class="brand" href="https://taffish.com" target="_blank" rel="noopener">'
        if [ -n "$logo_rel" ]; then
            printf '<img src="%s" alt="TAFFISH logo">' "$logo_rel"
        else
            printf '<span class="brand-mark">TF</span>'
        fi
        printf '<span><b>TAFFISH</b><br><small>'; i18n "RNA-seq primer and report interpretation guide" "RNA-seq 入门与报告解读指南"; printf '</small></span></a>\n'
        printf '<div class="eyebrow">'; i18n "How to read RNA-seq evidence" "如何阅读 RNA-seq 证据"; printf '</div><h1>'; i18n "RNA-seq Interpretation Guide" "RNA-seq 报告解读指南"; printf '</h1>\n'
        printf '<p class="intro"><span class="lang-en">This companion page is a compact RNA-seq primer as well as a report guide. It explains the biological question behind each step, the basic statistics used by the report, how to read common figures, and which interpretation boundaries should remain explicit when delivering results to collaborators or customers.</span><span class="lang-zh">这个配套页面既是报告导读，也是简明 RNA-seq 入门手册。它解释每一步背后的生物学问题、报告中常见的统计概念、常见图表的阅读方式，以及向协作者或客户交付结果时需要明确保留的解读边界。</span></p>\n'
        printf '<div class="actions"><a class="button" href="rnaseq_report.html">'; i18n "Back to main report" "返回主报告"; printf '</a></div></header>\n'

        printf '<section class="section" id="primer"><h2>'; i18n "RNA-seq Primer" "RNA-seq 入门"; printf '</h2><p class="intro"><span class="lang-en">Bulk RNA-seq measures the abundance of RNA molecules from a population of cells or tissue. In practice, the analysis asks a chain of increasingly biological questions: are the reads reliable, can they be assigned to genes or transcripts, are samples comparable, which genes changed, and do changed genes point to coherent biological processes?</span><span class="lang-zh">Bulk RNA-seq 测量一群细胞或组织中 RNA 分子的丰度。实际分析会沿着一串越来越接近生物学解释的问题推进：reads 是否可靠，能否分配到基因或转录本，样本之间是否可比，哪些基因发生变化，变化基因是否指向成体系的生物过程。</span></p><div class="grid">'
        printf '<div class="card"><strong>'; i18n "Reads are observations" "Reads 是观测"; printf '</strong><p>'; i18n "FASTQ files contain sequencing observations, not final gene expression. Quality, adapters, duplicated reads, and sample labels must be checked before biology." "FASTQ 文件包含测序观测，而不是最终基因表达。质量、接头、重复 reads 和样本标签都需要先检查。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Counts are evidence" "Counts 是证据"; printf '</strong><p>'; i18n "Counts summarize how many fragments support each gene or transcript. They are affected by library size, feature length, annotation, and quantification method." "Counts 总结每个基因或转录本获得多少片段支持，会受到文库大小、feature 长度、注释和定量方法影响。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Design gives meaning" "设计赋予意义"; printf '</strong><p>'; i18n "A contrast is meaningful only when sample metadata, biological replicates, condition labels, and possible batches are explicit." "只有样本 metadata、生物学重复、条件标签和潜在批次都明确时，一个 contrast 才有可靠意义。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Genes become hypotheses" "基因走向假设"; printf '</strong><p>'; i18n "DE and enrichment convert expression evidence into prioritized hypotheses for follow-up validation, not final proof." "差异表达和富集把表达证据转化为优先验证的假设，而不是最终证明。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="questions"><h2>'; i18n "From FASTQ to Biological Questions" "从 FASTQ 到生物学问题"; printf '</h2><div class="table-wrap"><table><thead><tr><th>'; i18n "Stage" "阶段"; printf '</th><th>'; i18n "What happens" "发生什么"; printf '</th><th>'; i18n "Question answered" "回答的问题"; printf '</th><th>'; i18n "What can go wrong" "常见风险"; printf '</th></tr></thead><tbody>'
        printf '<tr><td>FASTQ / QC</td><td>'; i18n "Inspect raw reads, adapters, quality profiles, and sample-level completeness." "检查原始 reads、接头、质量分布和样本完整性。"; printf '</td><td>'; i18n "Can these reads be trusted for downstream analysis?" "这些 reads 是否值得进入下游分析？"; printf '</td><td>'; i18n "Wrong sample label, low quality, adapter contamination, uneven read depth." "样本标签错误、低质量、接头污染、测序深度不均。"; printf '</td></tr>'
        printf '<tr><td>'; i18n "Quantification" "表达定量"; printf '</td><td>'; i18n "Assign fragments to transcripts or genes and produce counts/TPM matrices." "把片段分配到转录本或基因，生成 count/TPM 矩阵。"; printf '</td><td>'; i18n "How abundant is each transcript or gene in each sample?" "每个样本中各转录本或基因有多丰富？"; printf '</td><td>'; i18n "Reference mismatch, missing tx2gene mapping, low mapping/assignment rate." "参考不匹配、tx2gene 映射缺失、mapping/assignment rate 低。"; printf '</td></tr>'
        printf '<tr><td>'; i18n "Normalization" "归一化"; printf '</td><td>'; i18n "Adjust count-like values so samples become comparable under a statistical model." "调整 count-like 数值，使样本能在统计模型下比较。"; printf '</td><td>'; i18n "Are observed differences larger than library-size effects?" "观察到的差异是否超过文库大小等技术因素？"; printf '</td><td>'; i18n "Extreme composition bias, outliers, insufficient replicates." "极端组成偏倚、离群样本、重复数不足。"; printf '</td></tr>'
        printf '<tr><td>DE</td><td>'; i18n "Model counts against design variables and contrast conditions." "用设计变量和比较条件建模 count 数据。"; printf '</td><td>'; i18n "Which genes changed under this design?" "在该实验设计下哪些基因变化？"; printf '</td><td>'; i18n "Batch confounding, weak design, over-reading p-values." "批次混杂、设计不足、过度解读 p 值。"; printf '</td></tr>'
        printf '<tr><td>'; i18n "Enrichment" "功能富集"; printf '</td><td>'; i18n "Summarize DE genes or ranked genes as gene-set level signals." "把差异基因或排序基因概括为 gene set 层面信号。"; printf '</td><td>'; i18n "Which biological processes are plausible follow-up hypotheses?" "哪些生物过程是值得后续验证的假设？"; printf '</td><td>'; i18n "Wrong background, ID loss, broad terms, treating enrichment as mechanism proof." "背景基因集错误、ID 丢失、条目过宽、把富集当成机制证明。"; printf '</td></tr>'
        printf '</tbody></table></div></section>\n'

        printf '<section class="section" id="design"><h2>'; i18n "Experimental Design Basics" "实验设计基础"; printf '</h2><div class="grid">'
        printf '<div class="card"><strong>'; i18n "Biological replicate" "生物学重复"; printf '</strong><p>'; i18n "Independent biological samples from the same condition. They estimate natural variability and are essential for DE." "同一条件下彼此独立的生物样本，用于估计自然变异，是差异分析的基础。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Technical replicate" "技术重复"; printf '</strong><p>'; i18n "Repeated library prep or sequencing from the same biological material. Useful for technical noise, but not a substitute for biological replication." "同一生物材料的重复建库或测序，用于观察技术噪声，但不能替代生物学重复。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Condition" "条件"; printf '</strong><p>'; i18n "The biological group being compared, such as WT vs KO, control vs treatment, or time point." "被比较的生物学分组，例如 WT vs KO、control vs treatment 或不同时间点。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Batch" "批次"; printf '</strong><p>'; i18n "A technical grouping such as preparation date, lane, operator, or center. If batch tracks condition, interpretation becomes fragile." "建库日期、lane、操作者或中心等技术分组。如果 batch 和 condition 绑定，解释会变得脆弱。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Contrast" "比较"; printf '</strong><p>'; i18n "The exact comparison requested from the model, for example treated versus control. It must match the biological question." "模型中指定的精确比较，例如 treated versus control，必须和生物学问题一致。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "No contrast, no DE" "没有比较就没有 DE"; printf '</strong><p>'; i18n "A dataset with only one condition can produce expression matrices and QC, but not a condition-level differential expression test." "只有一个条件的数据可以生成表达矩阵和 QC，但不能做条件层面的差异表达检验。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="reading-order"><h2>'; i18n "Recommended Reading Order" "推荐阅读顺序"; printf '</h2><div class="grid">'
        printf '<div class="card"><strong>'; i18n "1. Start with overview metrics" "1. 先看总览指标"; printf '</strong><p>'; i18n "Confirm sample count, route, collected modules, plot count, and whether DE/enrichment outputs are present." "确认样本数、分析路线、已收集模块、图片数量，以及是否已有差异表达和富集结果。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "2. Check quality before biology" "2. 先质控再解读"; printf '</strong><p>'; i18n "Read QC, mapping quality, and sample relationships should be reviewed before interpreting changed genes." "在解释变化基因前，应先查看 reads 质量、比对质量和样本关系。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "3. Treat DE as statistical evidence" "3. 将差异表达视为统计证据"; printf '</strong><p>'; i18n "Volcano, MA, heatmap, and top-gene plots help prioritize genes, but they do not prove mechanism by themselves." "火山图、MA 图、热图和 Top 基因图帮助筛选候选基因，但它们本身不证明机制。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "4. Interpret enrichment cautiously" "4. 谨慎解释富集"; printf '</strong><p>'; i18n "ORA and GSEA summarize gene-set level signals; conclusions depend on gene IDs, background universe, and gene-set source." "ORA 和 GSEA 总结 gene set 层面的信号；结论依赖基因 ID、背景基因集和 gene set 来源。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="module-questions"><h2>'; i18n "Module Questions" "各模块回答的问题"; printf '</h2><div class="table-wrap"><table><thead><tr><th>'; i18n "Module" "模块"; printf '</th><th>'; i18n "Question" "回答的问题"; printf '</th><th>'; i18n "Main evidence" "主要证据"; printf '</th></tr></thead><tbody>'
        printf '<tr><td>Reference</td><td>'; i18n "Are genome, annotation, transcripts, and indexes ready for downstream analysis?" "基因组、注释、转录本和索引是否已准备好用于下游分析？"; printf '</td><td>'; i18n "reference summary, genome index, tx2gene" "reference summary、genome index、tx2gene"; printf '</td></tr>'
        printf '<tr><td>QC / Quantification</td><td>'; i18n "Are reads usable and do expression estimates look complete?" "reads 是否可用，表达定量是否完整？"; printf '</td><td>'; i18n "FastQC/MultiQC, Salmon summaries, count/TPM matrices" "FastQC/MultiQC、Salmon 摘要、count/TPM 矩阵"; printf '</td></tr>'
        printf '<tr><td>Alignment / Count QC</td><td>'; i18n "Do genome-aware BAM evidence and featureCounts results support the expression route?" "基因组比对证据和 featureCounts 结果是否支持表达路线？"; printf '</td><td>'; i18n "HISAT2 summaries, BAM tables, featureCounts, RSeQC, Qualimap" "HISAT2 摘要、BAM 表、featureCounts、RSeQC、Qualimap"; printf '</td></tr>'
        printf '<tr><td>De novo route</td><td>'; i18n "If no reference exists, what transcriptome was assembled, quantified, and annotated?" "没有参考时，组装、定量和注释的是哪一套转录本空间？"; printf '</td><td>'; i18n "assembly stats, transcript counts/TPM, matrix semantics, homology/GO evidence" "组装统计、转录本 counts/TPM、矩阵语义、同源/GO 证据"; printf '</td></tr>'
        printf '<tr><td>Differential expression</td><td>'; i18n "Which genes changed between conditions under the selected model and contrast?" "在选定模型和比较条件下，哪些基因发生变化？"; printf '</td><td>'; i18n "DESeq2 table, PCA, correlation, volcano, MA, heatmap" "DESeq2 表、PCA、相关性、火山图、MA 图、热图"; printf '</td></tr>'
        printf '<tr><td>Enrichment</td><td>'; i18n "Which biological processes or gene sets are over-represented or directionally enriched?" "哪些生物过程或 gene set 出现过度代表或方向性富集？"; printf '</td><td>'; i18n "ORA/GSEA tables, dotplots, barplot, NES plot, running curves" "ORA/GSEA 表、气泡图、柱状图、NES 图、running curves"; printf '</td></tr>'
        printf '</tbody></table></div></section>\n'

        printf '<section class="section" id="denovo-guide"><h2>'; i18n "De novo RNA-seq Route" "无参 RNA-seq 路线"; printf '</h2><p class="intro"><span class="lang-en">A no-reference RNA-seq report has a different evidence chain from a reference report. It first creates the transcript features from reads, then estimates expression on those assembled transcript IDs, and only then can it attach homology or GO evidence. The report must keep this feature-space boundary visible.</span><span class="lang-zh">无参 RNA-seq 报告的证据链与有参报告不同。它先从 reads 创建转录本 feature，再在这些组装 transcript ID 上估计表达，之后才可能附加同源或 GO 证据。报告必须始终保留这个 feature 空间边界。</span></p><div class="grid">'
        printf '<div class="card"><strong>'; i18n "Assembly is the reference substitute" "组装替代参考"; printf '</strong><p>'; i18n "The assembled transcript FASTA becomes the analysis vocabulary. N50, transcript count, read support, and BUSCO are checks on that vocabulary, not final biological conclusions." "组装得到的转录本 FASTA 成为分析词汇表。N50、转录本数量、read support 和 BUSCO 是对这套词汇表的检查，不是最终生物学结论。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Expression is transcript-first" "表达首先是转录本层面"; printf '</strong><p>'; i18n "Without annotation, transcript_counts.tsv and transcript_tpm.tsv describe assembled transcript features. Gene-like matrices require an explicit mapping or clustering step." "没有注释时，transcript_counts.tsv 和 transcript_tpm.tsv 描述的是组装 transcript feature。类似基因的矩阵需要显式映射或聚类。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Annotation is evidence transfer" "注释是证据转移"; printf '</strong><p>'; i18n "DIAMOND or similar homology hits suggest possible function depending on the database. They are not the same as curated reference gene identities." "DIAMOND 等同源命中根据数据库提示可能功能，但不等于人工 curated 的参考基因身份。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Enrichment is conditional" "富集是有条件的"; printf '</strong><p>'; i18n "ORA/GSEA needs a GMT and background in the same de novo transcript ID space as the DE list. Missing GO resources should be reported as unavailable, not hidden." "ORA/GSEA 需要与 DE 列表处于同一无参 transcript ID 空间的 GMT 和 background。缺少 GO 资源应报告为不可用，而不是隐藏。"; printf '</p></div>'
        printf '</div><div class="callout"><span class="lang-en">The safest wording is transcript-level evidence, pseudo-gene or cluster evidence when a mapping exists, and homolog-derived annotation when protein/GO resources were supplied.</span><span class="lang-zh">最稳妥的表述是：默认是转录本层面证据；存在映射时才是伪基因或聚类证据；提供蛋白/GO 资源时才是同源注释证据。</span></div></section>\n'

cat <<'GUIDE_DENOVO_EXPANDED' | sed 's/__LT__/</g; s/__GT__/>/g'
        __LT__section class="section" id="denovo-deep-dive"__GT____LT__h2__GT____LT__span class="lang-en"__GT__De Novo RNA-seq Deep Dive__LT__/span__GT____LT__span class="lang-zh"__GT__无参 RNA-seq 深度解读__LT__/span__GT____LT__/h2__GT____LT__p class="intro"__GT____LT__span class="lang-en"__GT__Reference-guided RNA-seq imports the feature space from a genome and annotation. De novo RNA-seq must infer that feature space from the reads before expression, differential testing, annotation, or enrichment can be interpreted. This is the central structural difference, and it should stay visible throughout the report.__LT__/span__GT____LT__span class="lang-zh"__GT__有参 RNA-seq 从基因组和注释中导入 feature 空间；无参 RNA-seq 必须先从 reads 推断出这套 feature 空间，之后表达定量、差异检验、注释和富集才有可解释对象。这是两条路线最核心的结构差异，报告中应始终让它可见。__LT__/span__GT____LT__/p__GT__

        __LT__div class="table-wrap"__GT____LT__table__GT____LT__thead__GT____LT__tr__GT____LT__th__GT____LT__span class="lang-en"__GT__Question__LT__/span__GT____LT__span class="lang-zh"__GT__问题__LT__/span__GT____LT__/th__GT____LT__th__GT____LT__span class="lang-en"__GT__Reference-guided route__LT__/span__GT____LT__span class="lang-zh"__GT__有参路线__LT__/span__GT____LT__/th__GT____LT__th__GT____LT__span class="lang-en"__GT__No-reference route__LT__/span__GT____LT__span class="lang-zh"__GT__无参路线__LT__/span__GT____LT__/th__GT____LT__th__GT____LT__span class="lang-en"__GT__Interpretation consequence__LT__/span__GT____LT__span class="lang-zh"__GT__解读后果__LT__/span__GT____LT__/th__GT____LT__/tr__GT____LT__/thead__GT____LT__tbody__GT__
        __LT__tr__GT____LT__td__GT____LT__span class="lang-en"__GT__What is the analyzed feature?__LT__/span__GT____LT__span class="lang-zh"__GT__被分析的 feature 是什么？__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Known genes or transcripts from a curated annotation.__LT__/span__GT____LT__span class="lang-zh"__GT__来自参考注释的已知基因或转录本。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Assembled transcript contigs, optionally grouped or mapped later.__LT__/span__GT____LT__span class="lang-zh"__GT__组装得到的 transcript contig，之后可选聚类或映射。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Do not call a row a known gene unless an explicit mapping supports that label.__LT__/span__GT____LT__span class="lang-zh"__GT__除非有显式映射支持，不要把矩阵行直接称为已知基因。__LT__/span__GT____LT__/td__GT____LT__/tr__GT__
        __LT__tr__GT____LT__td__GT____LT__span class="lang-en"__GT__What replaces the index?__LT__/span__GT____LT__span class="lang-zh"__GT__索引由什么构成？__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Genome or transcriptome index derived from the reference package.__LT__/span__GT____LT__span class="lang-zh"__GT__由参考包构建的基因组或转录组索引。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__A transcriptome assembled from project reads becomes the quantification reference.__LT__/span__GT____LT__span class="lang-zh"__GT__由项目 reads 组装出的 transcriptome 成为定量参考。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Assembly quality is upstream of every downstream biological statement.__LT__/span__GT____LT__span class="lang-zh"__GT__组装质量位于所有下游生物学表述之前。__LT__/span__GT____LT__/td__GT____LT__/tr__GT__
        __LT__tr__GT____LT__td__GT____LT__span class="lang-en"__GT__What does the count matrix mean?__LT__/span__GT____LT__span class="lang-zh"__GT__count 矩阵代表什么？__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Usually gene-level counts after transcript-to-gene summarization.__LT__/span__GT____LT__span class="lang-zh"__GT__通常是 transcript-to-gene 汇总后的基因层面 count。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Transcript-level counts by default; pseudo-gene or cluster counts only when recorded.__LT__/span__GT____LT__span class="lang-zh"__GT__默认是 transcript 层面 count；只有记录了映射时才是 pseudo-gene 或 cluster count。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Read matrix_semantics.tsv before interpreting DE rows.__LT__/span__GT____LT__span class="lang-zh"__GT__解释 DE 行之前应先读 matrix_semantics.tsv。__LT__/span__GT____LT__/td__GT____LT__/tr__GT__
        __LT__tr__GT____LT__td__GT____LT__span class="lang-en"__GT__How is function attached?__LT__/span__GT____LT__span class="lang-zh"__GT__功能如何附加？__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Function usually comes from the organism annotation and curated gene IDs.__LT__/span__GT____LT__span class="lang-zh"__GT__功能通常来自物种注释和 curated gene ID。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Function is transferred through ORF prediction, homology search, and GO or pathway mapping.__LT__/span__GT____LT__span class="lang-zh"__GT__功能通过 ORF 预测、同源搜索以及 GO 或通路映射转移而来。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__Annotation confidence depends on database, coverage, identity, e-value, and species distance.__LT__/span__GT____LT__span class="lang-zh"__GT__注释可信度取决于数据库、覆盖度、一致性、e-value 和物种距离。__LT__/span__GT____LT__/td__GT____LT__/tr__GT__
        __LT__tr__GT____LT__td__GT____LT__span class="lang-en"__GT__When is enrichment valid?__LT__/span__GT____LT__span class="lang-zh"__GT__富集什么时候有效？__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__When gene sets and background share the reference gene ID universe.__LT__/span__GT____LT__span class="lang-zh"__GT__当 gene set 和 background 共享参考基因 ID 空间时。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__When GMT and background were built in the same de novo feature space.__LT__/span__GT____LT__span class="lang-zh"__GT__当 GMT 和 background 在同一无参 feature 空间中构建时。__LT__/span__GT____LT__/td__GT____LT__td__GT____LT__span class="lang-en"__GT__If annotation-derived resources are missing, the honest result is unavailable enrichment.__LT__/span__GT____LT__span class="lang-zh"__GT__若缺少注释派生资源，诚实结果就是富集不可用。__LT__/span__GT____LT__/td__GT____LT__/tr__GT__
        __LT__/tbody__GT____LT__/table__GT____LT__/div__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Where the no-reference route diverges and rejoins__LT__/span__GT____LT__span class="lang-zh"__GT__无参路线在哪里分叉，又在哪里接回__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Both routes begin with FASTQ files and read-level QC, because the first question is always whether the observations are reliable. They diverge at the feature-definition step. A reference route uses an external genome and annotation; a de novo route builds a project transcriptome from the observed reads. They rejoin statistically only after the workflow has produced a count-like matrix whose row semantics are documented.__LT__/span__GT____LT__span class="lang-zh"__GT__两条路线都从 FASTQ 和 reads 质控开始，因为第一个问题永远是观测是否可靠。它们在 feature 定义步骤分叉：有参路线使用外部基因组和注释；无参路线从本项目 reads 构建转录组。只有当流程产生了 count-like 矩阵，并且矩阵行语义已经记录清楚后，它们才在统计分析层面重新接回。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__This is why a no-reference report should be read in a stricter order than a routine reference report: first inspect assembly completeness and fragmentation, then expression matrix semantics, then annotation coverage, then DE and enrichment. If this order is reversed, a reader may give gene-like biological meaning to rows that are still only assembled transcript IDs.__LT__/span__GT____LT__span class="lang-zh"__GT__因此无参报告比常规有参报告更需要严格阅读顺序：先看组装完整性和碎片化，再看表达矩阵语义，再看注释覆盖率，最后才看 DE 和 enrichment。如果反过来读，读者很容易把仍然只是 assembled transcript ID 的矩阵行赋予 gene-like 生物学意义。__LT__/span__GT____LT__/p__GT__
        __LT__div class="article-grid"__GT____LT__div class="mini-card"__GT____LT__strong__GT____LT__span class="lang-en"__GT__Shared before assembly__LT__/span__GT____LT__span class="lang-zh"__GT__组装前共享__LT__/span__GT____LT__/strong__GT____LT__p__GT____LT__span class="lang-en"__GT__sample metadata, FASTQ quality, read depth, adapter trimming, library consistency.__LT__/span__GT____LT__span class="lang-zh"__GT__样本 metadata、FASTQ 质量、reads 数量、接头修剪、文库一致性。__LT__/span__GT____LT__/p__GT____LT__/div__GT____LT__div class="mini-card"__GT____LT__strong__GT____LT__span class="lang-en"__GT__De novo-specific middle__LT__/span__GT____LT__span class="lang-zh"__GT__无参特异中段__LT__/span__GT____LT__/strong__GT____LT__p__GT____LT__span class="lang-en"__GT__assembly, transcript filtering, assembly QC, ORF prediction, homology search, annotation mapping.__LT__/span__GT____LT__span class="lang-zh"__GT__组装、转录本过滤、组装 QC、ORF 预测、同源搜索、注释映射。__LT__/span__GT____LT__/p__GT____LT__/div__GT____LT__div class="mini-card"__GT____LT__strong__GT____LT__span class="lang-en"__GT__Rejoined downstream layer__LT__/span__GT____LT__span class="lang-zh"__GT__下游重新接回__LT__/span__GT____LT__/strong__GT____LT__p__GT____LT__span class="lang-en"__GT__DE, expression distributions, sample relationships, enrichment, and final report once the feature-space contract is explicit.__LT__/span__GT____LT__span class="lang-zh"__GT__当 feature-space contract 明确后，DE、表达分布、样本关系、富集和最终报告可以复用下游表达解释层。__LT__/span__GT____LT__/p__GT____LT__/div__GT____LT__/div__GT__
        __LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Assembly QC: judging the vocabulary before reading the story__LT__/span__GT____LT__span class="lang-zh"__GT__组装 QC：读故事前先判断词汇表__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The assembled transcriptome is the vocabulary of a de novo analysis. N50, transcript count, total assembled bases, filtered transcript count, read-support summaries, and BUSCO completeness do not prove biological findings, but they describe whether the vocabulary is plausible enough for downstream interpretation.__LT__/span__GT____LT__span class="lang-zh"__GT__组装转录组是无参分析的词汇表。N50、transcript 数量、总组装碱基、过滤后 transcript 数、read-support 摘要和 BUSCO 完整性并不证明任何生物学发现，但它们描述这套词汇表是否足够合理，是否值得进入下游解释。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__N50 is useful but not a universal score. Larger is not always better. A high N50 can coexist with chimeric transcripts, while a low N50 can reflect short true transcripts, limited read depth, fragmented assembly, or aggressive filtering. Transcript count also needs context: too many transcripts can indicate fragmentation or isoform redundancy; too few can indicate under-assembly or over-filtering.__LT__/span__GT____LT__span class="lang-zh"__GT__N50 有用，但不是万能分数。越大不一定越好。很高的 N50 可能与嵌合 transcript 并存；很低的 N50 也可能来自真实短转录本、测序深度不足、组装碎片化或过滤过强。transcript 数量同样需要背景：过多可能提示碎片化或 isoform 冗余，过少可能提示组装不足或过滤过度。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__For non-model organisms, BUSCO is especially useful because it asks whether conserved single-copy genes expected for the selected lineage are present. But BUSCO still depends on lineage choice and cannot replace sample-specific biological judgment. A report should therefore present assembly metrics as evidence about feature-space reliability, not as a pass or fail badge.__LT__/span__GT____LT__span class="lang-zh"__GT__对于非模式物种，BUSCO 尤其有价值，因为它询问所选谱系中预期保守的单拷贝基因是否存在。但 BUSCO 仍依赖 lineage 选择，不能替代样本特异的生物学判断。因此报告应把组装指标展示为 feature 空间可靠性的证据，而不是简单的合格或不合格标签。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__N50__LT__/span__GT____LT__span class="pill"__GT__filtered transcripts__LT__/span__GT____LT__span class="pill"__GT__BUSCO__LT__/span__GT____LT__span class="pill"__GT__read support__LT__/span__GT____LT__span class="pill"__GT__fragmentation__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Expression semantics: transcript evidence is not automatically gene evidence__LT__/span__GT____LT__span class="lang-zh"__GT__表达语义：转录本证据不自动等于基因证据__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__In a no-reference workflow, Salmon or a similar quantifier estimates abundance against assembled transcript sequences. The primary matrix is therefore transcript-level unless the workflow explicitly creates and records a transcript-to-cluster, transcript-to-pseudo-gene, or transcript-to-reference mapping. The report should surface that decision rather than hiding it behind a generic count matrix label.__LT__/span__GT____LT__span class="lang-zh"__GT__在无参流程中，Salmon 或类似定量工具通常针对组装 transcript 序列估计丰度。因此原始矩阵默认是 transcript 层面，除非流程显式创建并记录 transcript-to-cluster、transcript-to-pseudo-gene 或 transcript-to-reference 映射。报告应该把这个决策展示出来，而不是用笼统的 count matrix 标签隐藏它。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Statistically, DESeq2 can model rows of a count-like matrix when there are replicates and an appropriate design. Biologically, the row label still matters. A significant assembled transcript may represent a full gene, one isoform, a fragment, a redundant isoform group, or an unannotated transcript. The safest downstream text should preserve the row semantic used by the matrix.__LT__/span__GT____LT__span class="lang-zh"__GT__从统计上说，只要有重复和合适设计，DESeq2 可以建模 count-like 矩阵的每一行。从生物学上说，行标签仍然重要。显著 assembled transcript 可能代表完整基因、某个 isoform、片段、冗余 isoform group 或未注释 transcript。最稳妥的下游文字应保留矩阵所使用的行语义。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__This is why the report should expose matrix_semantics.tsv, mapping summaries, transcript rows, pseudo-gene rows, and any ID mapping files. They tell readers whether the downstream DE and enrichment sections are transcript-first, pseudo-gene, cluster-based, or mapped-gene analyses.__LT__/span__GT____LT__span class="lang-zh"__GT__这就是报告需要展示 matrix_semantics.tsv、mapping summary、transcript rows、pseudo-gene rows 和 ID mapping 文件的原因。它们告诉读者后续 DE 与 enrichment 章节到底是 transcript-first、pseudo-gene、cluster-based 还是 mapped-gene 分析。__LT__/span__GT____LT__/p__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Annotation and enrichment: transferred biology, not guaranteed identity__LT__/span__GT____LT__span class="lang-zh"__GT__注释与富集：转移来的生物学，不是保证身份__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__No-reference annotation is an evidence-transfer step. ORF prediction proposes coding regions; homology search links them to known proteins; GO or pathway mapping transfers functional terms from matched records. The result can be extremely useful, but its confidence depends on the database, sequence coverage, percent identity, alignment score, e-value, and evolutionary distance.__LT__/span__GT____LT__span class="lang-zh"__GT__无参注释是一种证据转移。ORF 预测提出可能编码区；同源搜索把它们连接到已知蛋白；GO 或通路映射再从命中记录转移功能条目。这个结果非常有用，但可信度取决于数据库、序列覆盖度、一致性比例、比对分数、e-value 和进化距离。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Unannotated transcripts should not be dismissed as junk. They may be non-coding RNAs, species-specific transcripts, fragments, low-expression features, untranslated regions, or assembly artifacts. The report should separate two statements: whether a transcript has a known homolog, and whether it is biologically irrelevant. Those are not the same statement.__LT__/span__GT____LT__span class="lang-zh"__GT__未注释 transcript 不应直接被视为垃圾。它们可能是非编码 RNA、物种特异 transcript、片段、低表达 feature、非翻译区，也可能是组装伪影。报告应该区分两个问题：某个 transcript 是否有已知同源物，以及它是否生物学无关。这不是同一个判断。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Enrichment is valid only when the ranked or significant feature list, the GMT file, and the background universe use the same feature IDs. If annotation-derived GO sets cover only a subset of assembled transcripts, the enrichment result describes that annotated subset, not the complete transcriptome. This limitation should be visible next to ORA and GSEA plots.__LT__/span__GT____LT__span class="lang-zh"__GT__只有当排序或显著 feature 列表、GMT 文件和背景全集使用同一套 feature ID 时，富集才有效。如果注释派生 GO set 只覆盖组装 transcript 的一部分，富集结果描述的是这部分已注释子集，而不是完整转录组。这个限制应和 ORA/GSEA 图一起可见。__LT__/span__GT____LT__/p__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__How to write no-reference conclusions safely__LT__/span__GT____LT__span class="lang-zh"__GT__如何安全书写无参结论__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The safest writing pattern is to name the evidence layer explicitly. Say assembled transcripts when the matrix is transcript-level; say pseudo-gene or cluster when that mapping was built; say homolog-derived annotation when DIAMOND or a protein database supplied the label; say annotation-derived GO enrichment when gene sets were built from transferred GO terms.__LT__/span__GT____LT__span class="lang-zh"__GT__最安全的写法是明确指出证据层。矩阵是 transcript 层面时写 assembled transcripts；构建了映射时写 pseudo-gene 或 cluster；标签来自 DIAMOND 或蛋白数据库时写 homolog-derived annotation；gene set 来自转移 GO 时写 annotation-derived GO enrichment。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__For publication or high-stakes reporting, key findings should be validated against additional evidence when possible: a related species genome, long-read transcriptome, targeted PCR, qPCR, protein evidence, ortholog databases, or manually inspected alignments. The TAFFISH report can organize the computational evidence, but it should not overstate de novo labels as curated gene identities.__LT__/span__GT____LT__span class="lang-zh"__GT__对于发表或高风险交付，关键发现应尽可能用额外证据验证：近缘物种基因组、长读长转录组、靶向 PCR、qPCR、蛋白证据、ortholog 数据库或人工检查的比对结果。TAFFISH 报告可以组织计算证据，但不应把无参标签夸大为 curated gene identity。__LT__/span__GT____LT__/p__GT__
        __LT__div class="callout"__GT____LT__span class="lang-en"__GT__Practical rule: in no-reference mode, read assembly and matrix semantics before DE, and read annotation coverage before enrichment. This order protects the biological story from being stronger than the feature-space evidence.__LT__/span__GT____LT__span class="lang-zh"__GT__实用规则：无参模式下，先读 assembly 和 matrix semantics，再读 DE；先读 annotation coverage，再读 enrichment。这个顺序可以避免生物学故事强于 feature 空间证据。__LT__/span__GT____LT__/div__GT____LT__/article__GT____LT__/section__GT__
GUIDE_DENOVO_EXPANDED

cat <<'GUIDE_DEEP_DIVE' | sed 's/__LT__/</g; s/__GT__/>/g'
        __LT__section class="section" id="deep-dive"__GT____LT__h2__GT____LT__span class="lang-en"__GT__Deep-Dive Modules__LT__/span__GT____LT__span class="lang-zh"__GT__深度模块解读__LT__/span__GT____LT__/h2__GT____LT__p class="intro"__GT____LT__span class="lang-en"__GT__The same workflow can be read as a chain of biological translations. Each module turns one biological object into a more analyzable technical object: molecules become reads, reads become quantified features, features become modeled effects, and effects become hypotheses.__LT__/span__GT____LT__span class="lang-zh"__GT__同一套流程也可以理解为一条“生物学对象到技术证据”的翻译链：RNA 分子变成 reads，reads 变成可量化 feature，feature 进入统计模型，统计效应再变成可验证的生物学假设。__LT__/span__GT____LT__/p__GT__
        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Reference: biology becomes coordinates__LT__/span__GT____LT__span class="lang-zh"__GT__参考：把生物学对象变成坐标和 ID__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The reference step defines the vocabulary of the whole analysis. A genome FASTA provides coordinate space; GFF/GTF annotation defines genes, transcripts, exons, and parent-child relationships; transcript FASTA and tx2gene tables connect transcript-level evidence back to gene-level interpretation.__LT__/span__GT____LT__span class="lang-zh"__GT__参考构建定义了整个分析的词汇表。基因组 FASTA 提供坐标空间；GFF/GTF 注释定义基因、转录本、外显子和父子关系；转录本 FASTA 与 tx2gene 表则把转录本层面的证据重新连接回基因层面的解释。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Biologically, this is where names become analyzable entities. A gene symbol, systematic ID, transcript ID, and genomic locus are related but not interchangeable. If the genome and annotation come from different releases, reads can still map, but the biological meaning of counts, tx2gene aggregation, and enrichment background may drift.__LT__/span__GT____LT__span class="lang-zh"__GT__从生物学上说，这一步把“名字”变成可分析对象。gene symbol、systematic ID、transcript ID 和基因组坐标彼此相关，但不能随意混用。如果基因组和注释来自不同 release，reads 可能仍能比对，但 count、tx2gene 汇总和富集背景的生物学含义会发生漂移。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Technically, inspect reference summaries, transcript extraction, tx2gene, Salmon/Kallisto indexes, and optional HISAT2 indexes. The key question is not merely whether an index exists, but whether every downstream module speaks the same ID language.__LT__/span__GT____LT__span class="lang-zh"__GT__技术上需要查看 reference summary、转录本提取、tx2gene、Salmon/Kallisto 索引以及可选 HISAT2 索引。关键问题不只是“索引是否存在”，而是所有下游模块是否使用同一套 ID 语言。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__FASTA__LT__/span__GT____LT__span class="pill"__GT__GFF/GTF__LT__/span__GT____LT__span class="pill"__GT__tx2gene__LT__/span__GT____LT__span class="pill"__GT__Salmon/Kallisto index__LT__/span__GT____LT__span class="pill"__GT__HISAT2 index__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__FASTQ QC: observations before conclusions__LT__/span__GT____LT__span class="lang-zh"__GT__FASTQ 质控：先判断观测，再谈结论__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__FASTQ files are the raw observational layer. Each read is a sampled molecule fragment plus base-level uncertainty. Before asking which genes changed, the analysis must ask whether the observations are complete, labeled correctly, and technically reliable enough to support downstream inference.__LT__/span__GT____LT__span class="lang-zh"__GT__FASTQ 是原始观测层。每条 read 都是一个被采样的分子片段，加上碱基层面的不确定性。在追问哪些基因变化前，必须先问这些观测是否完整、标签是否正确、技术质量是否足够支持下游推断。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Quality profiles, adapter content, read length, GC behavior, duplication, and per-sample read depth are not cosmetic QC details. They describe whether library construction and sequencing produced comparable evidence across samples. A sample with very different read depth or quality can dominate PCA and distort apparent biology.__LT__/span__GT____LT__span class="lang-zh"__GT__质量分布、接头含量、read 长度、GC 行为、重复率和每个样本的 reads 数量并不是装饰性的 QC 指标。它们描述建库和测序是否为各样本产生了可比证据。一个测序深度或质量明显异常的样本，可能主导 PCA 并扭曲表观生物学差异。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__FastQC, fastp, and MultiQC are therefore the first biological sanity check. They do not prove a mechanism, but they protect the rest of the report from being interpreted as biology when the data are mostly technical artifacts.__LT__/span__GT____LT__span class="lang-zh"__GT__因此 FastQC、fastp 和 MultiQC 是第一层生物学合理性检查。它们不证明机制，但能避免把技术伪影误读为生物学差异。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__FastQC__LT__/span__GT____LT__span class="pill"__GT__fastp__LT__/span__GT____LT__span class="pill"__GT__MultiQC__LT__/span__GT____LT__span class="pill"__GT__read depth__LT__/span__GT____LT__span class="pill"__GT__adapter trimming__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Quantification: abundance is an estimate__LT__/span__GT____LT__span class="lang-zh"__GT__表达定量：丰度是估计值__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Expression quantification turns reads into transcript and gene abundance estimates. This is not a direct molecule counter. Ambiguous fragments, similar isoforms, transcript length, effective length, library size, and model assumptions all influence the final counts and TPM values.__LT__/span__GT____LT__span class="lang-zh"__GT__表达定量把 reads 转换成转录本和基因丰度估计。它不是直接的分子计数器。模糊片段、相似 isoform、转录本长度、有效长度、文库大小和模型假设都会影响最终 count 与 TPM。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Biologically, transcript-level quantification is useful because one gene can produce multiple isoforms, but gene-level interpretation is often more stable for routine reporting. tximport and tx2gene define how transcript evidence is summarized to genes; losing that mapping can silently remove genes from later DE and enrichment results.__LT__/span__GT____LT__span class="lang-zh"__GT__从生物学上说，转录本层面定量有价值，因为一个基因可以产生多个 isoform；但常规报告中基因层面的解释往往更稳健。tximport 和 tx2gene 决定转录本证据如何汇总到基因；如果映射丢失，某些基因会在后续差异和富集中悄悄消失。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Counts and TPM answer different questions. Counts are closer to statistical evidence for DE modeling; TPM is a normalized abundance scale that helps describe expression levels and compare patterns. Do not treat TPM, raw count, and normalized count as interchangeable units.__LT__/span__GT____LT__span class="lang-zh"__GT__Count 和 TPM 回答的问题不同。Count 更接近差异建模需要的统计证据；TPM 是归一化丰度尺度，适合描述表达水平和模式。不要把 TPM、raw count 和 normalized count 当成可互换单位。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__Salmon__LT__/span__GT____LT__span class="pill"__GT__Kallisto__LT__/span__GT____LT__span class="pill"__GT__tximport__LT__/span__GT____LT__span class="pill"__GT__counts__LT__/span__GT____LT__span class="pill"__GT__TPM__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Alignment branch: genome-aware evidence__LT__/span__GT____LT__span class="lang-zh"__GT__比对分支：基因组上下文证据__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The lightweight expression route can answer many expression questions, but genome-aware alignment adds a different evidence layer. BAM files preserve coordinates, splice junction behavior, strand information, coverage shape, and mapping quality in a way transcript quantification summaries do not.__LT__/span__GT____LT__span class="lang-zh"__GT__轻量表达路线已经能回答许多表达问题，但基因组比对提供了另一种证据层。BAM 文件保留坐标、剪接位点行为、链特异性、覆盖形态和比对质量，这些信息不是转录本定量摘要能完整表达的。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Biologically, this branch is useful when you care about annotation compatibility, gene body coverage, unexpected mapping patterns, intron/exon structure, strandedness, or whether reads support the expected transcript model. It can also help explain why a quantification result looks unusual.__LT__/span__GT____LT__span class="lang-zh"__GT__从生物学上看，当你关心注释兼容性、gene body coverage、异常比对模式、内含子/外显子结构、链特异性，或 reads 是否支持预期转录本模型时，这条分支很有用。它也能帮助解释某些异常定量结果。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The alignment branch is optional because it costs more time and storage. Its value is not that it replaces expression quantification, but that it adds auditable coordinate-level evidence for projects that need it.__LT__/span__GT____LT__span class="lang-zh"__GT__比对分支是可选的，因为它消耗更多时间和存储。它的价值不是替代表达定量，而是为需要更强审计证据的项目增加坐标层面的可追溯信息。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__HISAT2__LT__/span__GT____LT__span class="pill"__GT__BAM__LT__/span__GT____LT__span class="pill"__GT__splice junctions__LT__/span__GT____LT__span class="pill"__GT__strandness__LT__/span__GT____LT__span class="pill"__GT__coverage__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Counting: reads meet annotation__LT__/span__GT____LT__span class="lang-zh"__GT__计数：reads 与注释相遇__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Feature counting asks which aligned fragments overlap annotated genomic features. This step is deceptively simple: the answer depends on feature type, gene_id attributes, overlap rules, multimapping policy, strand settings, and how ambiguous reads are handled.__LT__/span__GT____LT__span class="lang-zh"__GT__Feature counting 询问已比对片段与哪些注释 feature 重叠。这个步骤看似简单，但结果取决于 feature type、gene_id 属性、overlap 规则、多重比对策略、链特异性设置和模糊 reads 的处理方式。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Biologically, gene-level counts are a summary of evidence assigned to annotated genes, not a complete picture of all transcription. Novel isoforms, antisense transcription, unannotated loci, and overlapping genes may be simplified or lost depending on the annotation and counting settings.__LT__/span__GT____LT__span class="lang-zh"__GT__从生物学上说，基因层面 count 是分配给已注释基因的证据摘要，并不等于所有转录活动的完整图景。新 isoform、反义转录、未注释位点和重叠基因可能因注释和计数设置而被简化或丢失。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Assignment summaries are therefore important. A low assigned-fragment fraction may indicate poor annotation match, wrong strandedness, contamination, reference mismatch, or a library type that does not fit the expected model.__LT__/span__GT____LT__span class="lang-zh"__GT__因此 assignment summary 很重要。较低的 assigned-fragment 比例可能提示注释不匹配、链特异性错误、污染、参考不一致，或文库类型不符合预期模型。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__featureCounts__LT__/span__GT____LT__span class="pill"__GT__gene_id__LT__/span__GT____LT__span class="pill"__GT__assignment rate__LT__/span__GT____LT__span class="pill"__GT__overlap rule__LT__/span__GT____LT__span class="pill"__GT__strand setting__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Differential expression: variation becomes a model__LT__/span__GT____LT__span class="lang-zh"__GT__差异表达：把变异放进模型__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Differential expression is where expression evidence is placed into an experimental design. The model separates condition effects from expected within-condition variability, then asks whether each gene shows a change that is large enough and stable enough to be unlikely under the null model.__LT__/span__GT____LT__span class="lang-zh"__GT__差异表达把表达证据放进实验设计中。模型把条件效应与组内自然变异区分开来，然后询问每个基因的变化是否足够大、足够稳定，以至于不太像零假设下的随机波动。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The biological unit here is not one sample versus another sample; it is a condition-level contrast supported by biological replicates. Without replicates, the model cannot estimate biological variability. With confounded batch, it may not know whether a difference is biological or technical.__LT__/span__GT____LT__span class="lang-zh"__GT__这里的生物学单位不是一个样本对另一个样本，而是由生物学重复支持的条件层面比较。没有重复，模型无法估计生物变异；如果 batch 混杂，模型也难以判断差异来自生物学还是技术因素。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__PCA, sample correlation, and distribution plots test whether the model is plausible. Volcano, MA, DEG-count, heatmap, and top-gene plots show the contrast signal. A strong DE result should make sense in both layers: sample-level structure and gene-level statistics.__LT__/span__GT____LT__span class="lang-zh"__GT__PCA、样本相关性和分布图用于检查模型前提是否合理。火山图、MA 图、DEG 数量图、热图和 Top gene 图展示比较信号。强的差异表达结果应该在两层证据上都说得通：样本层面结构合理，基因层面统计也成立。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__DESeq2__LT__/span__GT____LT__span class="pill"__GT__design__LT__/span__GT____LT__span class="pill"__GT__contrast__LT__/span__GT____LT__span class="pill"__GT__dispersion__LT__/span__GT____LT__span class="pill"__GT__FDR__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Enrichment: gene lists become biological hypotheses__LT__/span__GT____LT__span class="lang-zh"__GT__富集：从基因列表到生物学假设__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Enrichment analysis changes the unit of interpretation from individual genes to gene sets. This is useful because biological systems often move as coordinated programs: stress response, cell cycle, ribosome biogenesis, transport, metabolism, signaling, or development.__LT__/span__GT____LT__span class="lang-zh"__GT__富集分析把解释单位从单个基因转换成 gene set。这很有用，因为生物系统往往以协调程序的方式变化：应激反应、细胞周期、核糖体生成、物质转运、代谢、信号通路或发育过程。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__ORA and GSEA ask different statistical questions. ORA starts from a thresholded gene list and asks whether a set has too many hits. GSEA starts from a ranked list and asks whether set members accumulate toward the top or bottom. They can disagree because they emphasize different evidence structures.__LT__/span__GT____LT__span class="lang-zh"__GT__ORA 和 GSEA 的统计问题不同。ORA 从阈值筛出的基因列表出发，检验某个集合命中是否过多。GSEA 从完整排序列表出发，检验集合成员是否聚集在排序的一端。二者不同并不必然是错误，而是证据结构不同。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__The most important biological safeguards are gene ID consistency, background universe, gene-set source, term redundancy, and the actual hit genes. A beautiful dotplot is a starting point for interpretation, not the interpretation itself.__LT__/span__GT____LT__span class="lang-zh"__GT__最重要的生物学保护栏包括基因 ID 一致性、背景基因集、gene set 来源、term 冗余以及实际命中的基因。漂亮的气泡图只是解释的起点，不是解释本身。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__ORA__LT__/span__GT____LT__span class="pill"__GT__GSEA__LT__/span__GT____LT__span class="pill"__GT__gene universe__LT__/span__GT____LT__span class="pill"__GT__GMT__LT__/span__GT____LT__span class="pill"__GT__hit genes__LT__/span__GT____LT__/div__GT____LT__/article__GT__

        __LT__article class="article"__GT____LT__h3__GT____LT__span class="lang-en"__GT__Report and provenance: reproducibility is evidence__LT__/span__GT____LT__span class="lang-zh"__GT__报告与溯源：可复现性也是证据__LT__/span__GT____LT__/h3__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__A final RNA-seq report is not only a set of figures. It is a delivery object that should preserve what was run, which versions were used, which files were collected, where plots came from, and what methods can be cited or audited later.__LT__/span__GT____LT__span class="lang-zh"__GT__最终 RNA-seq 报告不只是若干图片。它是一个交付对象，应保存运行了什么、使用了哪些版本、收集了哪些文件、图片来自哪里，以及后续可引用或审计的方法记录。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__This is why report-flow keeps tables such as versions.tsv, commands.sh, methods.txt, plot_gallery.tsv, html_reports.tsv, tool_links.tsv, and run.manifest.json. These files make the HTML report inspectable by both humans and scripts.__LT__/span__GT____LT__span class="lang-zh"__GT__这就是 report-flow 保留 versions.tsv、commands.sh、methods.txt、plot_gallery.tsv、html_reports.tsv、tool_links.tsv 和 run.manifest.json 的原因。这些文件让 HTML 报告既能被人阅读，也能被脚本检查。__LT__/span__GT____LT__/p__GT__
        __LT__p__GT____LT__span class="lang-en"__GT__Reproducibility does not create biological truth by itself, but it makes disagreements traceable. When a collaborator asks why a term appeared, why a gene disappeared, or which tool produced a plot, the report should point to the relevant evidence instead of relying on memory.__LT__/span__GT____LT__span class="lang-zh"__GT__可复现性本身不创造生物学真相，但它让分歧可追踪。当协作者追问为什么出现某个 term、为什么某个基因消失、某张图由哪个工具生成时，报告应该能指向相应证据，而不是依赖记忆。__LT__/span__GT____LT__/p__GT__
        __LT__div class="pill-row"__GT____LT__span class="pill"__GT__versions.tsv__LT__/span__GT____LT__span class="pill"__GT__commands.sh__LT__/span__GT____LT__span class="pill"__GT__methods.txt__LT__/span__GT____LT__span class="pill"__GT__manifest__LT__/span__GT____LT__span class="pill"__GT__audit trail__LT__/span__GT____LT__/div__GT____LT__/article__GT____LT__/section__GT__
GUIDE_DEEP_DIVE

        printf '%s\n' '<section class="section" id="deep-dive-expanded"><h2><span class="lang-en">Long-Form Module Chapters</span><span class="lang-zh">长文模块章节</span></h2><p class="intro"><span class="lang-en">The chapters below expand the compact deep dives into a practical reading guide. Each chapter connects wet-lab origin, biological meaning, biological difficulty, technical difficulty, implementation, and report interpretation.</span><span class="lang-zh">下面的章节把上面的简明 deep dive 展开为更接近教程的阅读指南。每个章节都连接湿实验来源、生物学意义、生物学难点、技术难点、流程实现和报告解读方式。</span></p>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Reference preparation as the coordinate system of biology</span><span class="lang-zh">参考构建：生物学对象的坐标系统</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">The reference is not produced by this experiment, but it is the biological coordinate system against which the experiment is interpreted. The organism, strain, assembly, annotation release, and gene naming convention must match the actual sample source.</span><span class="lang-zh">参考并不是本次湿实验产生的样本数据，但它是解释本次实验的生物学坐标系统。物种、品系、组装版本、注释版本和基因命名体系必须和真实样本来源一致。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">A reference turns biological entities into analyzable features. Genes, transcripts, exons, introns, untranslated regions, and systematic identifiers become the objects that counts, TPM values, DE tests, and gene sets can refer to.</span><span class="lang-zh">参考把生物学实体变成可分析 feature。基因、转录本、外显子、内含子、非翻译区和系统 ID 变成 count、TPM、差异检验和 gene set 可以引用的对象。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">Real genomes contain isoforms, overlapping genes, paralogs, repetitive regions, annotation gaps, and ID changes across releases. The same gene may appear under a symbol, systematic ID, transcript ID, or locus name.</span><span class="lang-zh">真实基因组包含 isoform、重叠基因、旁系同源基因、重复区域、注释缺口和跨版本 ID 变化。同一个基因可能以 symbol、systematic ID、transcript ID 或 locus 名称出现。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">FASTA sequence names must match GFF/GTF seqids; transcript extraction must preserve parent-child structure; tx2gene must use the same IDs as quantification; enrichment background must use the same gene universe.</span><span class="lang-zh">FASTA 序列名必须匹配 GFF/GTF 的 seqid；转录本提取必须保留父子结构；tx2gene 必须和定量结果使用同一 ID；富集背景必须和表达基因空间一致。</span></p></div></div><p><span class="lang-en">In this workflow family, the index flow standardizes annotation, extracts transcripts, writes tx2gene, and builds transcriptome or genome indexes. In the report, this module should be read before all biological conclusions. If reference and annotation disagree, downstream values may be numerically valid but biologically mislabelled.</span><span class="lang-zh">在这套流程中，index flow 会标准化注释、提取转录本、写出 tx2gene，并构建转录组或基因组索引。在报告中，这一模块应该先于所有生物学结论阅读。如果参考和注释不一致，下游数值可能仍然有效，但生物学标签可能已经错位。</span></p><p><span class="lang-en">A practical reviewer should ask whether the genome and annotation come from the same release, whether chromosome names match, whether the gene identifiers match the expected organism database, and whether the same ID system appears in DE and enrichment outputs.</span><span class="lang-zh">实际审阅时应确认 genome 与 annotation 是否同 release，染色体名称是否一致，基因 ID 是否匹配预期数据库，以及 DE 和 enrichment 输出中是否仍然使用同一套 ID 系统。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">FASTQ QC as evidence triage before biology</span><span class="lang-zh">FASTQ 质控：生物学解释前的证据分诊</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">FASTQ quality reflects RNA extraction, RNA integrity, library construction, adapter ligation, size selection, amplification, sequencing chemistry, lane allocation, and sample demultiplexing.</span><span class="lang-zh">FASTQ 质量反映 RNA 提取、RNA 完整性、建库、接头连接、片段筛选、扩增、测序化学、lane 分配和样本拆分等湿实验与测序环节。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">RNA-seq observes fragments sampled from a biological RNA population. If the observation process is biased or incomplete, downstream expression differences can reflect sampling and library behavior rather than biology.</span><span class="lang-zh">RNA-seq 观测的是从生物 RNA 群体中采样得到的片段。如果观测过程有偏或不完整，下游表达差异可能反映采样和建库行为，而不是生物学变化。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">RNA degradation, different tissue composition, stress during handling, rRNA carryover, or unequal library complexity can all create sample-level structure that looks biological but has a technical origin.</span><span class="lang-zh">RNA 降解、组织组成差异、处理过程应激、rRNA 残留或文库复杂度不均，都可能制造看似生物学、实际技术来源的样本结构。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">Quality scores, adapter profiles, duplication, per-base GC, sequence length, and read depth must be compared at sample level. A single outlier can influence normalization, PCA, and DE.</span><span class="lang-zh">质量分数、接头分布、重复率、逐碱基 GC、序列长度和 reads 数量都必须在样本层面比较。单个离群样本就可能影响归一化、PCA 和 DE。</span></p></div></div><p><span class="lang-en">The expression flow uses read-level QC and trimming before quantification. In the report, FastQC and MultiQC links are not decorative appendices. They explain whether the raw observations deserve biological interpretation. The best practice is to inspect them before volcano plots, enrichment terms, or any gene-level story.</span><span class="lang-zh">expression flow 在定量前执行 reads 层面的 QC 和修剪。报告中的 FastQC 与 MultiQC 链接不是装饰性附录，而是解释原始观测是否值得进入生物学解读的证据。最佳阅读顺序是先看这些 QC，再看火山图、富集条目或基因故事。</span></p><p><span class="lang-en">Good QC does not prove the biological conclusion, but poor QC changes the strength of every downstream conclusion. If trimming removes a large fraction of reads, if one sample has much lower depth, or if quality profiles differ by condition, those facts should be carried into the final interpretation.</span><span class="lang-zh">好的 QC 不证明生物学结论，但差的 QC 会改变所有下游结论的强度。如果修剪去掉大量 reads、某个样本测序深度显著偏低，或质量分布按 condition 分组，这些事实必须进入最终解释。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Quantification as a model of molecular abundance</span><span class="lang-zh">表达定量：对分子丰度的建模</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">Quantification inherits fragment length distribution, library strandedness, sequencing depth, and transcript composition from library preparation and sequencing. It is therefore a computational model of a wet-lab product.</span><span class="lang-zh">定量继承了建库和测序产生的片段长度分布、链特异性、测序深度和转录本组成。因此它是对湿实验产物的计算建模。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">The question is how abundant each transcript or gene appears in each sample. This supports expression matrices, sample relationships, and later condition-level modeling.</span><span class="lang-zh">这里的问题是每个样本中每个转录本或基因看起来有多丰富。它支撑表达矩阵、样本关系和后续条件层面建模。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">Genes can have multiple isoforms, paralogs can share sequence, and short reads may not uniquely identify transcripts. A gene-level result can hide isoform-specific biology.</span><span class="lang-zh">基因可以有多个 isoform，旁系同源基因可能共享序列，短 reads 也未必能唯一识别转录本。基因层面结果可能掩盖 isoform 特异生物学。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">Effective length correction, multimapping, fragment assignment, transcript-to-gene summarization, and sample scaling all affect the final matrix. Count, TPM, and normalized count are different quantities.</span><span class="lang-zh">有效长度校正、多重匹配、片段分配、转录本到基因汇总和样本尺度校正都会影响最终矩阵。count、TPM 和 normalized count 是不同量。</span></p></div></div><p><span class="lang-en">In the TAFFISH RNA-seq standard route, Salmon-first quantification is the default lightweight evidence path. It is fast and appropriate for expression-matrix delivery, single-condition projects, and standard DE input. The report should make clear which matrix is gene count, which is TPM, and which downstream module consumed it.</span><span class="lang-zh">在 TAFFISH RNA-seq 标准路线中，Salmon-first 定量是默认轻量证据路径。它速度快，适合表达矩阵交付、单条件项目和标准 DE 输入。报告应清楚说明哪个矩阵是 gene count、哪个是 TPM、哪个下游模块使用了它。</span></p><p><span class="lang-en">Interpretation should avoid the common mistake of treating high expression as differential expression. A highly expressed housekeeping gene may be stable across conditions, while a moderate expression regulator can show a strong condition effect. Quantification describes abundance; DE asks whether abundance changes relative to variability.</span><span class="lang-zh">解读时要避免把高表达误认为差异表达。一个高表达 housekeeping gene 可能在条件间很稳定，而一个中等表达调控基因可能有强烈条件效应。定量描述丰度；DE 询问丰度是否相对变异发生变化。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Alignment and counting as coordinate-level confirmation</span><span class="lang-zh">比对与计数：坐标层面的确认</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">Alignment signals reflect read length, library strandedness, fragment distribution, RNA integrity, contamination, and whether the sequenced material matches the reference organism and annotation.</span><span class="lang-zh">比对信号反映 read 长度、文库链特异性、片段分布、RNA 完整性、污染情况，以及测序材料是否匹配参考物种和注释。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">Genome-aware alignment asks whether reads support expected genomic loci, exon structure, splice junctions, and gene body coverage. Counting asks how many aligned fragments overlap annotated genes.</span><span class="lang-zh">基因组比对询问 reads 是否支持预期基因组位点、外显子结构、剪接位点和 gene body coverage。计数则询问多少已比对片段重叠到注释基因。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">Alternative splicing, antisense transcription, overlapping genes, unannotated transcripts, and repetitive regions can all complicate coordinate-level interpretation.</span><span class="lang-zh">可变剪接、反义转录、重叠基因、未注释转录本和重复区域都会让坐标层面解释变复杂。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">The BAM evidence depends on splice-aware alignment, sorted/indexed files, feature type, gene_id attributes, multimapping policy, overlap rules, and strandness settings.</span><span class="lang-zh">BAM 证据依赖剪接感知比对、排序和索引文件、feature type、gene_id 属性、多重比对策略、overlap 规则和链特异性设置。</span></p></div></div><p><span class="lang-en">The optional alignment/count/QC branch is not meant to replace transcript quantification. It adds an audit layer. When expression results look surprising, BAM-level summaries, featureCounts assignment, RSeQC, and Qualimap can reveal whether the surprise is compatible with genome-level evidence.</span><span class="lang-zh">可选 alignment/count/QC 分支不是为了替代表达定量，而是增加审计层。当表达结果令人意外时，BAM 摘要、featureCounts assignment、RSeQC 和 Qualimap 可以帮助判断这种意外是否与基因组层面证据一致。</span></p><p><span class="lang-en">For report reading, mapping rate alone is not enough. A project reviewer should check assigned fragments, strandedness evidence, gene body coverage, sample consistency, and whether the optional branch agrees with the Salmon-first expression route at the level of sample relationships and major signals.</span><span class="lang-zh">读报告时不能只看 mapping rate。审阅者还应查看 assigned fragments、链特异性证据、gene body coverage、样本一致性，以及可选分支是否在样本关系和主要信号上支持 Salmon-first 表达路线。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Differential expression as design-aware inference</span><span class="lang-zh">差异表达：带实验设计的推断</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">DE depends on how samples were collected, randomized, blocked, processed, and labelled. Biological replicate, condition, batch, sex, time point, tissue, treatment, and operator are wet-lab facts before they are model variables.</span><span class="lang-zh">DE 依赖样本如何采集、随机化、分组、处理和标记。生物学重复、condition、batch、性别、时间点、组织、处理和操作者，先是湿实验事实，之后才是模型变量。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">DE asks whether expression changes are associated with a biological condition after accounting for within-condition variability and the selected design.</span><span class="lang-zh">DE 询问在考虑组内变异和选定设计后，表达变化是否与某个生物学条件相关。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">Small sample size, hidden heterogeneity, condition-batch confounding, strong outliers, and mixed cell populations can all make a condition effect hard to interpret.</span><span class="lang-zh">样本数少、隐藏异质性、condition 与 batch 混杂、强离群样本和混合细胞群体都会让条件效应难以解释。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">DE requires count-like input, size-factor normalization, dispersion estimation, design formulas, contrast specification, multiple-testing correction, and careful plot interpretation.</span><span class="lang-zh">DE 需要 count-like 输入、size factor 归一化、离散度估计、design formula、contrast 指定、多重检验校正和谨慎图表解读。</span></p></div></div><p><span class="lang-en">In the report, PCA and correlation plots should be read before volcano and enrichment. They ask whether the samples behave in a way that makes the model credible. Volcano, MA, DEG counts, heatmap, and top-gene expression then describe the contrast-level signal.</span><span class="lang-zh">在报告中，PCA 和相关性图应该先于火山图和富集阅读。它们询问样本行为是否让模型可信。随后火山图、MA 图、DEG 数量、热图和 Top gene 表达图才描述 contrast 层面的信号。</span></p><p><span class="lang-en">A good DE interpretation does not stop at a list of significant genes. It checks whether the direction is biologically plausible, whether replicate variation is acceptable, whether important genes have adequate expression, whether adjusted p-values survive multiple testing, and whether the chosen log2FC threshold matches the project question.</span><span class="lang-zh">好的 DE 解读不会停在显著基因列表。它还会检查方向是否生物学合理、重复间变异是否可接受、关键基因表达是否足够、校正 p 值是否经得住多重检验，以及 log2FC 阈值是否匹配项目问题。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Enrichment as a bridge from genes to processes</span><span class="lang-zh">富集：从基因走向过程的桥梁</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">Enrichment does not come from a new wet-lab assay. It inherits the experimental design, sample quality, gene-level statistics, and organism annotation from earlier steps.</span><span class="lang-zh">富集不是新的湿实验检测。它继承前面步骤中的实验设计、样本质量、基因层面统计和物种注释。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">It asks whether gene-level changes form interpretable biological programs such as stress response, transport, metabolism, ribosome biogenesis, cell cycle, or signaling.</span><span class="lang-zh">它询问基因层面的变化是否组成可解释的生物学程序，例如应激反应、转运、代谢、核糖体生成、细胞周期或信号通路。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological difficulty</span><span class="lang-zh">生物学难点</span></strong><p><span class="lang-en">GO terms overlap, pathways are incomplete, term names can be broad, and a gene can belong to many sets. A term label is a hypothesis summary, not a mechanism proof.</span><span class="lang-zh">GO term 互相重叠，通路并不完整，term 名称可能很宽泛，一个基因也可属于多个集合。term 标签是候选假设摘要，不是机制证明。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">ORA depends on significant-gene threshold and background universe. GSEA depends on the ranking statistic. Both depend on ID mapping and gene-set source.</span><span class="lang-zh">ORA 依赖显著基因阈值和背景基因集；GSEA 依赖排序统计量。二者都依赖 ID 映射和 gene set 来源。</span></p></div></div><p><span class="lang-en">The report should place enrichment after DE because enrichment is a second-order interpretation. It explains patterns in gene evidence. The readable dotplot, original-style dotplot, ORA barplot, GSEA NES plot, and running-score curves are different windows into the same gene-set question.</span><span class="lang-zh">报告应该把富集放在 DE 之后，因为富集是二阶解释。它解释基因证据中的模式。可读气泡图、经典气泡图、ORA 柱状图、GSEA NES 图和 running-score 曲线，是观察同一 gene-set 问题的不同窗口。</span></p><p><span class="lang-en">A mature enrichment interpretation names not only the top terms but also the hit genes, the direction of the effect, the redundancy among terms, and the biological context in which the process matters. It should be written as a hypothesis for follow-up validation.</span><span class="lang-zh">成熟的富集解释不只列出 top terms，还会说明 hit genes、效应方向、term 冗余和该过程发生作用的生物学背景。它应该被写成后续验证的假设。</span></p></article>'
        printf '%s\n' '<article class="article"><h3><span class="lang-en">Report and provenance as the memory of the analysis</span><span class="lang-zh">报告与溯源：分析的记忆系统</span></h3><div class="article-grid"><div class="mini-card"><strong><span class="lang-en">Wet-lab origin</span><span class="lang-zh">湿实验来源</span></strong><p><span class="lang-en">The report should preserve sample naming and project context so that lab notes, sequencing files, metadata, and computational outputs remain connected.</span><span class="lang-zh">报告应保存样本命名和项目上下文，让实验记录、测序文件、metadata 和计算输出保持连接。</span></p></div><div class="mini-card"><strong><span class="lang-en">Biological meaning</span><span class="lang-zh">生物学意义</span></strong><p><span class="lang-en">A biological conclusion is only useful if another person can trace which data, tools, parameters, and intermediate evidence produced it.</span><span class="lang-zh">只有别人能追踪到结论来自哪些数据、工具、参数和中间证据，生物学结论才真正可用。</span></p></div><div class="mini-card"><strong><span class="lang-en">Technical difficulty</span><span class="lang-zh">技术难点</span></strong><p><span class="lang-en">Static reports need working relative links, copied plot assets, linked HTML bundles, version rows, command logs, methods text, and manifest records without rerunning upstream analysis.</span><span class="lang-zh">静态报告需要保持相对链接、复制图像资产、链接 HTML bundle、版本记录、命令日志、方法文本和 manifest，同时不能重新运行上游分析。</span></p></div><div class="mini-card"><strong><span class="lang-en">Reading method</span><span class="lang-zh">阅读方法</span></strong><p><span class="lang-en">Use the main report for project results and this interpretation guide for conceptual reading. Use TSV indexes and manifest files when auditing or reusing outputs.</span><span class="lang-zh">主报告用于查看项目结果，本解读页用于理解概念。审计或复用结果时，应查看 TSV 索引和 manifest 文件。</span></p></div></div><p><span class="lang-en">In TAFFISH, report-flow remains a static collector. That boundary is important: the report does not silently change upstream results. It organizes them, links them, explains them, and records provenance. If the report and an upstream table disagree, the upstream table is the source to inspect.</span><span class="lang-zh">在 TAFFISH 中，report-flow 仍然是静态汇总器。这个边界很重要：报告不会悄悄改变上游结果。它组织、链接、解释并记录溯源。如果报告和上游表格不一致，应优先检查上游表格来源。</span></p><p><span class="lang-en">This turns the report into a reusable delivery package: collaborators can read the HTML, analysts can inspect tables, and future maintainers can recover commands, versions, and file provenance. That is why reproducibility is not only an engineering feature; it is part of the biological evidence chain.</span><span class="lang-zh">这让报告成为可复用的交付包：协作者能读 HTML，分析人员能检查表格，未来维护者能恢复命令、版本和文件来源。因此可复现性不只是工程特性，也是生物学证据链的一部分。</span></p></article></section>'

        printf '<section class="section" id="plots"><h2>'; i18n "Plot Reading Notes" "图表阅读提示"; printf '</h2><div class="grid">'
        printf '<div class="card"><strong>PCA / '; i18n "sample correlation" "样本相关性"; printf '</strong><p>'; i18n "Use these to spot sample grouping, replicate consistency, outliers, and possible batch structure." "用于查看样本分组、重复一致性、离群样本和可能的批次结构。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Expression distributions" "表达分布"; printf '</strong><p>'; i18n "Large distribution shifts can indicate normalization, library-size, or sample-quality issues." "明显的分布偏移可能提示归一化、文库大小或样本质量问题。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Volcano / MA" "火山图 / MA 图"; printf '</strong><p>'; i18n "These summarize effect size and uncertainty; prioritize genes with both meaningful fold change and adjusted significance." "这些图总结效应量和不确定性；优先关注兼具明显倍数变化和校正显著性的基因。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Heatmap / top genes" "热图 / Top 基因"; printf '</strong><p>'; i18n "These help inspect expression patterns, but gene selection and scaling affect the visual impression." "这些图帮助查看表达模式，但基因选择和缩放方式会影响视觉印象。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "ORA dotplot / barplot" "ORA 气泡图 / 柱状图"; printf '</strong><p>'; i18n "ORA starts from a significant-gene list and is sensitive to thresholds and background genes." "ORA 从显著基因列表出发，对阈值和背景基因集敏感。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "GSEA NES / curves" "GSEA NES / 曲线"; printf '</strong><p>'; i18n "GSEA uses the full ranked list, so it can reveal coordinated directional signals without a hard cutoff." "GSEA 使用完整排序基因列表，因此可发现不依赖硬阈值的协调方向性信号。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="statistics"><h2>'; i18n "Statistics Glossary" "统计概念速查"; printf '</h2><div class="table-wrap"><table><thead><tr><th>'; i18n "Term" "术语"; printf '</th><th>'; i18n "Plain-language meaning" "直观含义"; printf '</th><th>'; i18n "Interpretation note" "解读提示"; printf '</th></tr></thead><tbody>'
        printf '<tr><td>count</td><td>'; i18n "Fragment support for a gene or transcript." "支持某个基因或转录本的片段数量。"; printf '</td><td>'; i18n "Best for statistical modeling after proper normalization; not directly comparable across genes of different length." "适合归一化后建模；不同长度基因之间不宜直接比较。"; printf '</td></tr>'
        printf '<tr><td>TPM</td><td>'; i18n "Expression abundance normalized for transcript length and library size." "考虑转录本长度和文库大小后的表达丰度。"; printf '</td><td>'; i18n "Useful for within-sample abundance display; DE testing usually uses count-like evidence." "适合样本内表达展示；差异检验通常使用 count-like 证据。"; printf '</td></tr>'
        printf '<tr><td>normalized count</td><td>'; i18n "Count adjusted for sample-level scaling factors." "按样本尺度因子调整后的 count。"; printf '</td><td>'; i18n "Useful for plots and comparability under the selected model." "适合绘图和模型内样本比较。"; printf '</td></tr>'
        printf '<tr><td>log2FC</td><td>'; i18n "Log2 fold change between contrast groups." "比较组之间的 log2 倍数变化。"; printf '</td><td>'; i18n "Direction and magnitude matter; tiny effects can be significant in large datasets." "方向和幅度都重要；大样本中很小的效应也可能显著。"; printf '</td></tr>'
        printf '<tr><td>p-value</td><td>'; i18n "Evidence against the null model for one test." "单个检验中反对零假设的证据。"; printf '</td><td>'; i18n "Thousands of genes are tested, so raw p-values are not enough." "RNA-seq 同时检验成千上万个基因，原始 p 值不够。"; printf '</td></tr>'
        printf '<tr><td>padj / FDR</td><td>'; i18n "Multiple-testing adjusted significance." "多重检验校正后的显著性。"; printf '</td><td>'; i18n "Controls expected false discoveries under assumptions; it is not biological validation." "在假设下控制预期假阳性；不等于生物学验证。"; printf '</td></tr>'
        printf '<tr><td>PCA</td><td>'; i18n "A low-dimensional summary of sample-level variation." "样本层面变异的低维摘要。"; printf '</td><td>'; i18n "Useful for outliers, batches, and group structure; axes are not individual genes." "适合看离群、批次和分组结构；坐标轴不是单个基因。"; printf '</td></tr>'
        printf '<tr><td>NES</td><td>'; i18n "GSEA normalized enrichment score." "GSEA 的标准化富集分数。"; printf '</td><td>'; i18n "Sign indicates direction; magnitude summarizes gene-set level coordinated signal." "符号表示方向，大小概括 gene set 层面协调信号。"; printf '</td></tr>'
        printf '</tbody></table></div></section>\n'

        printf '<section class="section" id="faq"><h2>'; i18n "Beginner FAQ" "新手 FAQ"; printf '</h2><div class="grid">'
        printf '<div class="card"><strong>'; i18n "Can three WT samples produce an expression matrix?" "只有 3 个 WT 能生成表达矩阵吗？"; printf '</strong><p>'; i18n "Yes. With a reference and sample table, quantification/QC can produce count and TPM matrices. Condition-level DE requires at least two biological conditions." "可以。只要有参考和样本表，定量/QC 可以生成 count 和 TPM 矩阵。条件层面的差异分析需要至少两个生物学条件。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Why do some genes disappear?" "为什么有些基因消失了？"; printf '</strong><p>'; i18n "Low-count filtering, ID mapping, annotation scope, and background filtering can remove genes from downstream tables." "低表达过滤、ID 映射、注释范围和背景过滤都可能让基因不进入下游表格。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Why do ORA and GSEA differ?" "为什么 ORA 和 GSEA 不一样？"; printf '</strong><p>'; i18n "ORA uses a thresholded significant-gene list, while GSEA uses a full ranked list. They answer related but different questions." "ORA 使用阈值筛出的显著基因列表，GSEA 使用完整排序列表；二者回答相关但不同的问题。"; printf '</p></div>'
        printf '<div class="card"><strong>'; i18n "Can the report write the final biological story?" "报告能自动写最终生物学故事吗？"; printf '</strong><p>'; i18n "No. The report organizes evidence and highlights risks. Final interpretation needs experiment context, literature, and expert review." "不能。报告组织证据并提示风险；最终解释需要实验背景、文献和领域专家审阅。"; printf '</p></div>'
        printf '</div></section>\n'

        printf '<section class="section" id="misread"><h2>'; i18n "Common Misinterpretations" "常见误读"; printf '</h2><div class="callout"><span class="lang-en">A significant gene is not automatically a validated biomarker; an enriched term is not a proven mechanism; a clean-looking plot does not remove the need to check experimental design, batch effects, metadata, and biological plausibility.</span><span class="lang-zh">显著差异基因不自动等于已验证生物标志物；富集条目不等于机制已经被证明；图形看起来整齐也不能替代对实验设计、批次效应、metadata 和生物学合理性的检查。</span></div></section>\n'
        printf '<p class="footer">'; i18n "Generated by rnaseq-report-flow as an offline companion page to the main project report." "由 rnaseq-report-flow 生成，作为主项目报告的离线配套解读页面。"; printf '</p></div></main></div></body></html>\n'
    } > "$interpretation_html"
}

write_report_html() {
    escaped_project=$(html_escape "$project_name")
    de_results="$de_out/03_results/de/results.tsv"
    ora_results="$enrichment_out/03_results/enrichment/ora_results.tsv"
    gsea_results="$enrichment_out/03_results/enrichment/gsea_results.tsv"
    de_summary="$de_out/04_reports/de_summary.tsv"
    enrichment_summary="$enrichment_out/03_results/enrichment/enrichment_summary.tsv"
    standard_summary="$standard_out/04_reports/flow_summary.tsv"
    denovo_assembly_summary=""
    denovo_assembly_stats=""
    denovo_busco_summary=""
    denovo_expression_summary=""
    denovo_matrix_semantics=""
    denovo_annotation_summary=""
    denovo_annotation_table=""
    if [ -n "$denovo_assembly_out" ]; then
        denovo_assembly_summary="$denovo_assembly_out/04_reports/flow_summary.tsv"
        denovo_assembly_stats="$denovo_assembly_out/03_results/assembly_qc/assembly_stats.tsv"
        denovo_busco_summary="$denovo_assembly_out/03_results/assembly_qc/busco_summary.tsv"
    fi
    if [ -n "$denovo_expression_out" ]; then
        denovo_expression_summary="$denovo_expression_out/04_reports/expression_summary.tsv"
        denovo_matrix_semantics="$denovo_expression_out/04_reports/matrix_semantics.tsv"
    fi
    if [ -n "$denovo_annotation_out" ]; then
        denovo_annotation_summary="$denovo_annotation_out/04_reports/annotation_summary.tsv"
        denovo_annotation_table="$denovo_annotation_out/03_results/annotation/transcript_annotation.tsv"
    fi
    {
        printf '<!doctype html>\n'
        printf '<html lang="en" data-lang="en" data-template="taffish-flow-report" data-template-version="%s">\n<head>\n' "$FLOW_REPORT_TEMPLATE_VERSION"
        printf '<meta charset="utf-8">\n'
        printf '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        printf '<title>%s - RNA-seq report</title>\n' "$escaped_project"
        printf '<style>\n'
cat <<'REPORT_CSS'
.shell,.page,.content,.section,.section-head,.metric-grid,.metric,.route,.step,.report-grid,.report-link,.report-link>div,.plot-grid,.plot-card,.table-wrap,.twocol,.twocol>*,.subsection-card,.workflow-map,.flow-node,.mini-diagram,.deliverable-grid,.deliverable-card{min-width:0}body .metric-grid{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}body .metric strong{font-size:clamp(18px,1.7vw,25px);line-height:1.28}.metric strong,.metric small,.step strong,.step span,.report-link strong,.report-link small,.plot-card figcaption,.plot-card figcaption strong,.plot-note,.badge,.pill,.flow-node strong,.flow-node>span,.deliverable-card strong,.deliverable-card p,.section-copy,.module-note{overflow-wrap:anywhere}.table-wrap{max-width:100%}.table-wrap th,.table-wrap td{white-space:nowrap}.plot-card figcaption,.report-link{flex-wrap:wrap}.plot-grid{grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr))}
:root{color-scheme:light;--ink:#13252d;--muted:#64757d;--line:#dbe6e7;--paper:#ffffff;--soft:#f5f8f7;--deep:#0a2d36;--teal:#087f74;--blue:#1d5fd7;--gold:#b7791f;--rose:#be123c;--shadow:0 18px 50px rgba(14,45,54,.10)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#eef5f4 0,#f7f9f8 260px,#edf2f3 100%);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;line-height:1.55}.lang-zh{display:none!important}html[data-lang="zh"] .lang-en{display:none!important}html[data-lang="zh"] .lang-zh{display:inline!important}html[data-lang="en"] .lang-en{display:inline!important}html[data-lang="en"] .lang-zh{display:none!important}.shell{max-width:1580px;margin:0 auto;padding:18px}.page{display:grid;grid-template-columns:292px minmax(0,1fr);min-height:calc(100vh - 36px);background:rgba(255,255,255,.86);border:1px solid rgba(197,213,216,.82);border-radius:8px;box-shadow:var(--shadow);overflow:visible}.sidebar{position:sticky;top:18px;align-self:start;height:calc(100vh - 36px);max-height:calc(100vh - 36px);overflow:auto;overscroll-behavior:contain;padding:24px 20px;border-right:1px solid var(--line);background:linear-gradient(180deg,#fbfdfc 0,#f2f7f6 100%);border-radius:8px 0 0 8px;display:flex;flex-direction:column;gap:18px}.brand{display:flex;gap:12px;align-items:center;text-decoration:none;color:var(--ink)}.brand img,.brand-mark{width:52px;height:52px;flex:0 0 auto;border-radius:8px;background:#fff;border:1px solid var(--line);padding:4px;object-fit:contain}.brand-mark{padding:0;background:var(--deep);color:#fff;display:grid;place-items:center;font-weight:800;letter-spacing:.04em}.brand b{display:block;font-size:18px;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.language-switch{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border:1px solid var(--line);border-radius:8px;background:#fff}.language-switch button{border:0;border-radius:6px;background:transparent;color:var(--muted);font:600 12px/1.2 inherit;padding:8px 10px;cursor:pointer}.language-switch button[aria-pressed="true"]{background:var(--deep);color:#fff}.side-links{display:grid;gap:6px}.side-links a,.nav-group summary{color:#263940;text-decoration:none;border:1px solid transparent;padding:8px 10px;border-radius:6px;font-size:13px}.nav-group summary{cursor:pointer;font-weight:800;list-style-position:inside}.nav-sub{display:grid;gap:3px;margin:4px 0 7px 12px;padding-left:8px;border-left:1px solid var(--line)}.side-links .nav-child{padding-left:18px;color:var(--muted);font-size:12px}.side-links a:hover,.nav-group summary:hover{background:#edf5f4;border-color:var(--line);color:var(--deep)}.external{margin-top:auto;display:grid;gap:8px;padding-top:16px;border-top:1px solid var(--line)}.external a{color:var(--blue);font-size:13px;text-decoration:none}.content{min-width:0;background:#fff;border-radius:0 8px 8px 0;overflow:hidden}.hero{padding:44px 54px 34px;border-bottom:1px solid var(--line);background:linear-gradient(135deg,#ffffff 0,#f4f8f7 54%,#fff8ea 100%)}.hero-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;flex-wrap:wrap}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:var(--teal);font-weight:800}.hero h1{font-size:39px;line-height:1.12;margin:12px 0 12px;letter-spacing:0;max-width:920px}.hero p{max-width:920px;color:#53656d;font-size:16px}.hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.badge{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(10,45,54,.14);background:rgba(255,255,255,.78);border-radius:999px;padding:7px 11px;color:#34444d;font-size:12px}.section{padding:36px 54px;border-bottom:1px solid var(--line);background:#fff}.section:nth-of-type(even){background:#fbfcfc}.section-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:20px}.section h2{font-size:24px;line-height:1.25;margin:0;letter-spacing:0}.section-intro{max-width:820px;color:var(--muted);margin:7px 0 0}.kicker{display:block;color:var(--teal);font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;margin-bottom:6px}h3{font-size:16px;margin:28px 0 12px;letter-spacing:0}.muted{color:var(--muted)}.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.metric{border:1px solid var(--line);border-radius:8px;padding:16px;background:#fff;box-shadow:0 8px 26px rgba(15,45,52,.05)}.metric>span{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}.metric strong{display:block;font-size:25px;margin:5px 0;color:var(--deep)}.metric small{display:block;color:var(--muted);font-size:12px;min-height:2.8em}.route{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}.step{border:1px solid var(--line);border-left:4px solid var(--teal);background:linear-gradient(180deg,#fff 0,#f4f9f8 100%);padding:12px;border-radius:8px;font-size:13px}.step strong{display:block;font-size:14px}.report-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(275px,1fr));gap:12px}.report-link{display:flex;justify-content:space-between;gap:14px;align-items:center;border:1px solid var(--line);border-radius:8px;padding:14px;background:#fff}.report-link .report-type{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--teal);font-weight:700}.report-link strong{display:block;font-size:14px;margin:3px 0}.report-link small{display:block;color:var(--muted);font-size:11px;word-break:break-all}.report-link a,.button-link{background:var(--deep);color:#fff;text-decoration:none;border-radius:6px;padding:7px 10px;font-size:12px;white-space:nowrap}.plot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:18px}.plot-card{margin:0;border:1px solid var(--line);border-radius:8px;background:#fff;overflow:hidden;box-shadow:0 10px 28px rgba(15,45,52,.06)}.plot-card img{display:block;width:100%;height:auto;background:#fff}.plot-card figcaption{display:flex;gap:10px;justify-content:space-between;align-items:center;padding:11px 13px;border-top:1px solid var(--line);font-size:13px}.plot-card a{color:var(--blue);text-decoration:none}.plot-note{margin:0;padding:0 13px 13px;color:var(--muted);font-size:12px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:8px;background:#fff}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}th{background:#f3f7f7;font-weight:700;white-space:nowrap}td{word-break:normal}code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:#26343b;word-break:break-all}.pill{display:inline-block;background:#e6f4f2;color:var(--teal);padding:2px 7px;border-radius:999px;font-size:12px}.callout{border:1px solid #efd2a2;background:#fff8ec;border-radius:8px;padding:15px;color:#65410b}.twocol{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}.footer-note{font-size:12px;color:var(--muted);margin-top:18px}.report-footer{margin:0;padding:22px 54px;border-top:1px solid var(--line);background:#fbfcfc;color:var(--muted);font-size:12px}.section h2,.hero h1{word-break:normal}.table-wrap+small{display:block;margin-top:6px}@media(max-width:980px){.shell{padding:0}.page{grid-template-columns:1fr;border-radius:0;border-left:0;border-right:0}.sidebar{position:relative;top:auto;height:auto;max-height:none;overflow:visible;border-radius:0;border-right:0;border-bottom:1px solid var(--line)}.content{border-radius:0}.side-links{grid-template-columns:repeat(auto-fit,minmax(132px,1fr))}.external{margin-top:8px}.hero,.section,.report-footer{padding-left:24px;padding-right:24px}.hero h1{font-size:30px}.twocol{grid-template-columns:1fr}.plot-grid{grid-template-columns:1fr}}@media print{body{background:#fff}.shell{padding:0}.page{display:block;border:0;box-shadow:none}.sidebar{position:relative;top:auto;height:auto;max-height:none;overflow:visible;border-radius:0;border-right:0;border-bottom:1px solid var(--line)}.content{border-radius:0;overflow:visible}.language-switch{display:none}.section,.hero{break-inside:avoid}}
section[id]{scroll-margin-top:24px}.side-links a.active{background:#dff1ee;border-color:#9bd2ca;color:var(--deep);font-weight:700;box-shadow:inset 3px 0 0 var(--teal)}.workflow-map{display:flex;align-items:stretch;gap:8px;margin:18px 0 10px;padding:14px;border:1px solid var(--line);border-radius:8px;background:linear-gradient(135deg,#ffffff 0,#f5faf9 100%);overflow:auto}.flow-node{min-width:126px;flex:1 0 126px;border:1px solid rgba(8,127,116,.28);border-radius:8px;background:#fff;padding:11px 12px;box-shadow:0 6px 18px rgba(15,45,52,.05)}.flow-node strong{display:block;font-size:13px;color:var(--deep)}.flow-node>span{display:block;margin-top:3px;font-size:11px;color:var(--muted)}.flow-node.primary{border-color:rgba(8,127,116,.58);background:#eef9f7}.flow-node.optional{border-color:#e3c078;background:#fff8ea}.flow-node.result{border-color:#aac5ef;background:#eef5ff}.flow-arrow{display:flex;align-items:center;justify-content:center;color:var(--teal);font-weight:800;min-width:22px}.module-note{margin:6px 0 20px;color:var(--muted);font-size:13px}.mini-diagram{display:flex;gap:8px;align-items:stretch;flex-wrap:wrap;margin:12px 0 18px}.mini-diagram .flow-node{flex:1 1 150px;min-width:150px}.deliverable-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin:16px 0}.deliverable-card{border:1px solid var(--line);border-radius:8px;background:#fff;padding:14px;box-shadow:0 8px 22px rgba(15,45,52,.05)}.deliverable-card strong{display:block;margin-bottom:6px}.deliverable-card p{margin:0;color:var(--muted);font-size:13px}.tree{border:1px solid var(--line);border-radius:8px;background:#0e232b;color:#e9fbf8;padding:16px;overflow:auto;font-size:12px;line-height:1.55}.section-copy{max-width:960px;color:#4d6068;margin:0 0 18px}.subsection-card{border:1px solid var(--line);border-radius:8px;background:#fff;padding:16px;margin:18px 0}.subsection-card h3{margin-top:0}.plot-grid.compact{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.html-open-note{font-size:12px;color:var(--muted);margin:10px 0 0}.report-link a:after,.plot-card figcaption a:after,.external a:after{content:"";display:inline-block;width:6px;height:6px;margin-left:5px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:translateY(-1px) rotate(45deg)}@media(max-width:980px){.workflow-map{flex-direction:column}.flow-arrow{min-height:10px;transform:rotate(90deg)}.deliverable-grid{grid-template-columns:1fr}.mini-diagram{display:grid;grid-template-columns:1fr}.mini-diagram .flow-node{min-width:0}.side-links a.active{box-shadow:inset 0 -3px 0 var(--teal)}}@media print{.side-links a.active{box-shadow:none}.workflow-map{break-inside:avoid}.report-link a:after,.plot-card figcaption a:after,.external a:after{display:none}}
