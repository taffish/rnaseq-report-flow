cat <<'REPORT_CSS_FIXES'
.embedded-table-grid{align-items:stretch}.embedded-table-link{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:14px;min-height:154px}.embedded-table-link .table-link-body{display:grid;gap:5px;width:100%}.embedded-table-link .table-link-body strong{line-height:1.25}.embedded-table-link .table-link-body small{display:block;line-height:1.35;overflow-wrap:anywhere;word-break:break-word}.embedded-table-link a{align-self:flex-start;margin-top:auto}
