ARGS
<(--expression-out)expression-out>
<(--alignment-out)alignment-out>
<(--count-out)count-out>
<(--alignment-qc-out)alignment-qc-out>
<(--de-out)de-out>
<(--enrichment-out)enrichment-out>
<!(--outdir/-o)outdir>
<(--project-name)project-name>
  RNA-seq project

RUN
<taffish>
set -eu

FLOW_NAME="rnaseq-report-flow"
FLOW_VERSION="0.1.0-r1"

expression_arg="::(--expression-out)expression-out::"
alignment_arg="::(--alignment-out)alignment-out::"
count_arg="::(--count-out)count-out::"
alignment_qc_arg="::(--alignment-qc-out)alignment-qc-out::"
de_arg="::(--de-out)de-out::"
enrichment_arg="::(--enrichment-out)enrichment-out::"
outdir_arg="::!(--outdir/-o)outdir::"
project_name="::project-name::"
force_arg="::(--force)force?::"

flow_log=""
collected_count=0
copied_table_count=0
copied_plot_count=0
module_count=0

log() {
    printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >&2
    if [ -n "$flow_log" ]; then
        printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >> "$flow_log"
    fi
}

fail() {
    log "ERROR: $*"
    exit 1
}

sq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

json_string() {
    printf '%s' "$1" | awk '
        BEGIN {
            ORS = ""
            bs = sprintf("%c", 92)
            dq = sprintf("%c", 34)
            tabc = sprintf("%c", 9)
            cr = sprintf("%c", 13)
            printf dq
        }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == bs) {
                    printf "%s%s", bs, bs
                } else if (c == dq) {
                    printf "%s%s", bs, dq
                } else if (c == tabc) {
                    printf "%st", bs
                } else if (c == cr) {
                    printf "%sr", bs
                } else {
                    printf "%s", c
                }
            }
        }
        END {
            printf dq
        }
    '
}

html_escape() {
    printf '%s' "$1" | awk '
        BEGIN { ORS = "" }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == "&") printf "\\&amp;"
                else if (c == "<") printf "\\&lt;"
                else if (c == ">") printf "\\&gt;"
                else if (c == "\"") printf "\\&quot;"
                else printf "%s", c
            }
        }
    '
}

resolve_path() {
    path_value=$1
    base_dir=$2
    case "$path_value" in
        /*) printf '%s\n' "$path_value" ;;
        *) printf '%s/%s\n' "$base_dir" "$path_value" ;;
    esac
}

is_true() {
    case "$1" in
        T|t|true|TRUE|True|1|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

safe_name() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'
}

file_size() {
    wc -c < "$1" | awk '{ print $1 + 0 }'
}

append_upstream_versions() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        awk -F '\t' -v OFS='\t' -v module="$module" '
            NR == 1 { next }
            NF >= 2 {
                source = (NF >= 3 ? $3 : "upstream report")
                print $1, $2, module ":" source
            }
        ' "$source_file" >> "$versions_file"
    fi
}

append_upstream_methods() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        {
            printf '\n## Upstream module: %s\n\n' "$module"
            cat "$source_file"
            printf '\n'
        } >> "$methods_file"
    fi
}

append_upstream_commands() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        {
            printf '\n# ----- Upstream module: %s -----\n' "$module"
            cat "$source_file"
            printf '\n# ----- End upstream module: %s -----\n' "$module"
        } >> "$commands_file"
    fi
}

register_module() {
    module=$1
    path_value=$2
    [ -n "$path_value" ] || return 0
    [ -d "$path_value" ] || fail "--${module}-out is not a directory: $path_value"
    module_count=$((module_count + 1))
    printf '%s\t%s\tprovided\n' "$module" "$path_value" >> "$upstream_outputs_file"
}

collect_file() {
    module=$1
    role=$2
    source_file=$3
    kind=$4
    [ -s "$source_file" ] || return 0
    base=$(basename "$source_file")
    local_name="$(safe_name "$module").$(safe_name "$role").$(safe_name "$base")"
    case "$kind" in
        plot) dest_dir="$collected_plots_dir"; copied_plot_count=$((copied_plot_count + 1)) ;;
        *) dest_dir="$collected_tables_dir"; copied_table_count=$((copied_table_count + 1)) ;;
    esac
    dest_file="$dest_dir/$local_name"
    cp "$source_file" "$dest_file"
    size=$(file_size "$dest_file")
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$module" "$role" "$source_file" "$dest_file" "$kind" "$size" >> "$collected_files_file"
    collected_count=$((collected_count + 1))
}

collect_module_common() {
    module=$1
    module_dir=$2
    collect_file "$module" "flow_summary" "$module_dir/04_reports/flow_summary.tsv" "table"
    collect_file "$module" "methods" "$module_dir/04_reports/methods.txt" "table"
    collect_file "$module" "manifest" "$module_dir/run.manifest.json" "table"
    append_upstream_versions "$module" "$module_dir/04_reports/versions.tsv"
    append_upstream_methods "$module" "$module_dir/04_reports/methods.txt"
    append_upstream_commands "$module" "$module_dir/04_reports/commands.sh"
}

collect_expression() {
    module_dir=$1
    collect_module_common "expression" "$module_dir"
    collect_file "expression" "summary" "$module_dir/04_reports/expression_summary.tsv" "table"
    collect_file "expression" "quant_files" "$module_dir/04_reports/quant_files.tsv" "table"
    collect_file "expression" "gene_counts" "$module_dir/03_results/matrices/gene_counts.tsv" "table"
    collect_file "expression" "gene_tpm" "$module_dir/03_results/matrices/gene_tpm.tsv" "table"
    collect_file "expression" "transcript_counts" "$module_dir/03_results/matrices/transcript_counts.tsv" "table"
    collect_file "expression" "transcript_tpm" "$module_dir/03_results/matrices/transcript_tpm.tsv" "table"
}

collect_alignment() {
    module_dir=$1
    collect_module_common "alignment" "$module_dir"
    collect_file "alignment" "summary" "$module_dir/03_results/alignment_summary.tsv" "table"
    collect_file "alignment" "bam_files" "$module_dir/04_reports/bam_files.tsv" "table"
}

collect_count() {
    module_dir=$1
    collect_module_common "count" "$module_dir"
    collect_file "count" "summary" "$module_dir/04_reports/count_summary.tsv" "table"
    collect_file "count" "gene_counts" "$module_dir/03_results/matrices/gene_counts.tsv" "table"
    collect_file "count" "assignment_summary" "$module_dir/03_results/assignment_summary.tsv" "table"
}

collect_alignment_qc() {
    module_dir=$1
    collect_module_common "alignment_qc" "$module_dir"
    collect_file "alignment_qc" "summary" "$module_dir/03_results/rnaseq_qc_summary.tsv" "table"
    collect_file "alignment_qc" "report_summary" "$module_dir/04_reports/rnaseq_qc_summary.tsv" "table"
}

collect_de() {
    module_dir=$1
    collect_module_common "de" "$module_dir"
    collect_file "de" "summary" "$module_dir/04_reports/de_summary.tsv" "table"
    collect_file "de" "contrasts" "$module_dir/04_reports/contrasts.tsv" "table"
    collect_file "de" "results" "$module_dir/03_results/de/results.tsv" "table"
    collect_file "de" "results_shrunken" "$module_dir/03_results/de/results_shrunken.tsv" "table"
    collect_file "de" "significant_genes" "$module_dir/03_results/gene_lists/significant_genes.tsv" "table"
    collect_file "de" "ranked_genes" "$module_dir/03_results/gene_lists/ranked_genes.tsv" "table"
    collect_file "de" "pca_plot" "$module_dir/03_results/plots/pca_plot.pdf" "plot"
    collect_file "de" "ma_plot" "$module_dir/03_results/plots/ma_plot.pdf" "plot"
    collect_file "de" "volcano_plot" "$module_dir/03_results/plots/volcano_plot.pdf" "plot"
    collect_file "de" "heatmap" "$module_dir/03_results/plots/heatmap.pdf" "plot"
}

collect_enrichment() {
    module_dir=$1
    collect_module_common "enrichment" "$module_dir"
    collect_file "enrichment" "summary" "$module_dir/03_results/enrichment/enrichment_summary.tsv" "table"
    collect_file "enrichment" "ora_results" "$module_dir/03_results/enrichment/ora_results.tsv" "table"
    collect_file "enrichment" "gsea_results" "$module_dir/03_results/enrichment/gsea_results.tsv" "table"
    collect_file "enrichment" "dotplot_pdf" "$module_dir/03_results/enrichment/dotplot.pdf" "plot"
    collect_file "enrichment" "dotplot_png" "$module_dir/03_results/enrichment/dotplot.png" "plot"
}

write_report_html() {
    escaped_project=$(html_escape "$project_name")
    {
        printf '<!doctype html>\n'
        printf '<html lang="en">\n<head>\n'
        printf '<meta charset="utf-8">\n'
        printf '<title>%s - RNA-seq report</title>\n' "$escaped_project"
        printf '<style>body{font-family:Arial,sans-serif;line-height:1.45;margin:2rem;max-width:1100px}table{border-collapse:collapse;width:100%%;margin:1rem 0}th,td{border:1px solid #ccc;padding:.35rem;text-align:left;vertical-align:top}th{background:#f4f4f4}code{background:#f4f4f4;padding:.1rem .25rem}.note{color:#555}</style>\n'
        printf '</head>\n<body>\n'
        printf '<h1>%s</h1>\n' "$escaped_project"
        printf '<p class="note">Generated by %s %s at %s UTC. This report collects existing upstream RNA-seq flow outputs; it does not rerun analysis or reinterpret biological conclusions.</p>\n' "$FLOW_NAME" "$FLOW_VERSION" "$finished_at"
        printf '<h2>Project Summary</h2>\n<table>\n<tr><th>Metric</th><th>Value</th></tr>\n'
        awk -F '\t' 'NR > 1 { printf "<tr><td>%s</td><td>%s</td></tr>\n", $1, $2 }' "$project_summary_file"
        printf '</table>\n'
        printf '<h2>Upstream Outputs</h2>\n<table>\n<tr><th>Module</th><th>Path</th><th>Status</th></tr>\n'
        awk -F '\t' 'NR > 1 { printf "<tr><td>%s</td><td><code>%s</code></td><td>%s</td></tr>\n", $1, $2, $3 }' "$upstream_outputs_file"
        printf '</table>\n'
        printf '<h2>Collected Files</h2>\n<table>\n<tr><th>Module</th><th>Role</th><th>Kind</th><th>Collected path</th><th>Bytes</th></tr>\n'
        awk -F '\t' 'NR > 1 { printf "<tr><td>%s</td><td>%s</td><td>%s</td><td><code>%s</code></td><td>%s</td></tr>\n", $1, $2, $5, $4, $6 }' "$collected_files_file"
        printf '</table>\n'
        printf '<h2>Boundaries</h2>\n'
        printf '<p>This r1 report is a static collector. It does not run Salmon, HISAT2, featureCounts, RSeQC, DESeq2, enrichment, gene ID conversion, organism inference, database download, or statistical review.</p>\n'
        printf '</body>\n</html>\n'
    } > "$report_html"
}

for core_cmd in awk basename cat chmod cp date dirname grep mkdir rm sed sh sort wc; do
    command -v "$core_cmd" >/dev/null 2>&1 || fail "missing required shell utility: $core_cmd"
done

case "$outdir_arg" in
    ''|'.'|'..'|'/') fail "--outdir must be a dedicated output directory" ;;
esac

cwd=$(pwd)
outdir=$(resolve_path "$outdir_arg" "$cwd")

expression_out=""
alignment_out=""
count_out=""
alignment_qc_out=""
de_out=""
enrichment_out=""

[ -n "$expression_arg" ] && expression_out=$(resolve_path "$expression_arg" "$cwd")
[ -n "$alignment_arg" ] && alignment_out=$(resolve_path "$alignment_arg" "$cwd")
[ -n "$count_arg" ] && count_out=$(resolve_path "$count_arg" "$cwd")
[ -n "$alignment_qc_arg" ] && alignment_qc_out=$(resolve_path "$alignment_qc_arg" "$cwd")
[ -n "$de_arg" ] && de_out=$(resolve_path "$de_arg" "$cwd")
[ -n "$enrichment_arg" ] && enrichment_out=$(resolve_path "$enrichment_arg" "$cwd")

provided_count=0
for value in "$expression_out" "$alignment_out" "$count_out" "$alignment_qc_out" "$de_out" "$enrichment_out"; do
    [ -n "$value" ] && provided_count=$((provided_count + 1))
done
[ "$provided_count" -gt 0 ] || fail "provide at least one upstream output directory"

if [ -e "$outdir" ]; then
    if is_true "$force_arg"; then
        [ -d "$outdir" ] || fail "--outdir exists and is not a directory: $outdir"
        rm -rf "$outdir/00_inputs" "$outdir/01_logs" "$outdir/03_results" "$outdir/04_reports" "$outdir/run.manifest.json"
    else
        fail "--outdir already exists: $outdir (use --force to replace rnaseq-report-flow outputs)"
    fi
fi

inputs_dir="$outdir/00_inputs"
logs_dir="$outdir/01_logs"
logs_steps_dir="$logs_dir/steps"
results_dir="$outdir/03_results"
collected_tables_dir="$results_dir/collected_tables"
collected_plots_dir="$results_dir/collected_plots"
reports_dir="$outdir/04_reports"

mkdir -p "$inputs_dir" "$logs_steps_dir" "$collected_tables_dir" "$collected_plots_dir" "$reports_dir"

flow_log="$logs_dir/flow.log"
upstream_outputs_file="$inputs_dir/upstream_outputs.tsv"
commands_file="$reports_dir/commands.sh"
versions_file="$reports_dir/versions.tsv"
methods_file="$reports_dir/methods.txt"
project_summary_file="$reports_dir/project_summary.tsv"
collected_files_file="$reports_dir/collected_files.tsv"
flow_summary_file="$reports_dir/flow_summary.tsv"
report_html="$reports_dir/rnaseq_report.html"
manifest_file="$outdir/run.manifest.json"
started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

: > "$flow_log"
{
    printf '#!/bin/sh\n'
    printf 'set -eu\n\n'
    printf '# Generated by %s %s at %s\n' "$FLOW_NAME" "$FLOW_VERSION" "$started_at"
    printf '# This report flow collected existing upstream outputs and did not execute analysis dependencies.\n'
} > "$commands_file"
chmod +x "$commands_file"

{
    printf 'tool\tversion\tsource\n'
    printf 'rnaseq-report-flow\t%s\ttaffish flow\n' "$FLOW_VERSION"
} > "$versions_file"

{
    printf '%s %s collects existing RNA-seq flow outputs into a static project report.\n\n' "$FLOW_NAME" "$FLOW_VERSION"
    printf 'It does not rerun expression quantification, alignment, counting, QC, differential expression, or enrichment. Biological interpretation remains the user responsibility.\n'
} > "$methods_file"

printf 'module\tpath\tstatus\n' > "$upstream_outputs_file"
printf 'module\trole\toriginal_path\tlocal_path\tkind\tbytes\n' > "$collected_files_file"

log "begin $FLOW_NAME $FLOW_VERSION"

log "START 01_collect_inputs"
if {
    register_module "expression" "$expression_out"
    register_module "alignment" "$alignment_out"
    register_module "count" "$count_out"
    register_module "alignment_qc" "$alignment_qc_out"
    register_module "de" "$de_out"
    register_module "enrichment" "$enrichment_out"

    [ -n "$expression_out" ] && collect_expression "$expression_out"
    [ -n "$alignment_out" ] && collect_alignment "$alignment_out"
    [ -n "$count_out" ] && collect_count "$count_out"
    [ -n "$alignment_qc_out" ] && collect_alignment_qc "$alignment_qc_out"
    [ -n "$de_out" ] && collect_de "$de_out"
    [ -n "$enrichment_out" ] && collect_enrichment "$enrichment_out"

    printf 'provided_modules\t%s\n' "$module_count"
    printf 'collected_files\t%s\n' "$collected_count"
    printf 'collected_tables\t%s\n' "$copied_table_count"
    printf 'collected_plots\t%s\n' "$copied_plot_count"
    [ "$collected_count" -gt 0 ] || {
        printf 'ERROR: no recognizable report files were collected from the provided upstream directories\n'
        exit 2
    }
} > "$logs_steps_dir/01_collect_inputs.log" 2>&1; then
    log "DONE  01_collect_inputs"
else
    log "FAIL  01_collect_inputs; see $logs_steps_dir/01_collect_inputs.log"
    exit 1
fi

log "START 02_render_report"
if {
    finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    {
        printf 'metric\tvalue\n'
        printf 'project_name\t%s\n' "$project_name"
        printf 'flow\t%s\n' "$FLOW_NAME"
        printf 'version\t%s\n' "$FLOW_VERSION"
        printf 'started_at\t%s\n' "$started_at"
        printf 'finished_at\t%s\n' "$finished_at"
        printf 'provided_modules\t%s\n' "$module_count"
        printf 'collected_files\t%s\n' "$collected_count"
        printf 'collected_tables\t%s\n' "$copied_table_count"
        printf 'collected_plots\t%s\n' "$copied_plot_count"
    } > "$project_summary_file"

    cp "$project_summary_file" "$flow_summary_file"
    write_report_html

    {
        printf '{\n'
        printf '  "flow": "rnaseq-report-flow",\n'
        printf '  "version": %s,\n' "$(json_string "$FLOW_VERSION")"
        printf '  "project_name": %s,\n' "$(json_string "$project_name")"
        printf '  "started_at": %s,\n' "$(json_string "$started_at")"
        printf '  "finished_at": %s,\n' "$(json_string "$finished_at")"
        printf '  "provided_modules": %s,\n' "$module_count"
        printf '  "collected_files": %s,\n' "$collected_count"
        printf '  "collected_tables": %s,\n' "$copied_table_count"
        printf '  "collected_plots": %s,\n' "$copied_plot_count"
        printf '  "outputs": {\n'
        printf '    "report": %s,\n' "$(json_string "$report_html")"
        printf '    "project_summary": %s,\n' "$(json_string "$project_summary_file")"
        printf '    "collected_files": %s,\n' "$(json_string "$collected_files_file")"
        printf '    "versions": %s,\n' "$(json_string "$versions_file")"
        printf '    "methods": %s\n' "$(json_string "$methods_file")"
        printf '  }\n'
        printf '}\n'
    } > "$manifest_file"

    printf 'report\t%s\n' "$report_html"
    printf 'project_summary\t%s\n' "$project_summary_file"
    printf 'collected_files\t%s\n' "$collected_files_file"
} > "$logs_steps_dir/02_render_report.log" 2>&1; then
    log "DONE  02_render_report"
else
    log "FAIL  02_render_report; see $logs_steps_dir/02_render_report.log"
    exit 1
fi

log "completed. Report: $report_html"
log "summary: $project_summary_file"
