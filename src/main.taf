ARGS
<(--standard-out)standard-out>
<(--reference-out)reference-out>
<(--expression-out)expression-out>
<(--alignment-out)alignment-out>
<(--count-out)count-out>
<(--alignment-qc-out)alignment-qc-out>
<(--de-out)de-out>
<(--enrichment-out)enrichment-out>
<(--denovo-assembly-out)denovo-assembly-out>
<(--denovo-expression-out)denovo-expression-out>
<(--denovo-annotation-out)denovo-annotation-out>
<!(--outdir/-o)outdir>
<(--project-name)project-name>
  RNA-seq project
<(--analysis-mode)analysis-mode>
  auto
<(--analysis-route)analysis-route>
  auto
<(--de-source)de-source>
  auto

RUN
<taffish>
set -eu

FLOW_NAME="rnaseq-report-flow"
FLOW_VERSION="0.3.0-r1"
FLOW_REPORT_TEMPLATE_VERSION="0.1.0"
taffish_load_dir="::*LOADDIR*::"
TAFFISH_LOGO_DATA_URI="data:image/png;base64,"

standard_arg="::(--standard-out)standard-out::"
reference_arg="::(--reference-out)reference-out::"
expression_arg="::(--expression-out)expression-out::"
alignment_arg="::(--alignment-out)alignment-out::"
count_arg="::(--count-out)count-out::"
alignment_qc_arg="::(--alignment-qc-out)alignment-qc-out::"
de_arg="::(--de-out)de-out::"
enrichment_arg="::(--enrichment-out)enrichment-out::"
denovo_assembly_arg="::(--denovo-assembly-out)denovo-assembly-out::"
denovo_expression_arg="::(--denovo-expression-out)denovo-expression-out::"
denovo_annotation_arg="::(--denovo-annotation-out)denovo-annotation-out::"
outdir_arg="::!(--outdir/-o)outdir::"
project_name="::project-name::"
analysis_mode_arg="::analysis-mode::"
analysis_route_arg="::analysis-route::"
de_source_arg="::de-source::"
force_arg="::(--force)force?::"

flow_log=""
collected_count=0
copied_table_count=0
copied_plot_count=0
copied_html_count=0
html_report_count=0
embedded_html_count=0
module_count=0
standard_plot_source=no
denovo_present=no

log() {
    printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >&2
    if [ -n "$flow_log" ]; then
        printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >> "$flow_log"
    fi
}

fail() {
    log "ERROR: $*"
    exit 1
}

sq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

json_string() {
    printf '%s' "$1" | awk '
        BEGIN {
            ORS = ""
            bs = sprintf("%c", 92)
            dq = sprintf("%c", 34)
            tabc = sprintf("%c", 9)
            cr = sprintf("%c", 13)
            printf dq
        }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == bs) {
                    printf "%s%s", bs, bs
                } else if (c == dq) {
                    printf "%s%s", bs, dq
                } else if (c == tabc) {
                    printf "%st", bs
                } else if (c == cr) {
                    printf "%sr", bs
                } else {
                    printf "%s", c
                }
            }
        }
        END {
            printf dq
        }
    '
}

html_escape() {
    printf '%s' "$1" | awk '
        BEGIN { ORS = "" }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == "&") printf "%s", "&amp;"
                else if (c == "<") printf "%s", "&lt;"
                else if (c == ">") printf "%s", "&gt;"
                else if (c == "\"") printf "%s", "&quot;"
                else printf "%s", c
            }
        }
    '
}

resolve_path() {
    path_value=$1
    base_dir=$2
    case "$path_value" in
        /*) printf '%s\n' "$path_value" ;;
        *) printf '%s/%s\n' "$base_dir" "$path_value" ;;
    esac
}

is_true() {
    case "$1" in
        T|t|true|TRUE|True|1|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

safe_name() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'
}

file_size() {
    wc -c < "$1" | awk '{ print $1 + 0 }'
}

base64_one_line() {
    base64 < "$1" | tr -d '\n'
}

mime_type_for() {
    case "$1" in
        *.html|*.htm) printf 'text/html' ;;
        *.css) printf 'text/css' ;;
        *.js) printf 'application/javascript' ;;
        *.json) printf 'application/json' ;;
        *.png) printf 'image/png' ;;
        *.jpg|*.jpeg) printf 'image/jpeg' ;;
        *.svg) printf 'image/svg+xml' ;;
        *.gif) printf 'image/gif' ;;
        *.txt|*.tsv|*.csv) printf 'text/plain' ;;
        *) printf 'application/octet-stream' ;;
    esac
}

replace_literal_in_file() {
    target_file=$1
    old_text=$2
    replacement_file=$3
    [ -n "$old_text" ] || return 0
    [ -s "$target_file" ] || return 0
    tmp_file="$target_file.replace.$$"
    awk -v old="$old_text" -v replacement_file="$replacement_file" '
        BEGIN {
            while ((getline line < replacement_file) > 0) repl = repl line
            close(replacement_file)
        }
        {
            out = $0
            while ((pos = index(out, old)) > 0) {
                out = substr(out, 1, pos - 1) repl substr(out, pos + length(old))
            }
            print out
        }
    ' "$target_file" > "$tmp_file"
    mv "$tmp_file" "$target_file"
}

url_encode_minimal() {
    printf '%s' "$1" | sed 's/ /%20/g'
}

embed_html_bundle() {
    bundle_dir=$1
    source_index=$2
    embedded_index=$3
    [ -s "$source_index" ] || return 1
    cp "$source_index" "$embedded_index"
    (
        cd "$bundle_dir"
        find . -type f ! -name index.html | sort
    ) | while IFS= read -r rel_path; do
        rel_path=${rel_path#./}
        [ -n "$rel_path" ] || continue
        asset_file="$bundle_dir/$rel_path"
        [ -s "$asset_file" ] || continue
        encoded_rel=$(url_encode_minimal "$rel_path")
        if grep -F "$rel_path" "$embedded_index" >/dev/null 2>&1 || grep -F "$encoded_rel" "$embedded_index" >/dev/null 2>&1; then
            uri_file="$embedded_index.uri.$$"
            {
                printf 'data:%s;base64,' "$(mime_type_for "$rel_path")"
                base64_one_line "$asset_file"
            } > "$uri_file"
            replace_literal_in_file "$embedded_index" "$rel_path" "$uri_file"
            if [ "$encoded_rel" != "$rel_path" ]; then
                replace_literal_in_file "$embedded_index" "$encoded_rel" "$uri_file"
            fi
            rm -f "$uri_file"
        fi
    done
    [ -s "$embedded_index" ]
}

metric_value() {
    metric_file=$1
    metric_key=$2
    metric_default=$3
    if [ ! -s "$metric_file" ]; then
        printf '%s\n' "$metric_default"
        return 0
    fi
    awk -F '\t' -v key="$metric_key" -v default="$metric_default" '
        NR > 1 && $1 == key {
            print $2
            found = 1
            exit
        }
        END {
            if (!found) print default
        }
    ' "$metric_file"
}

row_count() {
    count_file=$1
    if [ ! -s "$count_file" ]; then
        printf '0\n'
        return 0
    fi
    awk 'END { if (NR > 0) print NR - 1; else print 0 }' "$count_file"
}

average_column() {
    table_file=$1
    column_name=$2
    if [ ! -s "$table_file" ]; then
        printf '.\n'
        return 0
    fi
    awk -F '\t' -v colname="$column_name" '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                if ($i == colname) col = i
            }
            next
        }
        col && $col != "" && $col != "." {
            value = $col
            gsub(/,/, "", value)
            sum += value + 0
            n++
        }
        END {
            if (n > 0) printf "%.2f\n", sum / n
            else print "."
        }
    ' "$table_file"
}

sum_column() {
    table_file=$1
    column_name=$2
    if [ ! -s "$table_file" ]; then
        printf '.\n'
        return 0
    fi
    awk -F '\t' -v colname="$column_name" '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                if ($i == colname) col = i
            }
            next
        }
        col && $col != "" && $col != "." {
            value = $col
            gsub(/,/, "", value)
            sum += value + 0
            n++
        }
        END {
            if (n > 0) printf "%.0f\n", sum
            else print "."
        }
    ' "$table_file"
}

append_upstream_versions() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        awk -F '\t' -v OFS='\t' -v module="$module" '
            NR == 1 { next }
            NF >= 2 {
                source = (NF >= 3 ? $3 : "upstream report")
                print $1, $2, module ":" source
            }
        ' "$source_file" >> "$versions_file"
    fi
}

append_upstream_methods() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        {
            printf '\n## Upstream module: %s\n\n' "$module"
            cat "$source_file"
            printf '\n'
        } >> "$methods_file"
    fi
}

append_upstream_commands() {
    module=$1
    source_file=$2
    if [ -s "$source_file" ]; then
        {
            printf '\n# ----- Upstream module: %s -----\n' "$module"
            cat "$source_file"
            printf '\n# ----- End upstream module: %s -----\n' "$module"
        } >> "$commands_file"
    fi
}

register_module() {
    module=$1
    path_value=$2
    case "$module" in
        alignment_qc) arg_name="alignment-qc" ;;
        denovo_assembly) arg_name="denovo-assembly" ;;
        denovo_expression) arg_name="denovo-expression" ;;
        denovo_annotation) arg_name="denovo-annotation" ;;
        *) arg_name=$module ;;
    esac
    [ -n "$path_value" ] || return 0
    [ -d "$path_value" ] || fail "--${arg_name}-out is not a directory: $path_value"
    module_count=$((module_count + 1))
    printf '%s\t%s\tprovided\n' "$module" "$path_value" >> "$upstream_outputs_file"
}

collect_file() {
    module=$1
    role=$2
    source_file=$3
    kind=$4
    [ -s "$source_file" ] || return 0

    base=$(basename "$source_file")
    module_safe=$(safe_name "$module")
    role_safe=$(safe_name "$role")
    base_safe=$(safe_name "$base")
    case "$base_safe" in
        "$module_safe.$role_safe."*) local_name="$base_safe" ;;
        *) local_name="$module_safe.$role_safe.$base_safe" ;;
    esac
    case "$kind" in
        plot)
            dest_dir="$collected_plots_dir"
            rel_prefix="../03_results/collected_plots"
            copied_plot_count=$((copied_plot_count + 1))
            ;;
        *)
            dest_dir="$collected_tables_dir"
            rel_prefix="../03_results/collected_tables"
            copied_table_count=$((copied_table_count + 1))
            ;;
    esac

    dest_file="$dest_dir/$local_name"
    rel_file="$rel_prefix/$local_name"
    cp "$source_file" "$dest_file"
    size=$(file_size "$dest_file")
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$module" "$role" "$source_file" "$dest_file" "$kind" "$size" >> "$collected_files_file"
    if [ "$kind" = "plot" ]; then
        case "$base" in
            *.png) format=png ;;
            *.pdf) format=pdf ;;
            *) format=file ;;
        esac
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$module" "$role" "$format" "$source_file" "$dest_file" "$rel_file" "$size" >> "$plot_files_file"
    fi
    collected_count=$((collected_count + 1))
}

collect_html_bundle() {
    module=$1
    role=$2
    source_html=$3
    bundle_mode=$4
    report_type_override=${5:-}
    [ -s "$source_html" ] || return 0

    module_safe=$(safe_name "$module")
    role_safe=$(safe_name "$role")
    bundle_name="$module_safe.$role_safe"
    dest_dir="$collected_html_dir/$bundle_name"
    rel_file="../03_results/collected_html/$bundle_name/index.html"

    rm -rf "$dest_dir"
    mkdir -p "$dest_dir"

    case "$bundle_mode" in
        multiqc)
            cp "$source_html" "$dest_dir/index.html"
            asset_dir="$(dirname "$source_html")/multiqc_report_data"
            [ -d "$asset_dir" ] && cp -R "$asset_dir" "$dest_dir/"
            report_type=MultiQC
            ;;
        fastqc)
            parent_dir=$(dirname "$source_html")
            cp -R "$parent_dir/." "$dest_dir/"
            base_html=$(basename "$source_html")
            [ "$base_html" = "index.html" ] || cp "$dest_dir/$base_html" "$dest_dir/index.html"
            report_type=FastQC
            ;;
        qualimap)
            parent_dir=$(dirname "$source_html")
            cp -R "$parent_dir/." "$dest_dir/"
            base_html=$(basename "$source_html")
            [ "$base_html" = "index.html" ] || cp "$dest_dir/$base_html" "$dest_dir/index.html"
            report_type=Qualimap
            ;;
        directory)
            parent_dir=$(dirname "$source_html")
            cp -R "$parent_dir/." "$dest_dir/"
            base_html=$(basename "$source_html")
            [ "$base_html" = "index.html" ] || cp "$dest_dir/$base_html" "$dest_dir/index.html"
            report_type=HTML
            ;;
        *)
            cp "$source_html" "$dest_dir/index.html"
            report_type=HTML
            ;;
    esac
    [ -n "$report_type_override" ] && report_type=$report_type_override

    [ -s "$dest_dir/index.html" ] || return 0
    size=$(file_size "$dest_dir/index.html")
    embedded_file="$dest_dir/index.embedded.html"
    embedded_status=linked_only
    embedded_size=0
    if embed_html_bundle "$dest_dir" "$dest_dir/index.html" "$embedded_file"; then
        embedded_status=embedded
        embedded_size=$(file_size "$embedded_file")
        embedded_html_count=$((embedded_html_count + 1))
    else
        rm -f "$embedded_file"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$module" "$role" "$report_type" "$source_html" "$dest_dir/index.html" "$rel_file" "$size" "$bundle_name" >> "$html_reports_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$bundle_name" "$module" "$role" "$report_type" "$dest_dir/index.html" "$rel_file" "$size" "$embedded_file" "$embedded_size" "$embedded_status" >> "$embedded_html_reports_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$module" "$role" "$source_html" "$dest_dir/index.html" "html" "$size" >> "$collected_files_file"
    copied_html_count=$((copied_html_count + 1))
    html_report_count=$((html_report_count + 1))
    collected_count=$((collected_count + 1))
}

collect_module_common() {
    module=$1
    module_dir=$2
    collect_file "$module" "flow_summary" "$module_dir/04_reports/flow_summary.tsv" "table"
    collect_file "$module" "methods" "$module_dir/04_reports/methods.txt" "table"
    collect_file "$module" "manifest" "$module_dir/run.manifest.json" "table"
    append_upstream_versions "$module" "$module_dir/04_reports/versions.tsv"
    append_upstream_methods "$module" "$module_dir/04_reports/methods.txt"
    append_upstream_commands "$module" "$module_dir/04_reports/commands.sh"
}

legacy_collected_table() {
    legacy_module=$1
    legacy_role=$2
    [ -n "$standard_out" ] || return 1
    for legacy_file in "$standard_out"/03_results/collected_tables/"$legacy_module.$legacy_role".*; do
        [ -s "$legacy_file" ] || continue
        printf '%s\n' "$legacy_file"
        return 0
    done
    return 1
}

copy_legacy_table() {
    legacy_module=$1
    legacy_role=$2
    dest_file=$3
    source_file=$(legacy_collected_table "$legacy_module" "$legacy_role" 2>/dev/null || true)
    [ -n "$source_file" ] || return 0
    mkdir -p "$(dirname "$dest_file")"
    cp "$source_file" "$dest_file"
}

prepare_standard_report_package_inputs() {
    [ "$standard_report_package" = yes ] || return 0
    legacy_root="$intermediate_dir/standard_report_package"
    mkdir -p "$legacy_root"

    for legacy_module in reference expression alignment count alignment_qc de enrichment denovo_assembly denovo_expression denovo_annotation; do
        mkdir -p "$legacy_root/$legacy_module/04_reports"
        copy_legacy_table "$legacy_module" "flow_summary" "$legacy_root/$legacy_module/04_reports/flow_summary.tsv"
        copy_legacy_table "$legacy_module" "methods" "$legacy_root/$legacy_module/04_reports/methods.txt"
        copy_legacy_table "$legacy_module" "manifest" "$legacy_root/$legacy_module/run.manifest.json"
    done

    copy_legacy_table reference summary "$legacy_root/reference/04_reports/reference_summary.tsv"
    copy_legacy_table reference genome_index "$legacy_root/reference/04_reports/genome_index.tsv"
    copy_legacy_table reference tx2gene "$legacy_root/reference/03_results/tx2gene.tsv"

    copy_legacy_table expression summary "$legacy_root/expression/04_reports/expression_summary.tsv"
    copy_legacy_table expression quant_files "$legacy_root/expression/04_reports/quant_files.tsv"
    copy_legacy_table expression gene_counts "$legacy_root/expression/03_results/matrices/gene_counts.tsv"
    copy_legacy_table expression gene_tpm "$legacy_root/expression/03_results/matrices/gene_tpm.tsv"
    copy_legacy_table expression transcript_counts "$legacy_root/expression/03_results/matrices/transcript_counts.tsv"
    copy_legacy_table expression transcript_tpm "$legacy_root/expression/03_results/matrices/transcript_tpm.tsv"

    copy_legacy_table alignment summary "$legacy_root/alignment/03_results/alignment_summary.tsv"
    copy_legacy_table alignment bam_files "$legacy_root/alignment/04_reports/bam_files.tsv"

    copy_legacy_table count summary "$legacy_root/count/04_reports/count_summary.tsv"
    copy_legacy_table count gene_counts "$legacy_root/count/03_results/matrices/gene_counts.tsv"
    copy_legacy_table count assignment_summary "$legacy_root/count/03_results/assignment_summary.tsv"

    copy_legacy_table alignment_qc summary "$legacy_root/alignment_qc/03_results/rnaseq_qc_summary.tsv"
    copy_legacy_table alignment_qc report_summary "$legacy_root/alignment_qc/04_reports/rnaseq_qc_summary.tsv"

    copy_legacy_table de summary "$legacy_root/de/04_reports/de_summary.tsv"
    copy_legacy_table de contrasts "$legacy_root/de/04_reports/contrasts.tsv"
    copy_legacy_table de results "$legacy_root/de/03_results/de/results.tsv"
    copy_legacy_table de results_shrunken "$legacy_root/de/03_results/de/results_shrunken.tsv"
    copy_legacy_table de normalized_counts "$legacy_root/de/03_results/de/normalized_counts.tsv"
    copy_legacy_table de vst_matrix "$legacy_root/de/03_results/de/vst_matrix.tsv"
    copy_legacy_table de significant_genes "$legacy_root/de/03_results/gene_lists/significant_genes.tsv"
    copy_legacy_table de up_genes "$legacy_root/de/03_results/gene_lists/up_genes.tsv"
    copy_legacy_table de down_genes "$legacy_root/de/03_results/gene_lists/down_genes.tsv"
    copy_legacy_table de ranked_genes "$legacy_root/de/03_results/gene_lists/ranked_genes.tsv"
    copy_legacy_table de plot_summary "$legacy_root/de/03_results/plots/plot_summary.tsv"

    copy_legacy_table enrichment summary "$legacy_root/enrichment/03_results/enrichment/enrichment_summary.tsv"
    copy_legacy_table enrichment ora_results "$legacy_root/enrichment/03_results/enrichment/ora_results.tsv"
    copy_legacy_table enrichment gsea_results "$legacy_root/enrichment/03_results/enrichment/gsea_results.tsv"
    copy_legacy_table enrichment dotplot_source "$legacy_root/enrichment/03_results/enrichment/dotplot_source.tsv"
    copy_legacy_table enrichment plot_summary "$legacy_root/enrichment/03_results/enrichment/plot_summary.tsv"

    copy_legacy_table denovo_assembly summary "$legacy_root/denovo_assembly/04_reports/assembly_summary.tsv"
    copy_legacy_table denovo_assembly assembly_stats "$legacy_root/denovo_assembly/03_results/assembly_qc/assembly_stats.tsv"
    copy_legacy_table denovo_assembly seqkit_stats "$legacy_root/denovo_assembly/03_results/assembly_qc/seqkit_stats.tsv"
    copy_legacy_table denovo_assembly read_support "$legacy_root/denovo_assembly/03_results/assembly_qc/read_support.tsv"
    copy_legacy_table denovo_assembly busco_summary "$legacy_root/denovo_assembly/03_results/assembly_qc/busco_summary.tsv"

    copy_legacy_table denovo_expression summary "$legacy_root/denovo_expression/04_reports/expression_summary.tsv"
    copy_legacy_table denovo_expression quant_files "$legacy_root/denovo_expression/04_reports/quant_files.tsv"
    copy_legacy_table denovo_expression matrix_semantics "$legacy_root/denovo_expression/04_reports/matrix_semantics.tsv"
    copy_legacy_table denovo_expression mapping_summary "$legacy_root/denovo_expression/04_reports/mapping_summary.tsv"
    copy_legacy_table denovo_expression transcript_stats "$legacy_root/denovo_expression/04_reports/transcript_stats.tsv"
    copy_legacy_table denovo_expression transcript_counts "$legacy_root/denovo_expression/03_results/matrices/transcript_counts.tsv"
    copy_legacy_table denovo_expression transcript_tpm "$legacy_root/denovo_expression/03_results/matrices/transcript_tpm.tsv"
    copy_legacy_table denovo_expression gene_counts "$legacy_root/denovo_expression/03_results/matrices/gene_counts.tsv"
    copy_legacy_table denovo_expression gene_tpm "$legacy_root/denovo_expression/03_results/matrices/gene_tpm.tsv"

    copy_legacy_table denovo_annotation summary "$legacy_root/denovo_annotation/04_reports/annotation_summary.tsv"
    copy_legacy_table denovo_annotation transcript_stats "$legacy_root/denovo_annotation/04_reports/transcript_stats.tsv"
    copy_legacy_table denovo_annotation annotation_inputs "$legacy_root/denovo_annotation/00_inputs/annotation_inputs.tsv"
    copy_legacy_table denovo_annotation protein_hits "$legacy_root/denovo_annotation/03_results/annotation/protein_hits.tsv"
    copy_legacy_table denovo_annotation transcript_annotation "$legacy_root/denovo_annotation/03_results/annotation/transcript_annotation.tsv"
    copy_legacy_table denovo_annotation id_mapping "$legacy_root/denovo_annotation/03_results/annotation/id_mapping.tsv"
    copy_legacy_table denovo_annotation denovo_go "$legacy_root/denovo_annotation/03_results/gene_sets/denovo_go.gmt"
    copy_legacy_table denovo_annotation denovo_background "$legacy_root/denovo_annotation/03_results/gene_sets/denovo_background.tsv"

    [ -z "$reference_out" ] && [ -s "$legacy_root/reference/04_reports/reference_summary.tsv" ] && reference_out="$legacy_root/reference"
    [ -z "$expression_out" ] && [ -s "$legacy_root/expression/04_reports/expression_summary.tsv" ] && expression_out="$legacy_root/expression"
    [ -z "$alignment_out" ] && [ -s "$legacy_root/alignment/03_results/alignment_summary.tsv" ] && alignment_out="$legacy_root/alignment"
    [ -z "$count_out" ] && [ -s "$legacy_root/count/04_reports/count_summary.tsv" ] && count_out="$legacy_root/count"
    [ -z "$alignment_qc_out" ] && [ -s "$legacy_root/alignment_qc/03_results/rnaseq_qc_summary.tsv" ] && alignment_qc_out="$legacy_root/alignment_qc"
    [ -z "$de_out" ] && [ -s "$legacy_root/de/04_reports/de_summary.tsv" ] && de_out="$legacy_root/de"
    [ -z "$enrichment_out" ] && [ -s "$legacy_root/enrichment/03_results/enrichment/enrichment_summary.tsv" ] && enrichment_out="$legacy_root/enrichment"
    [ -z "$denovo_assembly_out" ] && [ -s "$legacy_root/denovo_assembly/04_reports/assembly_summary.tsv" ] && denovo_assembly_out="$legacy_root/denovo_assembly"
    [ -z "$denovo_expression_out" ] && [ -s "$legacy_root/denovo_expression/04_reports/expression_summary.tsv" ] && denovo_expression_out="$legacy_root/denovo_expression"
    [ -z "$denovo_annotation_out" ] && [ -s "$legacy_root/denovo_annotation/04_reports/annotation_summary.tsv" ] && denovo_annotation_out="$legacy_root/denovo_annotation"
    return 0
}

