    collect_file "reference" "tx2gene" "$module_dir/03_results/tx2gene.tsv" "table"
}

collect_standard() {
    module_dir=$1
    collect_module_common "standard" "$module_dir"
    collect_file "standard" "summary" "$module_dir/04_reports/flow_summary.tsv" "table"
    collect_file "standard" "project_summary" "$module_dir/04_reports/project_summary.tsv" "table"
    collect_file "standard" "subflows" "$module_dir/04_reports/subflows.tsv" "table"
    collect_file "standard" "plot_files" "$module_dir/04_reports/plot_files.tsv" "table"
    collect_file "standard" "background_filter" "$module_dir/04_reports/enrichment_background_filter.tsv" "table"

    if [ -d "$module_dir/03_results/plots" ]; then
        standard_plot_source=yes
        for source_file in \
            "$module_dir"/03_results/plots/*.png \
            "$module_dir"/03_results/plots/*.pdf \
            "$module_dir"/03_results/plots/png/*.png \
            "$module_dir"/03_results/plots/pdf/*.pdf
        do
            [ -s "$source_file" ] || continue
            base=$(basename "$source_file")
            case "$base" in
                *.*.*)
                    module_name=${base%%.*}
                    rest=${base#*.}
                    role_name=${rest%.*}
                    ;;
                *)
                    module_name=standard
                    role_name=${base%.*}
                    ;;
            esac
            collect_file "$module_name" "$role_name" "$source_file" "plot"
        done
    fi

    if [ -d "$module_dir/03_results/collected_plots" ]; then
        standard_plot_source=yes
        for source_file in \
            "$module_dir"/03_results/collected_plots/*.png \
            "$module_dir"/03_results/collected_plots/*.pdf
        do
            [ -s "$source_file" ] || continue
            base=$(basename "$source_file")
            case "$base" in
                *.*)
                    module_name=${base%%.*}
                    rest=${base#*.}
                    role_name=${rest%.*}
                    ;;
                *)
                    module_name=standard
                    role_name=${base%.*}
                    ;;
            esac
            collect_file "$module_name" "$role_name" "$source_file" "plot"
        done
    fi

    if [ -s "$module_dir/04_reports/html_reports.tsv" ]; then
        tab_char=$(printf '\t')
        {
            IFS= read -r _header || true
            while IFS="$tab_char" read -r html_module html_role html_type _original_path local_path relative_path _bytes _extra; do
                [ -n "$html_module" ] || continue
                [ -n "$html_role" ] || continue
                source_html=""
                if [ -n "$relative_path" ] && [ -s "$module_dir/04_reports/$relative_path" ]; then
                    source_html="$module_dir/04_reports/$relative_path"
                elif [ -n "$local_path" ] && [ -s "$local_path" ]; then
                    source_html="$local_path"
                fi
                [ -n "$source_html" ] || continue
                collect_html_bundle "$html_module" "$html_role" "$source_html" "directory" "${html_type:-HTML}"
            done
        } < "$module_dir/04_reports/html_reports.tsv"
    fi
}

